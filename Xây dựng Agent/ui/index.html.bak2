<!DOCTYPE html>
<html lang="vi" class="h-full bg-[#f2eef6] text-slate-800 antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thu Hà • AI Data Analyst & Business Intelligence Studio</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        forshop: {
                            sidebar: '#203833',       /* Deep Contrast Teal Slate */
                            sidebarDark: '#172A26',
                            sidebarHover: '#2E4E47',
                            primary: '#75BFB2',       /* Swatch 3: Fresh Seafoam Mint Teal */
                            teal: '#75BFB2',          /* Swatch 3: #75BFB2 */
                            tealLight: '#B8D9D3',     /* Swatch 4: #B8D9D3 */
                            rose: '#D991A4',          /* Swatch 2: #D991A4 (Vibrant Accent Rose) */
                            roseSoft: '#D9A3AC',      /* Swatch 1: #D9A3AC (Dusty Rose) */
                            cream: '#F2E5E4',         /* Swatch 5: #F2E5E4 (Alabaster Cream Blush) */
                            dark: '#203833',          /* Contrast Dark Slate */
                            pageBg: '#F2E5E4',
                            cardBg: '#ffffff',
                            cardBlue: '#B8D9D3',
                            cardPink: '#D9A3AC',
                            cardPurple: '#D991A4',
                            cardAmber: '#F2E5E4',
                            cardGreen: '#75BFB2'
                        }
                    },
                    boxShadow: {
                        'soft': '0 20px 45px -10px rgba(32, 56, 51, 0.12)',
                        'card': '0 10px 30px -5px rgba(32, 56, 51, 0.05)',
                        'floating': '0 25px 50px -12px rgba(117, 191, 178, 0.22)',
                        'glow': '0 0 30px rgba(117, 191, 178, 0.45)',
                        'glowRose': '0 0 30px rgba(217, 145, 164, 0.45)'
                    },
                    borderRadius: {
                        '2xl': '1.25rem',
                        '3xl': '1.75rem',
                        '4xl': '2.25rem',
                        '5xl': '3rem'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Plus Jakarta Sans Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #c8c5dc; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #9f9cb8; }
        
        .card-hover { transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
        .card-hover:hover { transform: translateY(-3px); box-shadow: 0 20px 35px -8px rgba(77, 75, 114, 0.14); }
        
        .btn-smooth { transition: all 0.22s ease-in-out; }
        .btn-smooth:hover { transform: translateY(-2px); }
        .btn-smooth:active { transform: translateY(0); }

        .view-transition {
            transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>
</head>
<body class="h-full flex p-2 sm:p-4 lg:p-6 justify-center items-center overflow-x-hidden bg-gradient-to-br from-[#F2E5E4] via-[#E2EFEA] to-[#B8D9D3]">

    <!-- =================================================================== -->
    <!-- TRANG 1: CỔNG TIẾP NHẬN DỮ LIỆU & THIẾT LẬP DỰ ÁN (ENTRY PORTAL) -->
    <!-- =================================================================== -->
    <div id="landing-view" class="view-transition w-full max-w-[1440px] h-[95vh] min-h-[780px] bg-white/90 rounded-4xl lg:rounded-5xl shadow-2xl border-2 border-[#B8D9D3] p-5 sm:p-8 lg:p-10 flex flex-col justify-between overflow-y-auto relative scroll-smooth space-y-6 backdrop-blur-md">
        
        <!-- Ambient Lights: Teal Mint & Rose Palette -->
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-[#75BFB2]/40 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-[#D991A4]/40 rounded-full filter blur-3xl pointer-events-none"></div>

        <!-- TOP HEADER: LOGO THU HÀ, MENU & QUICK ACTIONS -->
        <header class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-[#B8D9D3]/70 relative z-20">
            <!-- Brand Logo Thu Hà -->
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-extrabold text-xl shadow-lg shadow-[#203833]/30">
                    <i class="fa-solid fa-chart-pie text-[#75BFB2]"></i>
                </div>
                <div>
                    <h2 class="text-base font-black text-[#203833] leading-none flex items-center gap-2">
                        <span>Thu Hà</span>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-[#B8D9D3] text-[#203833] border border-[#75BFB2]">Data Analyst & BI Studio</span>
                    </h2>
                    <p class="text-[10px] text-[#203833]/80 font-semibold mt-0.5">Hệ Thống Đánh Giá & Phân Tích Hiệu Quả Bán Hàng Đa Dự Án</p>
                </div>
            </div>

            <!-- Quick Action Links -->
            <div class="flex items-center gap-2 text-xs font-bold">
                <button type="button" onclick="openFaqModal()" class="px-3.5 py-2 rounded-xl text-[#203833] hover:bg-[#B8D9D3]/60 transition cursor-pointer">
                    <i class="fa-solid fa-circle-question mr-1 text-[#75BFB2]"></i> Hỏi Đáp
                </button>
                <button type="button" onclick="openContactModal()" class="px-3.5 py-2 rounded-xl text-[#203833] hover:bg-[#D9A3AC]/40 transition cursor-pointer">
                    <i class="fa-solid fa-address-card mr-1 text-[#D991A4]"></i> Liên Hệ
                </button>
                <button type="button" onclick="openSettingsModal()" class="px-3.5 py-2 rounded-xl text-[#203833] hover:bg-[#B8D9D3]/60 transition cursor-pointer">
                    <i class="fa-solid fa-sliders mr-1 text-[#75BFB2]"></i> Cài Đặt
                </button>
                <!-- NÚT ƯU TIÊN ĐẶC BIỆT: VÀO KHÔNG GIAN LÀM VIỆC -->
                <button type="button" onclick="navigateTo('app'); goToStep(1);" class="btn-smooth px-4 py-2 bg-gradient-to-r from-[#203833] to-[#2E544C] hover:from-[#172A26] hover:to-[#24443D] text-white rounded-xl shadow-md border border-[#75BFB2]/40 flex items-center gap-2 cursor-pointer ring-2 ring-[#75BFB2]/30">
                    <i class="fa-solid fa-arrow-right-to-bracket text-[#75BFB2]"></i>
                    <span class="font-bold">Vào Không Gian Làm Việc</span>
                </button>
            </div>
        </header>

        <!-- HERO SECTION: HÌNH ẢNH NGHỆ THUẬT FLUID ART & GIỚI THIỆU KHÔNG GIAN LÀM VIỆC -->
        <section class="w-full max-w-6xl mx-auto my-auto py-4 z-10 relative">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
                
                <!-- CỘT TRÁI (7 CỘT): TIÊU ĐỀ CHÍNH, 3 TRỤ CỘT NĂNG LỰC & NÚT BẮT ĐẦU -->
                <div class="lg:col-span-7 space-y-6 text-left">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-[#B8D9D3] text-[#203833] border border-[#75BFB2] shadow-xs">
                        <i class="fa-solid fa-wand-magic-sparkles text-[#203833]"></i>
                        <span>AI Data Analyst & Business Intelligence Studio</span>
                    </div>

                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#203833] tracking-tight leading-tight">
                        Biến Dữ Liệu Bán Hàng Thô Thành <br class="hidden sm:inline">
                        <span class="bg-gradient-to-r from-[#203833] via-[#75BFB2] to-[#D991A4] bg-clip-text text-transparent">
                            Quyết Định Kinh Doanh Chuẩn Xác
                        </span>
                    </h1>

                    <!-- 3 Highlight Pillars Styled with Teal/Rose Palette -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                        <div class="p-3.5 rounded-2xl bg-white/85 border-2 border-[#75BFB2] shadow-sm flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-bold text-sm shrink-0">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <div class="text-xs font-black text-[#203833]">Bảo Toàn 100%</div>
                                <div class="text-[10px] text-[#203833]/80 font-medium">Bảo lưu dữ liệu gốc</div>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-2xl bg-white/85 border-2 border-[#D991A4] shadow-sm flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-[#203833] text-[#D991A4] flex items-center justify-center font-bold text-sm shrink-0">
                                <i class="fa-solid fa-calculator"></i>
                            </div>
                            <div>
                                <div class="text-xs font-black text-[#203833]">13 Cột P&L</div>
                                <div class="text-[10px] text-[#203833]/80 font-medium">Bóc tách doanh thu & CM</div>
                            </div>
                        </div>

                        <div class="p-3.5 rounded-2xl bg-gradient-to-br from-white/90 to-[#F2E5E4] border-2 border-[#75BFB2] shadow-sm flex items-center gap-3 ring-1 ring-[#75BFB2]/50">
                            <div class="w-10 h-10 rounded-xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-bold text-sm shrink-0">
                                <i class="fa-solid fa-brain text-[#D991A4]"></i>
                            </div>
                            <div>
                                <div class="text-xs font-black text-[#203833]">AI Tự Động</div>
                                <div class="text-[10px] text-[#203833]/80 font-medium">Phân tích & nhận xét</div>
                            </div>
                        </div>
                    </div>

                    <!-- Nút Bắt Đầu Vào Không Gian Làm Việc (ƯU TIÊN ĐẶC BIỆT) -->
                    <div class="pt-2">
                        <button type="button" onclick="navigateTo('app'); goToStep(1);" class="btn-smooth w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-[#203833] via-[#2A4C45] to-[#D991A4] hover:from-[#172A26] hover:to-[#C87E92] text-white font-black text-xs sm:text-sm tracking-wide rounded-2xl shadow-xl shadow-[#75BFB2]/30 flex items-center justify-center gap-3 cursor-pointer transform hover:scale-105 transition-all ring-2 ring-[#75BFB2]/40">
                            <span>VÀO KHÔNG GIAN LÀM VIỆC (BƯỚC 1: TIẾP NHẬN & BỐI CẢNH)</span>
                            <i class="fa-solid fa-arrow-right text-[#75BFB2] text-base"></i>
                        </button>
                    </div>
                </div>

                <!-- CỘT PHẢI (5 CỘT): HÌNH ẢNH 3D NGHỆ THUẬT FLUID ART ĐỒNG BỘ THEO TONE WEB -->
                <div class="lg:col-span-5 relative flex items-center justify-center">
                    <div class="w-full max-w-[490px] rounded-3xl p-3.5 bg-gradient-to-br from-white/95 via-[#F2E5E4]/90 to-[#B8D9D3]/50 border-2 border-[#75BFB2] shadow-2xl backdrop-blur-md relative group">
                        
                        <!-- Floating Badge Trái Trên -->
                        <div class="absolute -top-3.5 -left-3 px-3 py-1.5 rounded-full bg-[#203833] text-[#75BFB2] border border-[#75BFB2]/50 text-[10px] font-black shadow-lg flex items-center gap-1.5 z-10">
                            <i class="fa-solid fa-chart-line text-[#75BFB2]"></i>
                            <span>Causal Analytics 3.5</span>
                        </div>

                        <!-- Floating Badge Phải Dưới -->
                        <div class="absolute -bottom-3 -right-3 px-3.5 py-1.5 rounded-full bg-[#D991A4] text-white text-[10px] font-black shadow-lg flex items-center gap-1.5 z-10 ring-2 ring-white">
                            <i class="fa-solid fa-star text-white"></i>
                            <span>Biên Đóng Góp CM Tối Ưu</span>
                        </div>

                        <!-- Khung Hình Ảnh Nghệ Thuật Đồng Bộ Màu Sắc -->
                        <div class="overflow-hidden rounded-2xl border border-[#B8D9D3] aspect-video lg:aspect-[4/3] bg-[#203833]/5 relative shadow-inner">
                            <img src="/hero_analytics.jpg" alt="Thu Hà AI Studio - Financial Intelligence & Fluid Art Visualization" class="w-full h-full object-cover transform group-hover:scale-105 transition duration-500 ease-out">
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Bottom Footer on Landing View -->
        <footer class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium relative z-10">
            <div>Thu Hà AI Analytics Studio • Phân Tích P&L & Đánh Giá Hiệu Quả Đa Dự Án &copy; 2026</div>
            <div class="flex items-center gap-5 mt-2 sm:mt-0 font-semibold text-[11px]">
                <span><strong class="text-slate-800">100%</strong> Khử Trùng Đa Voucher</span>
                <span><strong class="text-slate-800">13</strong> Cột Chỉ Số P&L</span>
                <span><strong class="text-slate-800">4</strong> Sản Phẩm Bàn Giao</span>
                <span><strong class="text-[#203833]">AI Agent</strong> Tự Động Hoá</span>
            </div>
        </footer>
    </div>


    <!-- =================================================================== -->
    <!-- TRANG 2: WORKSPACE QUY TRÌNH 4 BƯỚC PHÂN TÍCH THEO LUỒNG -->
    <!-- =================================================================== -->
    <div id="app-view" class="view-transition hidden w-full max-w-[1520px] h-[95vh] min-h-[780px] bg-white rounded-3xl lg:rounded-4xl shadow-soft border border-slate-200/90 flex overflow-hidden opacity-0">

        <!-- =================================================================== -->
        <!-- SIGNATURE DEEP TEAL SIDEBAR -->
        <!-- =================================================================== -->
        <!-- SIGNATURE DEEP TEAL SIDEBAR (CÓ NÚT ẨN/HIỆN & DI CHUYỂN RA VÀO) -->
        <!-- =================================================================== -->
        <aside id="appSidebar" class="w-64 bg-[#203833] text-white flex flex-col justify-between py-6 px-4 shrink-0 shadow-2xl relative border-r border-[#75BFB2]/20 transition-all duration-300 ease-in-out select-none">
            
            <!-- Nút Ẩn/Hiện (Thu Gọn / Mở Rộng) Thanh Công Cụ -->
            <button type="button" onclick="toggleSidebar()" id="sidebarToggleBtn" title="Thu gọn / Mở rộng thanh công cụ" class="absolute -right-3.5 top-7 w-7 h-7 rounded-full bg-[#203833] border-2 border-[#75BFB2] text-[#75BFB2] hover:text-white hover:bg-[#75BFB2]/30 flex items-center justify-center shadow-lg cursor-pointer z-40 transition transform hover:scale-110">
                <i id="sidebarToggleIcon" class="fa-solid fa-chevron-left text-[11px] transition-transform duration-300"></i>
            </button>

            <div class="space-y-6">
                <!-- Brand Thu Hà -->
                <div class="flex items-center gap-3 px-2">
                    <div class="w-10 h-10 rounded-2xl bg-[#75BFB2] text-[#203833] flex items-center justify-center font-extrabold text-lg shadow-md shadow-[#75BFB2]/30 shrink-0">
                        <i class="fa-solid fa-chart-pie text-[#203833]"></i>
                    </div>
                    <div class="sidebar-text truncate">
                        <h2 class="text-base font-black text-white tracking-tight leading-none truncate">Thu Hà</h2>
                        <span class="text-[10px] text-[#B8D9D3] font-semibold truncate block mt-0.5">AI Analytics Studio</span>
                    </div>
                </div>

                <!-- SIDEBAR NAVIGATION (CỔNG TIẾP NHẬN LÊN ĐẦU TIÊN TRƯỚC BƯỚC 1) -->
                <nav class="space-y-1.5 text-xs font-semibold">
                    
                    <!-- 1. CỔNG TIẾP NHẬN (LÊN ĐẦU TIÊN TRƯỚC BƯỚC 1) -->
                    <button onclick="navigateTo('landing')" id="side-portal" class="side-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-[#B8D9D3] hover:text-white hover:bg-white/10 transition text-left cursor-pointer border-b border-[#75BFB2]/20 pb-2.5 mb-1 group" title="Về Cổng Tiếp Nhận (Trang Đầu)">
                        <i class="fa-solid fa-house text-sm text-[#75BFB2] group-hover:scale-110 transition shrink-0"></i>
                        <span class="font-bold sidebar-text truncate">Cổng Tiếp Nhận</span>
                    </button>

                    <!-- Bước 1 -->
                    <button onclick="goToStep(1)" id="side-step-1" class="side-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-[#75BFB2] text-[#203833] font-extrabold shadow-sm transition text-left cursor-pointer" title="Bước 1: Tiếp Nhận & Bối Cảnh">
                        <i class="fa-solid fa-cloud-arrow-up text-sm text-[#203833] shrink-0"></i>
                        <span class="sidebar-text truncate">1. Tiếp Nhận & Bối Cảnh</span>
                    </button>

                    <!-- Bước 2 -->
                    <button onclick="goToStep(2)" id="side-step-2" class="side-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-[#B8D9D3] hover:text-white hover:bg-white/10 transition text-left cursor-pointer" title="Bước 2: Làm Sạch & Phê Duyệt">
                        <div class="flex items-center gap-3 min-w-0">
                            <i class="fa-solid fa-broom text-sm text-[#D9A3AC] shrink-0"></i>
                            <span class="sidebar-text truncate">2. Làm Sạch & Phê Duyệt</span>
                        </div>
                        <span id="sideExceptionsBadge" class="hidden px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#D991A4] text-white sidebar-text shrink-0">0</span>
                    </button>

                    <!-- Bước 3 (Ưu tiên đặc biệt!) -->
                    <button onclick="goToStep(3)" id="side-step-3" class="side-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-[#B8D9D3] hover:text-white hover:bg-white/10 transition text-left cursor-pointer" title="Bước 3: Phân Tích P&L & Causal (Trọng Tâm)">
                        <i class="fa-solid fa-chart-pie text-sm text-[#75BFB2] shrink-0"></i>
                        <span class="font-bold sidebar-text truncate">3. Phân Tích P&L & Causal</span>
                    </button>

                    <!-- Bước 4 -->
                    <button onclick="goToStep(4)" id="side-step-4" class="side-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-[#B8D9D3] hover:text-white hover:bg-white/10 transition text-left cursor-pointer" title="Bước 4: Duyệt & Xuất Báo Cáo">
                        <i class="fa-solid fa-file-circle-check text-sm text-[#D991A4] shrink-0"></i>
                        <span class="sidebar-text truncate">4. Duyệt & Xuất Báo Cáo</span>
                    </button>

                    <!-- Copilot Chat -->
                    <button onclick="goToStep('chat')" id="side-step-chat" class="side-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-[#B8D9D3] hover:text-white hover:bg-white/10 transition text-left cursor-pointer" title="Cố Vấn Gemini AI">
                        <i class="fa-solid fa-wand-magic-sparkles text-sm text-[#D991A4] shrink-0"></i>
                        <span class="sidebar-text truncate">Cố Vấn Gemini AI</span>
                    </button>
                </nav>
            </div>

            <!-- PHẦN DƯỚI: TAB FEEDBACK BÁO LỖI (BÊN TRÊN CHỮ THU HÀ) & THÔNG TIN PROFILE -->
            <div class="pt-3 border-t border-[#75BFB2]/20 space-y-3">
                
                <!-- TAB / NÚT FEEDBACK CỦA NGƯỜI DÙNG (NẰM BÊN TRÊN CHỮ THU HÀ) -->
                <div>
                    <button type="button" onclick="openFeedbackModal()" id="btnUserFeedback" class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white border border-[#75BFB2]/40 hover:border-[#75BFB2] shadow-xs transition group cursor-pointer" title="Gửi góp ý hoặc báo lỗi cho hệ thống">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <i class="fa-solid fa-comment-dots text-sm text-[#75BFB2] group-hover:scale-110 transition shrink-0"></i>
                            <span class="text-xs font-bold sidebar-text truncate">Góp Ý & Báo Lỗi</span>
                        </div>
                        <span class="px-2 py-0.5 rounded-full text-[9px] font-black bg-[#D991A4] text-white shadow-xs sidebar-text shrink-0">Feedback</span>
                    </button>
                </div>

                <!-- Profile Thu Hà -->
                <div class="flex items-center gap-3 px-1 pt-0.5">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Thu Hà" class="w-9 h-9 rounded-full object-cover ring-2 ring-[#75BFB2] shrink-0">
                    <div class="truncate sidebar-text">
                        <div class="text-xs font-bold text-white truncate">Thu Hà</div>
                        <div class="text-[10px] text-[#B8D9D3] truncate">thuha.analyst@gmail.com</div>
                    </div>
                </div>

                <!-- Status & Mode -->
                <div class="flex items-center justify-between text-[11px] px-1 text-[#B8D9D3] sidebar-text">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-[#75BFB2] animate-pulse"></span> Backend 8050
                    </span>
                    <button onclick="toggleModeBtn()" class="text-[10px] underline hover:text-white cursor-pointer">Chế độ Demo</button>
                </div>
            </div>
        </aside>

        <!-- =================================================================== -->
        <!-- MAIN WORKSPACE CONTENT AREA -->
        <!-- =================================================================== -->
        <main class="flex-1 flex flex-col overflow-y-auto px-6 sm:px-8 lg:px-10 py-6 space-y-6 bg-[#F2E5E4]/25" id="mainWorkspaceContainer">

            <!-- Top Header & Actions -->
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <!-- Nút Ẩn / Hiện Thanh Công Cụ Trên Header -->
                    <button type="button" onclick="toggleSidebar()" class="p-2 rounded-xl bg-white border border-[#B8D9D3] text-[#203833] hover:text-[#75BFB2] hover:border-[#75BFB2] cursor-pointer shadow-xs transition shrink-0" title="Ẩn / Hiện thanh công cụ bên trái">
                        <i class="fa-solid fa-bars text-sm"></i>
                    </button>
                    <div>
                        <h1 class="text-2xl font-extrabold text-[#203833] tracking-tight flex items-center gap-2">
                            <span>Welcome, Thu Hà (Data Analyst & BI Studio)</span>
                            <span class="text-xl">👋</span>
                        </h1>
                        <p class="text-xs text-slate-500 font-medium" id="headerSourceSubtext">
                            Báo cáo hiệu quả kinh doanh • Dự án: <strong class="text-[#203833] font-bold" id="headerProjectName">Dự Án Bán Hàng Đa Kênh</strong> • Trạng thái: <strong class="text-slate-500" id="headerSourceLabel">Chờ tải tệp dữ liệu...</strong>
                        </p>
                    </div>
                </div>

                <!-- Actions: Quick Scenarios, File Upload, Refresh & Gemini Button -->
                <div class="flex flex-wrap items-center gap-2">
                    <!-- Scenario Quick Selector (Chỉ chạy khi người dùng chủ động bấm) -->
                    <div class="bg-white p-1 rounded-full flex items-center gap-1 border border-[#B8D9D3] shadow-xs mr-1">
                        <span class="text-[10px] font-bold text-slate-400 px-2">Test mẫu:</span>
                        <button onclick="setScenario('normal')" id="btn-normal" class="scenario-btn px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 hover:text-[#203833] hover:bg-[#B8D9D3]/40 transition cursor-pointer">Chuẩn</button>
                        <button onclick="setScenario('missing')" id="btn-missing" class="scenario-btn px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 hover:text-[#203833] hover:bg-[#D9A3AC]/40 transition cursor-pointer">Thiếu DL</button>
                        <button onclick="setScenario('boundary')" id="btn-boundary" class="scenario-btn px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 hover:text-[#203833] hover:bg-[#D991A4]/30 transition cursor-pointer">Ranh Giới</button>
                    </div>

                    <!-- Tải tệp mới -->
                    <input type="file" id="appHeaderFileInput" accept=".xlsx,.xls,.csv" class="hidden" onchange="handleAppHeaderFileSelect(event)">
                    <button type="button" onclick="document.getElementById('appHeaderFileInput').click()" title="Tải tệp Excel hoặc CSV mới để phân tích" class="btn-smooth inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-white text-[#203833] border border-[#B8D9D3] hover:border-[#75BFB2] hover:bg-[#B8D9D3]/20 shadow-xs cursor-pointer">
                        <i class="fa-solid fa-file-arrow-up text-[#75BFB2]"></i>
                        <span>Nạp Tệp Mới</span>
                    </button>

                    <!-- Nút Cập Nhật Dữ Liệu (ƯU TIÊN ĐẶC BIỆT) -->
                    <button type="button" onclick="refreshDataBtn()" id="btnHeaderRefresh" title="Bấm để quét lại tệp và tính toán lại P&L" class="btn-smooth inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-extrabold bg-gradient-to-r from-[#75BFB2] to-[#5EABA0] hover:from-[#5EABA0] hover:to-[#75BFB2] text-white shadow-md shadow-[#75BFB2]/30 cursor-pointer">
                        <i class="fa-solid fa-rotate text-white"></i>
                        <span>Phân Tích Lại</span>
                    </button>

                    <!-- Nút Gemini 3.5 Copilot (ƯU TIÊN ĐẶC BIỆT - MÀU ROSE MAUVE) -->
                    <button type="button" onclick="openGeminiCopilot()" id="btnGeminiHeader" title="Bấm để mở Cố Vấn Google Gemini 3.5 Flash Lite" class="btn-smooth inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-extrabold bg-gradient-to-r from-[#F2E5E4] via-[#D9A3AC]/30 to-[#D991A4]/30 hover:from-[#F2E5E4] hover:to-[#D991A4]/50 text-[#872D43] border border-[#D991A4] shadow-sm cursor-pointer ring-1 ring-[#D991A4]/40">
                        <span class="w-2 h-2 rounded-full bg-[#75BFB2] animate-pulse"></span>
                        <span>Gemini 3.5</span>
                        <i class="fa-solid fa-wand-magic-sparkles text-[#D991A4]"></i>
                    </button>
                </div>
            </header>

            <!-- =================================================================== -->
            <!-- WORKFLOW STEPPER BAR (4 BƯỚC HOẠT ĐỘNG THEO LUỒNG) -->
            <!-- =================================================================== -->
            <section class="bg-white rounded-2xl p-4 border-2 border-[#B8D9D3] flex flex-col lg:flex-row items-center justify-between gap-3 shadow-sm">
                <div class="flex items-center gap-2 shrink-0">
                    <span class="text-xs font-black uppercase tracking-wider text-[#203833] flex items-center gap-1.5">
                        <i class="fa-solid fa-network-wired text-[#75BFB2]"></i> Luồng Phân Tích:
                    </span>
                    <span id="badgeVerifyStatus" class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-bold bg-[#B8D9D3]/60 text-[#203833] border border-[#75BFB2]">
                        <i class="fa-solid fa-clock text-[#75BFB2]"></i> CHỜ TẢI DỮ LIỆU
                    </span>
                </div>
                
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 w-full text-center" id="stepperContainer">
                    <!-- Step 1 Stepper Card -->
                    <div class="step-card bg-[#203833] text-white p-2.5 rounded-xl text-center shadow-md transition cursor-pointer" onclick="goToStep(1)" id="step-tab-1">
                        <span class="text-[10px] font-black text-[#75BFB2] block" id="st-badge-1">BƯỚC 1 (Đang Xem)</span>
                        <span class="text-xs font-extrabold truncate block">1. Tiếp Nhận & Bối Cảnh</span>
                    </div>

                    <!-- Step 2 Stepper Card -->
                    <div class="step-card bg-[#D9A3AC]/30 text-[#203833] border border-[#D9A3AC] p-2.5 rounded-xl text-center transition cursor-pointer" onclick="goToStep(2)" id="step-tab-2">
                        <span class="text-[10px] font-bold text-[#203833]/70 block" id="st-badge-2">BƯỚC 2</span>
                        <span class="text-xs font-extrabold truncate block">2. Làm Sạch & Phê Duyệt</span>
                    </div>

                    <!-- Step 3 Stepper Card (ƯU TIÊN ĐẶC BIỆT) -->
                    <div class="step-card bg-[#75BFB2]/30 text-[#203833] border-2 border-[#75BFB2] p-2.5 rounded-xl text-center transition cursor-pointer ring-1 ring-[#75BFB2]/50" onclick="goToStep(3)" id="step-tab-3">
                        <span class="text-[10px] font-black text-[#872D43] block" id="st-badge-3">★ BƯỚC 3 (TRỌNG TÂM)</span>
                        <span class="text-xs font-black truncate block">3. Phân Tích P&L & Causal</span>
                    </div>

                    <!-- Step 4 Stepper Card -->
                    <div class="step-card bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3] p-2.5 rounded-xl text-center transition cursor-pointer" onclick="goToStep(4)" id="step-tab-4">
                        <span class="text-[10px] font-bold text-[#203833]/70 block" id="st-badge-4">BƯỚC 4</span>
                        <span class="text-xs font-extrabold truncate block">4. Duyệt & Xuất Báo Cáo</span>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <button onclick="triggerFeedbackLoop()" id="btnFeedbackLoop" title="Kích hoạt Feedback Loop tái thực thi tính toán" class="btn-smooth px-3.5 py-2 bg-[#F2E5E4] hover:bg-[#D9A3AC]/40 text-[#872D43] border border-[#D991A4] text-xs font-bold rounded-xl shadow-xs flex items-center gap-1.5 cursor-pointer">
                        <i class="fa-solid fa-arrows-rotate text-[#D991A4]"></i>
                        <span>Feedback Loop (Tái Thực Thi)</span>
                    </button>
                </div>
            </section>

                

            <!-- =================================================================== -->
            <!-- 4 SIGNATURE PASTEL KPI CARDS (KHÔNG CÓ SỐ LIỆU MẪU CỐ ĐỊNH) -->
            <!-- =================================================================== -->
            <section id="mainKpiCardsSection" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 hidden">
                
                <!-- Card 1: Doanh Thu Thuần (Pale Mint #B8D9D3 / Teal #75BFB2) -->
                <div class="bg-[#B8D9D3]/40 rounded-3xl p-5 border border-[#75BFB2]/50 shadow-card card-hover flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#203833]">Doanh Thu Thuần</span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white text-[#203833] border border-[#75BFB2]/40 shadow-xs" id="kpiNetRevBadge">
                            Chờ dữ liệu
                        </span>
                    </div>
                    <div class="my-3">
                        <div class="text-2xl lg:text-3xl font-extrabold text-slate-400 tracking-tight" id="kpiNetRev">-- đ</div>
                        <span class="text-[11px] text-[#203833]/70" id="kpiReturnsSubtext">Chờ tải tệp dữ liệu</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-semibold text-[#203833]">
                        <i class="fa-solid fa-basket-shopping text-[#75BFB2]"></i>
                        <span id="kpiOrdersCount">0 đơn hàng</span>
                    </div>
                </div>

                <!-- Card 2: Lợi Nhuận Đóng Góp (CM) (VIBRANT ROSE MAUVE #D991A4 - TRỌNG TÂM ƯU TIÊN) -->
                <div class="bg-[#F2E5E4] rounded-3xl p-5 border-2 border-[#D991A4] shadow-lg ring-2 ring-[#D991A4]/30 card-hover flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 w-20 h-20 bg-[#D991A4]/15 rounded-full blur-xl pointer-events-none"></div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-black uppercase tracking-wider text-[#872D43] flex items-center gap-1.5">
                            <i class="fa-solid fa-star text-[#D991A4] text-[10px]"></i> Lợi Nhuận Đóng Góp (CM)
                        </span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-[#D991A4] text-white shadow-xs" id="kpiProfitMarginPct">
                            --% CM
                        </span>
                    </div>
                    <div class="my-3">
                        <div class="text-2xl lg:text-3xl font-black text-[#872D43] tracking-tight" id="kpiCM">-- đ</div>
                        <span class="text-[11px] text-[#872D43]/80 font-medium">Lợi nhuận thực tế sau mọi chi phí (Trọng tâm)</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-bold text-[#872D43]">
                        <i class="fa-solid fa-arrow-trend-up text-[#D991A4]"></i>
                        <span id="kpiLeadingCampaign">Chờ tính toán P&L</span>
                    </div>
                </div>

                <!-- Card 3: Chi Phí Chiến Dịch (Dusty Rose #D9A3AC) -->
                <div class="bg-[#D9A3AC]/20 rounded-3xl p-5 border border-[#D9A3AC]/50 shadow-card card-hover flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#872D43]">Chi Phí Chiến Dịch</span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white text-[#872D43] border border-[#D9A3AC]/50 shadow-xs">
                            Chi phí thực tế
                        </span>
                    </div>
                    <div class="my-3">
                        <div class="text-2xl lg:text-3xl font-extrabold text-slate-400 tracking-tight" id="kpiCosts">-- đ</div>
                        <span class="text-[11px] text-[#872D43]/70">Voucher + Direct + Phân bổ</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-semibold text-[#872D43]">
                        <i class="fa-solid fa-receipt text-[#D9A3AC]"></i>
                        <span id="kpiCampaignsCount">Chờ phân bổ</span>
                    </div>
                </div>

                <!-- Card 4: Ngoại Lệ HITL (Fresh Mint Alabaster Harmony) -->
                <div class="bg-gradient-to-br from-[#F2E5E4] to-[#B8D9D3]/35 rounded-3xl p-5 border border-[#B8D9D3] shadow-card card-hover flex flex-col justify-between">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold uppercase tracking-wider text-[#203833]">Ngoại Lệ Cần Duyệt</span>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white text-[#203833] border border-[#B8D9D3] shadow-xs">
                            Human Control
                        </span>
                    </div>
                    <div class="my-3">
                        <div class="text-2xl lg:text-3xl font-extrabold text-slate-400 tracking-tight" id="kpiExceptions">--</div>
                        <span class="text-[11px] text-[#203833]/70" id="kpiExceptionsSubtext">Chờ quét tệp ở Bước 2</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-semibold text-[#203833]">
                        <i class="fa-solid fa-user-shield text-[#75BFB2]"></i>
                        <span id="kpiHitlStatus">Chờ dữ liệu</span>
                    </div>
                </div>
            </section>


            <!-- =================================================================== -->
            <!-- BƯỚC 1: TIẾP NHẬN & BỐI CẢNH DỰ ÁN (CONTAINER STEP 1) -->
            <!-- =================================================================== -->
            <div id="tab-step-1" class="step-container space-y-6">
                <div class="bg-white rounded-3xl border-2 border-[#B8D9D3] shadow-card p-6 sm:p-8 space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-[#B8D9D3]/70 gap-2">
                        <div class="flex items-center gap-2.5">
                            <span class="px-3.5 py-1 rounded-full text-[11px] font-black uppercase bg-[#B8D9D3] text-[#203833] border border-[#75BFB2]">
                                BƯỚC 1 / 4
                            </span>
                            <h2 class="text-lg font-black text-[#203833]">Bối Cảnh Dự Án & Nguồn Dữ Liệu</h2>
                        </div>
                        <span class="text-xs font-bold text-[#203833] bg-[#B8D9D3]/50 border border-[#75BFB2] px-3 py-1 rounded-full self-start sm:self-auto">
                            <i class="fa-solid fa-shield-halved mr-1 text-[#75BFB2]"></i> Bảo toàn dữ liệu gốc 100%
                        </span>
                    </div>

                    <!-- Form Bối Cảnh Doanh Nghiệp -->
                    <div class="p-5 bg-gradient-to-br from-[#B8D9D3]/25 via-[#F2E5E4]/40 to-[#D9A3AC]/20 rounded-3xl border border-[#B8D9D3] space-y-4">
                        <div class="flex items-center justify-between pb-3 border-b border-[#B8D9D3]/60">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-xl bg-[#203833] text-[#75BFB2] flex items-center justify-center text-sm shadow-xs">
                                    <i class="fa-solid fa-building"></i>
                                </div>
                                <div>
                                    <h4 class="text-xs font-extrabold text-[#203833]">Thông tin dự án đang phân tích</h4>
                                    <p class="text-[11px] text-slate-500">Dữ liệu bối cảnh giúp AI đưa ra nhận định chiến lược sát thực tế kinh doanh.</p>
                                </div>
                            </div>
                            <button type="button" onclick="saveBusinessContext()" class="btn-smooth px-4 py-2 bg-[#203833] hover:bg-[#172A26] text-white text-xs font-bold rounded-xl shadow-xs border border-[#75BFB2]/50 flex items-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-floppy-disk text-[#75BFB2]"></i>
                                <span>Lưu Bối Cảnh Cho AI</span>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[11px] font-extrabold text-[#203833] uppercase mb-1">Tên Dự Án / Thương Hiệu *</label>
                                <input type="text" id="ctxProjectName" value="Dự Án Bán Hàng Đa Kênh" placeholder="Ví dụ: Dự Án Bán Lẻ Thời Trang Hè 2026..." class="w-full bg-white border border-[#B8D9D3] rounded-xl px-3.5 py-2.5 text-xs text-[#203833] outline-none focus:ring-2 focus:ring-[#75BFB2] font-bold">
                            </div>
                            <div>
                                <label class="block text-[11px] font-extrabold text-[#203833] uppercase mb-1">Loại Hình Doanh Nghiệp *</label>
                                <input type="text" id="ctxBusinessType" value="Bán lẻ & Thương mại điện tử" placeholder="Ví dụ: Bán lẻ thời trang, FMCG, F&B, D2C..." class="w-full bg-white border border-[#B8D9D3] rounded-xl px-3.5 py-2.5 text-xs text-[#203833] outline-none focus:ring-2 focus:ring-[#75BFB2] font-bold">
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-extrabold text-[#203833] uppercase mb-1">Vấn Đề Trọng Tâm Cần Phân Tích *</label>
                            <textarea id="ctxQuestions" rows="2" class="w-full bg-white border border-[#B8D9D3] rounded-xl px-3.5 py-2 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-[#75BFB2] font-mono text-[11px]">Doanh thu theo kênh nào cao nhất?
Chi phí theo chiến dịch nào cao nhất?
Biên đóng góp (CM) và tỷ lệ hoàn hàng?
Chiến dịch nào mang lại tăng trưởng thực sự (Causal Uplift)?</textarea>
                        </div>
                    </div>

                    <!-- NẠP DỮ LIỆU & TÁC VỤ KỊCH BẢN MẪU (2 CỘT SONG SONG) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                        
                        <!-- Cột Trái: Drag & Drop Zone + Google Sheet Input -->
                        <div class="lg:col-span-7 space-y-4">
                            <span class="block text-[11px] font-black text-[#203833] uppercase tracking-wider">
                                <i class="fa-solid fa-cloud-arrow-up text-[#75BFB2] mr-1"></i> Tải Tệp Dữ Liệu Của Bạn (.xlsx, .csv, Google Sheet):
                            </span>

                            <!-- Drop Zone -->
                            <div id="dropZone" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleFileDrop(event)" class="border-2 border-dashed border-[#75BFB2] hover:border-[#203833] rounded-3xl p-6 text-center cursor-pointer transition-all bg-[#B8D9D3]/20 hover:bg-[#B8D9D3]/40 group">
                                <input type="file" id="landingFileInput" accept=".xlsx,.xls,.csv" class="hidden" onchange="handleFileSelect(event)">
                                
                                <div class="w-14 h-14 mx-auto rounded-2xl bg-white text-[#203833] shadow-md flex items-center justify-center text-2xl mb-2 group-hover:scale-110 transition-transform">
                                    <i class="fa-solid fa-file-excel text-[#75BFB2]"></i>
                                </div>

                                <h4 class="text-xs font-black text-[#203833] mb-0.5" id="uploadStatusText">
                                    Kéo thả file Excel / CSV vào đây hoặc <span class="text-[#75BFB2] underline font-black">Chọn file từ máy</span>
                                </h4>
                                <p class="text-[11px] text-slate-500 font-medium">Bảng đơn hàng, Voucher, COGS giá vốn & Chi phí (.xlsx, .csv)</p>
                                
                                <!-- Selected File Badge -->
                                <div id="selectedFilePill" class="hidden mt-2 inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#B8D9D3] text-[#203833] border border-[#75BFB2] text-xs font-bold shadow-xs">
                                    <i class="fa-solid fa-circle-check text-[#75BFB2]"></i>
                                    <span id="selectedFileName">dataset.xlsx</span>
                                </div>
                            </div>

                            <!-- Green Action Box when file is selected -->
                            <div id="fileUploadActionBox" class="hidden p-3.5 bg-gradient-to-r from-[#B8D9D3]/40 via-[#75BFB2]/20 to-[#B8D9D3]/40 border-2 border-[#75BFB2] rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-3 shadow-xs">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-[#75BFB2] text-white flex items-center justify-center text-base shrink-0">
                                        <i class="fa-solid fa-file-circle-check"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs font-bold text-[#203833] flex items-center gap-2">
                                            <span id="fileActionBoxName">dataset.xlsx</span>
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#75BFB2] text-[#203833]">Đã nạp file</span>
                                        </div>
                                        <div class="text-[11px] text-[#203833]/80">Tệp đã nạp! Sẵn sàng quét và làm sạch.</div>
                                    </div>
                                </div>
                                <button type="button" onclick="advanceFromStep1ToStep2()" class="btn-smooth px-4 py-2 bg-gradient-to-r from-[#203833] to-[#2E544C] hover:from-[#172A26] hover:to-[#203833] text-white text-xs font-extrabold rounded-xl shadow-xs shrink-0 cursor-pointer border border-[#75BFB2]/40">
                                    <span>LÀM SẠCH TỆP ➔</span>
                                </button>
                            </div>

                            <!-- Google Sheet Input Bar -->
                            <div>
                                <label class="block text-[11px] font-extrabold text-[#203833] uppercase mb-1">Hoặc Dán Liên Kết Google Sheet / Lark Base:</label>
                                <div class="flex gap-2">
                                    <input type="url" id="landingGSheetUrl" oninput="validateInputRealtime()" placeholder="https://docs.google.com/spreadsheets/d/.../edit" class="flex-1 bg-white border border-[#B8D9D3] rounded-xl text-xs px-3.5 py-2 text-slate-800 outline-none focus:ring-2 focus:ring-[#75BFB2]">
                                    <button type="button" onclick="loadFromGSheetUrl()" class="btn-smooth px-4 py-2 bg-[#203833] hover:bg-[#172A26] text-white text-xs font-bold rounded-xl shadow-xs flex items-center gap-1.5 cursor-pointer border border-[#75BFB2]/40">
                                        <i class="fa-solid fa-cloud-arrow-down text-[#75BFB2]"></i>
                                        <span>Nạp Link</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Red Input Error Banner -->
                            <div id="inputErrorBanner" class="hidden p-3 bg-[#F2E5E4] border-2 border-[#D991A4] rounded-2xl text-xs text-[#872D43]">
                                <div class="flex items-center gap-2 font-bold mb-0.5">
                                    <i class="fa-solid fa-triangle-exclamation text-[#D991A4]"></i>
                                    <span>BÁO LỖI ĐẦU VÀO: SAI ĐỊNH DẠNG</span>
                                </div>
                                <p id="inputErrorMsg" class="text-[#872D43] text-[11px]">Vui lòng kiểm tra lại đường dẫn Google Sheet hoặc chọn tệp hợp lệ (.xlsx, .csv).</p>
                            </div>
                        </div>

                        <!-- Cột Phải: TÁC VỤ KỊCH BẢN KIỂM THỬ MẪU (3 MẪU THEO YÊU CẦU CỦA USER) -->
                        <div class="lg:col-span-5 space-y-3 lg:border-l-2 lg:border-[#B8D9D3]/70 lg:pl-6">
                            <div>
                                <span class="block text-[11px] font-black text-[#203833] uppercase tracking-wider mb-1">
                                    <i class="fa-solid fa-flask-vial text-[#75BFB2] mr-1"></i> Tác Vụ Kịch Bản Kiểm Thử Mẫu (1-Click Test):
                                </span>
                                <p class="text-[11px] text-slate-500 font-medium mb-3">Chọn nhanh 1 trong 3 kịch bản kinh doanh mẫu để AI phân tích ngay lập tức:</p>
                            </div>

                            <!-- 3 Scenario Cards Styled with Teal/Rose Fluid Palette -->
                            <div class="space-y-2.5">
                                <!-- Scenario 1: Chuẩn (Màu Pale Seafoam Mint #B8D9D3) -->
                                <div id="step1-sc-normal" onclick="selectScenarioInStep1('normal')" class="btn-smooth p-3.5 rounded-2xl border-2 border-[#75BFB2] bg-[#B8D9D3]/60 hover:bg-[#B8D9D3] text-[#203833] cursor-pointer transition flex items-center justify-between gap-3 group">
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5 shadow-xs">
                                            <i class="fa-solid fa-circle-check"></i>
                                        </div>
                                        <div>
                                            <div class="text-xs font-black text-[#203833] flex items-center gap-2">
                                                <span>1. Kịch Bản Chuẩn (4 Chiến Dịch P&L)</span>
                                            </div>
                                            <div class="text-[11px] text-[#203833]/80 font-medium mt-0.5">Dữ liệu sạch, 4 kênh bán, đa voucher, P&L hoàn chỉnh</div>
                                        </div>
                                    </div>
                                    <span class="text-[10px] font-extrabold bg-white px-2.5 py-1 rounded-full border border-[#75BFB2] text-[#203833] shrink-0 shadow-xs">Mẫu Test</span>
                                </div>

                                <!-- Scenario 2: Thiếu Chi Phí (Màu Dusty Rose #D9A3AC) -->
                                <div id="step1-sc-missing" onclick="selectScenarioInStep1('missing')" class="btn-smooth p-3.5 rounded-2xl border-2 border-[#D991A4] bg-[#D9A3AC]/60 hover:bg-[#D9A3AC]/80 text-[#203833] cursor-pointer transition flex items-center justify-between gap-3 group">
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-xl bg-[#203833] text-[#D991A4] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5 shadow-xs">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                        </div>
                                        <div>
                                            <div class="text-xs font-black text-[#203833] flex items-center gap-2">
                                                <span>2. Kịch Bản Thiếu Chi Phí</span>
                                            </div>
                                            <div class="text-[11px] text-[#203833]/80 font-medium mt-0.5">Thiếu mã COGS & Chi phí, kích hoạt đề xuất xử lý của AI</div>
                                        </div>
                                    </div>
                                    <span class="text-[10px] font-extrabold bg-white px-2.5 py-1 rounded-full border border-[#D991A4] text-[#872D43] shrink-0 shadow-xs">Test HITL</span>
                                </div>

                                <!-- Scenario 3: Ranh Giới Lãi/Lỗ (Màu Rose Mauve & Cream #F2E5E4 / #D991A4) -->
                                <div id="step1-sc-boundary" onclick="selectScenarioInStep1('boundary')" class="btn-smooth p-3.5 rounded-2xl border-2 border-[#D991A4] bg-[#F2E5E4] hover:bg-[#D991A4]/30 text-[#203833] cursor-pointer transition flex items-center justify-between gap-3 group">
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-bold text-sm shrink-0 mt-0.5 shadow-xs">
                                            <i class="fa-solid fa-arrows-split-up-and-left"></i>
                                        </div>
                                        <div>
                                            <div class="text-xs font-black text-[#203833] flex items-center gap-2">
                                                <span>3. Kịch Bản Ranh Giới Lãi/Lỗ</span>
                                            </div>
                                            <div class="text-[11px] text-[#203833]/80 font-medium mt-0.5">Tỷ lệ hoàn hàng cao, biên đóng góp âm, stress test chỉ số</div>
                                        </div>
                                    </div>
                                    <span class="text-[10px] font-extrabold bg-white px-2.5 py-1 rounded-full border border-[#D991A4] text-[#872D43] shrink-0 shadow-xs">Stress Test</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Nguồn dữ liệu nạp & Điều hướng luồng (Bottom Action Bar của Bước 1) -->
                    <div class="p-5 bg-gradient-to-r from-[#B8D9D3]/40 via-[#F2E5E4]/60 to-[#D991A4]/30 rounded-3xl border-2 border-[#B8D9D3] flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="space-y-1">
                            <div class="text-xs font-extrabold text-[#203833] flex items-center gap-2">
                                <i class="fa-solid fa-database text-[#75BFB2]"></i>
                                <span>Trạng thái tệp dữ liệu:</span>
                                <span id="step1SourceStatus" class="px-3 py-1 rounded-full text-xs font-bold bg-[#B8D9D3] text-[#203833] border border-[#75BFB2]">Chưa nạp tệp</span>
                            </div>
                            <p class="text-[11px] text-slate-600 font-medium" id="step1SourceDetail">Vui lòng nạp file Excel/CSV hoặc chọn một Kịch Bản Mẫu bên trên để AI bắt đầu.</p>
                        </div>

                        <div class="flex items-center gap-3 w-full sm:w-auto">
                            <button type="button" onclick="document.getElementById('landingFileInput').click()" class="btn-smooth px-4 py-2.5 bg-white hover:bg-[#B8D9D3]/20 text-[#203833] border-2 border-[#75BFB2] font-black text-xs rounded-xl shadow-xs cursor-pointer">
                                <i class="fa-solid fa-file-arrow-up text-[#75BFB2] mr-1"></i> Tải Tệp Lên
                            </button>
                            <!-- NÚT TIẾN HÀNH SANG BƯỚC 2: NHẤN NHÁ ƯU TIÊN ĐẶC BIỆT -->
                            <button type="button" id="btnAdvanceToStep2" onclick="advanceFromStep1ToStep2()" class="btn-smooth px-6 py-2.5 bg-gradient-to-r from-[#203833] via-[#2A4C45] to-[#75BFB2] hover:from-[#172A26] hover:to-[#5EABA0] text-white font-black text-xs rounded-xl shadow-lg shadow-[#75BFB2]/30 flex items-center gap-2 cursor-pointer ring-2 ring-[#75BFB2]/40">
                                <span>SANG BƯỚC 2: QUÉT & LÀM SẠCH DỮ LIỆU</span>
                                <i class="fa-solid fa-arrow-right text-[#75BFB2]"></i>
                            </button>
                        </div>
                    </div>
                </div>
