            <!-- =================================================================== -->
            <!-- BƯỚC 2: LÀM SẠCH DỮ LIỆU & RÀ SOÁT NGOẠI LỆ (CONTAINER STEP 2) -->
            <!-- =================================================================== -->
            <div id="tab-step-2" class="step-container hidden space-y-6">
                <!-- Cleaning Header Banner -->
                <div class="bg-gradient-to-r from-[#203833] via-[#2A4C45] to-[#75BFB2] rounded-3xl p-6 text-white shadow-soft">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#75BFB2]/30 mb-2 gap-2">
                        <div class="flex items-center gap-2.5">
                            <span class="px-3 py-1 rounded-full text-[10px] font-extrabold uppercase bg-[#75BFB2] text-slate-950">
                                BƯỚC 2 / 4
                            </span>
                            <h3 class="text-base font-extrabold uppercase tracking-wider text-[#75BFB2] flex items-center gap-2">
                                <i class="fa-solid fa-broom text-[#75BFB2]"></i> QUÉT & LÀM SẠCH DỮ LIỆU TỰ ĐỘNG
                            </h3>
                        </div>
                        <span class="text-xs px-3 py-1 rounded-full bg-[#75BFB2]/20 text-[#75BFB2] border border-[#75BFB2]/30 flex items-center gap-1.5" id="step2StatusBadge">
                            <span class="w-2 h-2 rounded-full bg-[#75BFB2] animate-pulse"></span>
                            <span>AI Data Cleaning & Human Sign-off</span>
                        </span>
                    </div>
                    <p class="text-xs text-slate-300" id="step2HeaderSubtitle">
                        Hệ thống tự động phát hiện các lỗi định dạng, ô trống, trùng lặp và xung đột khuyến mãi ngay khi tệp được đẩy lên, phân tích nguyên nhân và đề xuất hướng giải quyết để bạn phê duyệt.
                    </p>
                </div>

                <!-- KHỐI 1: THÔNG BÁO LỖI PHÁT HIỆN & HƯỚNG GIẢI QUYẾT ĐỀ XUẤT CỦA AI -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-5" id="cleaningIssuesContainer">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-2xl bg-[#F2E5E4] text-[#872D43] flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2 flex-wrap">
                                    <span>Thông Báo Các Lỗi Cần Làm Sạch & Hướng Giải Quyết Của AI</span>
                                    <span id="detectedErrorsBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#D9A3AC]/30 text-[#872D43] border border-[#D9A3AC]">0 Phát hiện</span>
                                </h3>
                                <p class="text-xs text-slate-400">Xem chi tiết các vị trí lỗi cần làm sạch. Bấm nút bên phải để đồng ý với hướng giải quyết của AI.</p>
                            </div>
                        </div>
                        
                        <button type="button" onclick="approveAllCleaningSolutions()" id="btnApproveCleaning" class="btn-smooth px-5 py-2.5 bg-[#75BFB2] hover:bg-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-md shadow-[#75BFB2]/20 flex items-center gap-2 cursor-pointer shrink-0">
                            <i class="fa-solid fa-circle-check text-[#75BFB2] text-sm"></i>
                            <span>ĐỒNG Ý VỚI CÁC HƯỚNG GIẢI QUYẾT LÀM SẠCH</span>
                        </button>
                    </div>

                    <!-- Dynamic List: Exceptions & Proposed AI Solutions -->
                    <div id="cleaningSolutionsList" class="space-y-3">
                        <div class="p-8 bg-slate-50 border border-slate-200 rounded-2xl text-center text-slate-400 italic text-xs">
                            <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-300 block mb-2"></i>
                            Chưa có tệp dữ liệu để rà soát lỗi. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1.
                        </div>
                    </div>

                    <!-- Dynamic HITL Human Control Panel -->
                    <div class="p-5 bg-gradient-to-r from-[#F2E5E4]/60 via-[#B8D9D3]/20 to-[#F2E5E4]/60 rounded-2xl border border-slate-200 space-y-4" id="hitlOverridePanel">
                        <div class="flex items-center justify-between flex-wrap gap-2 pb-2 border-b border-slate-200/80">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center font-bold text-xs shadow-2xs">
                                    <i class="fa-solid fa-sliders"></i>
                                </div>
                                <div>
                                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-wide">Tùy Chọn Can Thiệp Bổ Sung (Human Control - HITL)</h4>
                                    <p class="text-[11px] text-slate-500">Các tùy chọn bên dưới được sinh tự động và điều chỉnh linh hoạt theo đúng đặc điểm dữ liệu trong tệp bạn tải lên.</p>
                                </div>
                            </div>
                            <span id="hitlContextBadge" class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#B8D9D3]/40 text-[#203833] border border-[#B8D9D3]">
                                <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Tự Động Thích Ứng Theo Dữ Liệu
                            </span>
                        </div>
                        
                        <!-- Dynamic Controls Container (Generated based on uploaded dataset) -->
                        <div id="hitlDynamicControlsContainer" class="space-y-4">
                            <div class="p-4 bg-white/80 border border-slate-200 rounded-xl text-center text-slate-400 italic text-xs">
                                <i class="fa-solid fa-cloud-arrow-up text-lg text-slate-300 block mb-1"></i>
                                Chưa có tệp dữ liệu. Sau khi bạn tải tệp ở Bước 1, AI sẽ tự động phân tích và tạo các tùy chọn can thiệp phù hợp nhất với dữ liệu thực tế.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 2: BẢNG THỂ HIỆN DỮ LIỆU MỚI SAU KHI LÀM SẠCH -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4" id="cleanedDataSection">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-2xl bg-[#F2E5E4] text-[#203833] flex items-center justify-center font-bold text-base shadow-xs shrink-0">
                                <i class="fa-solid fa-table-list text-[#203833]"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                                    <span>Bảng Dữ Liệu Mới Sau Khi Làm Sạch</span>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#B8D9D3]/40 text-[#203833] border border-[#B8D9D3]" id="badgeCleanedRecordsCount">0 Đơn Hàng</span>
                                </h3>
                                <p class="text-xs text-slate-400">Toàn bộ dữ liệu giao dịch sau khi đã được AI chuẩn hóa số thực, quy đổi ngày ISO, khử trùng lặp và phân bổ voucher.</p>
                            </div>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-slate-500 font-medium hidden sm:inline">Kiểm tra:</span>
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#F2E5E4] text-[#203833] border border-[#B8D9D3]" id="dataCleanVerificationBadge">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#75BFB2] mr-1"></i> Sẵn Sàng Kiểm Tra
                            </span>
                        </div>
                    </div>

                    <!-- Cleaned Data Table Container -->
                    <div class="overflow-x-auto rounded-2xl border border-slate-200">
                        <table class="w-full text-left text-xs whitespace-nowrap">
                            <thead class="bg-slate-50 text-slate-600 uppercase font-black tracking-wider text-[11px] border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-3.5 text-center">STT</th>
                                    <th class="py-3 px-3.5">Mã Đơn Hàng</th>
                                    <th class="py-3 px-3.5">Ngày Chuẩn Hóa</th>
                                    <th class="py-3 px-3.5">Kênh Bán</th>
                                    <th class="py-3 px-3.5">Mã SP</th>
                                    <th class="py-3 px-3.5 text-center">Số Lượng</th>
                                    <th class="py-3 px-3.5 text-right">Đơn Giá</th>
                                    <th class="py-3 px-3.5 text-right">Chiết Khấu</th>
                                    <th class="py-3 px-3.5 text-right font-black text-[#203833]">Doanh Thu Thuần</th>
                                    <th class="py-3 px-3.5">Chiến Dịch Gán</th>
                                    <th class="py-3 px-3.5 text-center">Trạng Thái Đơn</th>
                                    <th class="py-3 px-3.5 text-center">Làm Sạch</th>
                                </tr>
                            </thead>
                            <tbody id="cleanedDataTableBody" class="divide-y divide-slate-100 text-slate-700 font-medium">
                                <tr>
                                    <td colspan="12" class="py-10 text-center text-slate-400 italic">
                                        <i class="fa-solid fa-file-excel text-2xl text-slate-300 block mb-2"></i>
                                        Chưa có dữ liệu làm sạch. Tải tệp ở Bước 1 để hiển thị dữ liệu mới tại đây.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- SHOW / EXPAND CONTROLS DƯỚI BẢNG -->
                    <div id="cleanedDataPaginationBar" class="hidden flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 pb-1 border-t border-slate-100 mt-2 text-xs">
                        <div class="text-slate-500 font-medium flex items-center gap-2">
                            <i class="fa-solid fa-list-check text-[#75BFB2]"></i>
                            <span>Đang hiển thị <strong id="showingRowCount" class="text-slate-900 font-bold">50</strong> trong tổng số <strong id="totalRowCount" class="text-[#203833] font-extrabold">0</strong> dòng dữ liệu sạch</span>
                        </div>
                        <button type="button" id="btnToggleShowAllCleaned" onclick="toggleShowAllCleanedData()" class="btn-smooth px-5 py-2.5 bg-gradient-to-r from-[#F2E5E4] to-[#B8D9D3]/40 hover:from-[#F2E5E4] hover:to-[#B8D9D3] text-[#203833] font-extrabold text-xs rounded-xl border border-[#B8D9D3] flex items-center gap-2 cursor-pointer shadow-xs transition-all">
                            <i id="iconToggleShowAll" class="fa-solid fa-eye text-[#203833]"></i>
                            <span id="textToggleShowAll">Show Toàn Bộ Dữ Liệu</span>
                        </button>
                    </div>
                </div>

                <!-- KHỐI 3: NÚT XÁC NHẬN CHUYỂN SANG PHÂN TÍCH -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 p-4 bg-white rounded-3xl border border-slate-200/80 shadow-card">
                    <button type="button" onclick="goToStep(1)" class="btn-smooth w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Quay Lại Bước 1 (Tiếp Nhận)</span>
                    </button>
                    <button type="button" onclick="confirmCleanedDataAndProceed()" id="btnProceedToStep3" class="btn-smooth w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-[#203833] via-[#2A4C45] to-[#75BFB2] hover:opacity-95 text-white font-black text-xs rounded-2xl shadow-lg shadow-[#75BFB2]/20 flex items-center justify-center gap-2.5 cursor-pointer">
                        <span>🚀 DỮ LIỆU ĐÃ OK ➔ TIẾP TỤC CHUYỂN SANG PHÂN TÍCH P&L</span>
                        <i class="fa-solid fa-arrow-right text-[#75BFB2] text-sm"></i>
                    </button>
                </div>
            </div>


            <!-- =================================================================== -->
            <!-- BƯỚC 3: PHÂN TÍCH TÀI CHÍNH P&L & CHIẾN LƯỢC CAUSAL (STEP 3) -->
            <!-- =================================================================== -->
            <!-- =================================================================== -->
            <!-- BƯỚC 3: PHÂN TÍCH DỮ LIỆU, SO SÁNH ĐA CHIỀU & BÁO CÁO P&L (STEP 3) -->
            <!-- =================================================================== -->
            <div id="tab-step-3" class="step-container hidden space-y-6">

                <!-- TIÊU ĐỀ: PHÂN TÍCH DỮ LIỆU (DATALENS STUDIO STYLE) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 sm:p-7 space-y-1">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2.5">
                                <i class="fa-solid fa-chart-line text-[#203833]"></i> Phân Tích Dữ Liệu
                            </h2>
                            <p class="text-xs sm:text-sm text-slate-500 font-medium mt-1">
                                Đọc kết quả theo câu hỏi kinh doanh và kiểm tra số liệu của từng bộ.
                            </p>
                        </div>
                        <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3] flex items-center gap-2 self-start sm:self-auto shadow-2xs">
                            <span class="w-2 h-2 rounded-full bg-[#75BFB2] animate-pulse"></span>
                            <span>Khám phá số liệu tự động</span>
                        </span>
                    </div>
                </div>

                <!-- KHỐI 1: PHÂN TÍCH THEO BỐI CẢNH (BUSINESS CONTEXT QA) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4">
                    <div class="flex items-center gap-2.5 pb-2 border-b border-slate-100">
                        <div class="w-8 h-8 rounded-xl bg-[#B8D9D3]/30 text-[#203833] flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-black text-slate-900 flex items-center gap-2">
                                Phân tích theo bối cảnh
                            </h3>
                            <p class="text-[11px] text-slate-400 font-medium" id="ctxQaSubtitle">Chờ tải tệp dữ liệu...</p>
                        </div>
                    </div>

                    <!-- Dynamic Question & Answer Cards -->
                    <div class="space-y-3" id="contextualQaContainer">
                        <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                            <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1 để AI tự động khám phá và trả lời các câu hỏi kinh doanh.
                        </div>
                    </div>
                </div>

                <!-- KHỐI 2: BỘ DỮ LIỆU ĐANG XEM & 3 THẺ METRIC TỔNG QUAN -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                            Bộ dữ liệu đang xem
                        </label>
                        <select id="datasetSelectDropdown" onchange="onDatasetDropdownChange()" class="w-full bg-slate-50/80 hover:bg-white border border-slate-200 rounded-2xl px-4 py-3 text-xs font-extrabold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500 transition cursor-pointer">
                            <option value="" id="datasetSelectOption">-- Chưa tải tệp dữ liệu --</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
                        <!-- Metric 1: Dòng dữ liệu -->
                        <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200/80">
                            <div class="text-xs text-slate-500 font-medium">Dòng dữ liệu</div>
                            <div id="statTotalRows" class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight mt-1">0</div>
                        </div>
                        <!-- Metric 2: Số cột -->
                        <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200/80">
                            <div class="text-xs text-slate-500 font-medium">Số cột</div>
                            <div id="statTotalCols" class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight mt-1">0</div>
                        </div>
                        <!-- Metric 3: Cột dạng số -->
                        <div class="p-4 rounded-2xl bg-slate-50/70 border border-slate-200/80">
                            <div class="text-xs text-slate-500 font-medium">Cột dạng số</div>
                            <div id="statNumericCols" class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight mt-1">0</div>
                        </div>
                    </div>
                </div>

                <!-- 1. BẢNG THƯỚC ĐO TÀI CHÍNH TOÀN DIỆN (EXECUTIVE FINANCIAL OVERVIEW) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                        <div>
                            <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-calculator text-[#203833]"></i> Thước Đo Doanh Thu, Chi Phí & Lợi Nhuận Toàn Diện
                            </h3>
                            <p class="text-xs text-slate-400">Dòng chảy tài chính hoàn chỉnh (Waterfall P&L) được AI tự động bóc tách từ số liệu thực tế</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-[#F2E5E4] text-[#203833] border border-[#B8D9D3] flex items-center gap-1.5 self-start sm:self-auto">
                            <i class="fa-solid fa-chart-pie text-[#203833]"></i> Báo Cáo Tài Chính Quản Trị
                        </span>
                    </div>

                    <!-- BẢNG 8 THẺ THƯỚC ĐO TÀI CHÍNH TOÀN DIỆN (CHIA THÀNH 2 HÀNG RỘNG RÃI, KHÔNG TRỒNG ĐÈ SỐ LIỆU) -->
                    <div class="space-y-4">
                        <!-- HÀNG 1: DÒNG CHẢY DOANH THU & KHẤU TRỪ (4 THẺ RỘNG RÃI) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                            <!-- 1. Doanh Thu Gộp (Pale Seafoam Mint #B8D9D3) -->
                            <div class="p-4 rounded-2xl bg-[#B8D9D3]/40 border-2 border-[#75BFB2] shadow-2xs flex flex-col justify-between hover:border-[#203833] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#203833] uppercase tracking-wider">1. Doanh Thu Gộp</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#203833] border border-[#75BFB2]">Gross Sales</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finGrossRev" class="font-black text-[#203833] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Doanh thu gộp">-- đ</div>
                                </div>
                                <span class="text-[10px] text-slate-500 font-medium">Tổng giá trị đơn hàng trước chiết khấu</span>
                            </div>

                            <!-- 2. Chiết Khấu (Alabaster Cream Blush #F2E5E4 & Rose #D9A3AC) -->
                            <div class="p-4 rounded-2xl bg-[#F2E5E4] border-2 border-[#D9A3AC] shadow-2xs flex flex-col justify-between hover:border-[#D991A4] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#872D43] uppercase tracking-wider">2. Chiết Khấu</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#872D43] border border-[#D9A3AC]">Giảm giá</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finDiscount" class="font-black text-[#D991A4] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Chiết khấu">-- đ</div>
                                </div>
                                <span class="text-[10px] text-[#872D43]/80 font-medium">Voucher, coupon & chương trình giảm giá</span>
                            </div>

                            <!-- 3. Hàng Bán Trả (Alabaster Cream Blush #F2E5E4) -->
                            <div class="p-4 rounded-2xl bg-[#F2E5E4] border-2 border-[#D9A3AC] shadow-2xs flex flex-col justify-between hover:border-[#D991A4] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#872D43] uppercase tracking-wider">3. Hàng Bán Trả</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#872D43] border border-[#D9A3AC]">Returns</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finReturns" class="font-black text-[#D991A4] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Hàng hoàn">-- đ</div>
                                </div>
                                <span class="text-[10px] text-[#872D43]/80 font-medium">Giá trị hàng đổi trả & đơn hủy sau giao</span>
                            </div>

                            <!-- 4. Doanh Thu Thuần (Pale Seafoam Mint #B8D9D3) -->
                            <div class="p-4 rounded-2xl bg-[#B8D9D3]/75 border-2 border-[#75BFB2] shadow-2xs flex flex-col justify-between hover:border-[#203833] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#203833] uppercase tracking-wider">4. Doanh Thu Thuần</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#203833] border border-[#75BFB2] font-black">Net Revenue</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finNetRev" class="font-black text-[#203833] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Doanh thu thuần">-- đ</div>
                                </div>
                                <span class="text-[10px] text-[#203833]/80 font-bold">= Doanh thu gộp - Chiết khấu - Hàng hoàn</span>
                            </div>
                        </div>

                        <!-- HÀNG 2: DÒNG CHẢY CHI PHÍ & LỢI NHUẬN QUẢN TRỊ (4 THẺ RỘNG RÃI) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
                            <!-- 5. Giá Vốn COGS (Dusty Rose #D9A3AC) -->
                            <div class="p-4 rounded-2xl bg-[#D9A3AC]/25 border-2 border-[#D9A3AC] shadow-2xs flex flex-col justify-between hover:border-[#D991A4] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#203833] uppercase tracking-wider">5. Giá Vốn (COGS)</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#203833] border border-[#D9A3AC]">Cost of Goods</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finCogs" class="font-black text-[#203833] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Giá vốn hàng bán">-- đ</div>
                                </div>
                                <span class="text-[10px] text-slate-500 font-medium">Giá vốn thực nhập của hàng đã giao thành công</span>
                            </div>

                            <!-- 6. Lợi Nhuận Gộp (NHẤN NHÁ ƯU TIÊN ĐẶC BIỆT: Fresh Seafoam Teal #75BFB2) -->
                            <div class="p-4 rounded-2xl bg-gradient-to-br from-[#B8D9D3] via-[#75BFB2]/30 to-[#B8D9D3] border-2 border-[#75BFB2] shadow-md flex flex-col justify-between hover:border-[#203833] transition ring-2 ring-[#75BFB2]/40">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#203833] uppercase tracking-wider">6. Lợi Nhuận Gộp</span>
                                    <span id="finGrossMarginPct" class="text-[10px] font-black px-2 py-0.5 rounded-full bg-[#75BFB2] text-[#203833] border border-[#75BFB2] font-mono">(--% biên gộp)</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finGrossProfit" class="font-black text-[#203833] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Lợi nhuận gộp">-- đ</div>
                                </div>
                                <span class="text-[10px] text-[#203833] font-bold">= Doanh thu thuần - Giá vốn (COGS)</span>
                            </div>

                            <!-- 7. Chi Phí MKT & Bán Hàng (Alabaster Cream Blush #F2E5E4) -->
                            <div class="p-4 rounded-2xl bg-[#F2E5E4] border-2 border-[#D9A3AC] shadow-2xs flex flex-col justify-between hover:border-[#D991A4] transition">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#203833] uppercase tracking-wider">7. Chi Phí MKT & Bán Hàng</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white text-[#203833] border border-[#D9A3AC]">Campaign Costs</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finTotalCosts" class="font-black text-[#203833] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Chi phí marketing & bán hàng">-- đ</div>
                                </div>
                                <span class="text-[10px] text-slate-500 font-medium">Chi phí quảng cáo trực tiếp + Chi phí phân bổ</span>
                            </div>

                            <!-- 8. Biên Đóng Góp CM (NGÔI SAO TÀI CHÍNH - NHẤN NHÁ ƯU TIÊN CAO NHẤT: Rose Mauve #D991A4) -->
                            <div class="p-4 rounded-2xl bg-gradient-to-br from-[#F2E5E4] via-[#D9A3AC]/40 to-[#D991A4]/40 border-2 border-[#D991A4] shadow-lg flex flex-col justify-between hover:border-[#872D43] transition ring-2 ring-[#D991A4]/60">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-black text-[#872D43] uppercase tracking-wider">8. Biên Đóng Góp (CM)</span>
                                    <span id="finCmPct" class="text-[10px] font-black px-2 py-0.5 rounded-full bg-[#D991A4] text-white font-mono shadow-xs">(--% CM)</span>
                                </div>
                                <div class="my-2.5">
                                    <div id="finCM" class="font-black text-[#872D43] font-mono text-base sm:text-lg lg:text-xl tracking-tight truncate" title="Lợi nhuận đóng góp">-- đ</div>
                                </div>
                                <span class="text-[10px] text-[#872D43] font-bold">= Lợi nhuận giữ lại sau toàn bộ chi phí</span>
                            </div>
                        </div>
                    </div>

                    <!-- 4 Thước Đo Vận Hành Bổ Trợ -->
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-2 text-xs text-slate-500 border-t border-slate-100">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-cart-shopping text-[#75BFB2]"></i>
                            <span>Giá trị đơn TB (AOV): <strong id="finAov" class="text-[#203833] font-bold font-mono">-- đ</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-arrow-rotate-left text-[#D991A4]"></i>
                            <span>Tỷ lệ hoàn hàng: <strong id="finReturnRate" class="text-[#872D43] font-bold font-mono">--%</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-bullseye text-[#75BFB2]"></i>
                            <span>Hiệu quả chi tiêu (ROAS): <strong id="finRoas" class="text-[#203833] font-bold font-mono">--x</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-[#75BFB2]"></i>
                            <span>Tỷ suất sinh lời ROI: <strong id="finRoi" class="text-[#203833] font-bold font-mono">--%</strong></span>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 4: SO SÁNH THEO NHÓM (GROUP COMPARISON & REALTIME PIVOT - DATALENS STUDIO STYLE) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 sm:p-7 space-y-5">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div>
                            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-chart-simple text-[#203833]"></i> So sánh theo nhóm
                            </h3>
                            <p class="text-xs text-slate-400">Tổng hợp và đối sánh chỉ số trực quan giữa các nhóm phân loại</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]">
                            Interactive Pivot
                        </span>
                    </div>

                    <!-- 3 Dropdowns Controls -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 text-xs">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1.5">Nhóm theo</label>
                            <select id="grpDimSelect" onchange="renderGroupComparison()" class="w-full bg-slate-50 hover:bg-white border border-slate-200 rounded-xl px-3 py-2.5 font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500 transition cursor-pointer">
                                <option value="">-- Chưa tải dữ liệu --</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1.5">Phép tổng hợp</label>
                            <select id="grpAggSelect" onchange="renderGroupComparison()" class="w-full bg-slate-50 hover:bg-white border border-slate-200 rounded-xl px-3 py-2.5 font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500 transition cursor-pointer">
                                <option value="sum" selected>Tổng (Sum)</option>
                                <option value="avg">Trung bình (Avg)</option>
                                <option value="count">Đếm số dòng / Đơn (Count)</option>
                                <option value="max">Lớn nhất (Max)</option>
                                <option value="min">Nhỏ nhất (Min)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 mb-1.5">Cột số</label>
                            <select id="grpMetricSelect" onchange="renderGroupComparison()" class="w-full bg-slate-50 hover:bg-white border border-slate-200 rounded-xl px-3 py-2.5 font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-500 transition cursor-pointer">
                                <option value="">-- Chưa tải dữ liệu --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Horizontal Progress Comparison Bars -->
                    <div class="space-y-3.5 pt-2" id="groupBarsContainer">
                        <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                            <i class="fa-solid fa-chart-simple text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu. Vui lòng tải tệp để AI tự động tổng hợp và so sánh theo từng nhóm.
                        </div>
                    </div>
                    <div class="text-[11px] text-slate-400 italic" id="grpSubtextCaption">
                        Chưa có dữ liệu phân nhóm.
                    </div>

                    <!-- Nhận Xét Tự Động Kết Hợp AI (AI Automated Insights) -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-50 via-[#F2E5E4]/20 to-[#B8D9D3]/30/20 border border-slate-200/90 space-y-3 mt-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-200/60">
                            <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#203833]"></i>
                                <span>Nhận xét tự động từ AI</span>
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#B8D9D3]/40 text-[#203833] font-bold ml-1">Gemini AI Enhanced</span>
                            </h4>
                            <button type="button" id="btnAiAnalyzeSlice" onclick="askAiToAnalyzeSlice()" class="inline-flex items-center gap-1.5 px-3 py-1 bg-white hover:bg-slate-50 border border-[#B8D9D3] rounded-xl text-[11px] font-extrabold text-[#203833] shadow-2xs hover:shadow-xs transition cursor-pointer self-start sm:self-auto">
                                <i class="fa-solid fa-brain text-[#75BFB2]"></i>
                                <span>Hỏi AI nhận xét sâu lát cắt này</span>
                            </button>
                        </div>
                        <div class="text-xs text-slate-700 space-y-2" id="grpAutoInsightsList">
                            <div class="p-4 bg-slate-50/80 border border-slate-200/60 rounded-xl text-slate-400 italic text-center">
                                Chưa có nhận xét. AI sẽ tự động phân tích và đưa ra nhận xét chiến lược từ dữ liệu khi bạn tải tệp lên.
                            </div>
                        </div>
                        <!-- AI Deep Insight Box (tự động hiện khi AI phản hồi) -->
                        <div id="aiSliceDeepInsightContainer" class="hidden p-3.5 rounded-xl bg-[#B8D9D3]/40 border border-[#B8D9D3] text-xs text-[#203833] space-y-1.5 transition-all">
                            <div class="flex items-center gap-1.5 font-bold text-[#203833] text-[11px]">
                                <i class="fa-solid fa-sparkles text-[#75BFB2]"></i>
                                <span>Phân tích chiến lược từ Google Gemini Copilot:</span>
                            </div>
                            <div id="aiSliceDeepInsightText" class="text-[#203833] leading-relaxed pl-4 font-normal"></div>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 5: THỐNG KÊ THEO CỘT (COLUMN PROFILER - DATALENS STUDIO STYLE) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 sm:p-7 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-3">
                        <div>
                            <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-table-columns text-[#203833]"></i> Thống kê theo cột
                            </h3>
                            <p class="text-xs text-slate-400">Ứng dụng nhận dạng cột số theo định dạng bạn chọn.</p>
                        </div>
                        <div class="flex items-center gap-2 self-start sm:self-auto text-xs font-bold">
                            <span class="text-slate-500">Định dạng số:</span>
                            <select id="numberFormatSelect" onchange="renderColumnProfilingTable()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-bold text-slate-800 outline-none cursor-pointer focus:ring-2 focus:ring-emerald-500">
                                <option value="vi" selected>Việt Nam • 1.234,56</option>
                                <option value="en">Quốc tế • 1,234.56</option>
                            </select>
                        </div>
                    </div>

                    <!-- Table Column Profiler -->
                    <div class="overflow-x-auto rounded-2xl border border-slate-200/80">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-600 font-extrabold uppercase tracking-wider text-[11px] border-b border-slate-200">
                                    <th class="py-3 px-3.5">Cột</th>
                                    <th class="py-3 px-3.5">Kiểu</th>
                                    <th class="py-3 px-3.5 text-center">Ô trống</th>
                                    <th class="py-3 px-3.5 text-center">Giá trị khác nhau</th>
                                    <th class="py-3 px-3.5 text-right">Trung bình</th>
                                    <th class="py-3 px-3.5 text-right">Nhỏ nhất</th>
                                    <th class="py-3 px-3.5 text-right">Lớn nhất</th>
                                </tr>
                            </thead>
                            <tbody id="columnProfilingTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr>
                                    <td colspan="7" class="py-10 text-center text-slate-400 italic">
                                        <i class="fa-solid fa-table-columns text-2xl text-slate-300 block mb-2"></i>
                                        Chưa có dữ liệu. Vui lòng tải tệp ở Bước 1 để AI nhận diện kiểu dữ liệu và thống kê chi tiết từng cột.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. BỘ CHUYỂN ĐỔI HƯỚNG PHÂN TÍCH LINH HOẠT (DYNAMIC ANALYSIS ANGLES) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5 shrink-0">
                            <i class="fa-solid fa-compass text-[#203833]"></i> Hướng Phân Tích:
                        </span>
                        <div class="inline-flex p-1 bg-slate-100 rounded-2xl gap-1 text-xs font-extrabold flex-wrap" id="analysisAngleTabs">
                            <button type="button" onclick="switchAnalysisAngle('OVERVIEW')" id="angleTab-OVERVIEW" class="angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl bg-white text-[#203833] shadow-xs cursor-pointer border border-slate-200 flex items-center gap-1.5 font-black">
                                <i class="fa-solid fa-table-cells-large text-[#75BFB2]"></i> Tất Cả Biểu Đồ (Lưới Toàn Cảnh)
                            </button>
                        </div>
                    </div>
                    <button type="button" onclick="triggerAiSmartAngleAnalysis()" id="aiAngleBadge" class="btn-smooth cursor-pointer bg-gradient-to-r from-[#F2E5E4] via-[#F2E5E4] to-[#B8D9D3]/30 hover:from-[#F2E5E4] hover:to-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]/90 shadow-2xs hover:shadow-md px-4 py-2 rounded-2xl flex items-center gap-2.5 font-bold transition active:scale-95 group text-xs shrink-0 self-start md:self-auto" title="Nhấp để AI tự động kích hoạt và hiển thị chi tiết các góc nhìn phân tích">
                        <i class="fa-solid fa-wand-magic-sparkles text-[#203833] animate-pulse text-sm group-hover:rotate-12 transition"></i>
                        <span id="aiAngleBadgeText">AI: Tự động kích hoạt các góc nhìn phân tích phù hợp</span>
                        <span class="bg-[#203833] group-hover:bg-[#203833] text-white text-[10px] px-2.5 py-1 rounded-xl font-bold flex items-center gap-1.5 shadow-2xs transition">
                            <i class="fa-solid fa-play text-[8px]"></i> <span>Chạy AI</span>
                        </span>
                    </button>
                </div>

                <!-- 3. LƯỚI BIỂU ĐỒ ĐA CHIỀU TỰ ĐỘNG THEO DỮ LIỆU (AI DYNAMIC CHARTS - TỰ ĐỘNG THÍCH ỨNG, KHÔNG CỐ ĐỊNH, KHÔNG BỊ TRỐNG) -->
                <div id="multiChartOverviewContainer" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                    <div class="col-span-1 lg:col-span-2 p-12 bg-white rounded-3xl border border-slate-200/80 shadow-card text-center text-slate-400 italic text-xs space-y-2">
                        <i class="fa-solid fa-chart-pie text-3xl text-slate-300 block mb-1"></i>
                        <p class="font-bold text-slate-600 text-sm">Chưa có dữ liệu để vẽ biểu đồ đa chiều</p>
                        <p>Khi bạn tải tệp dữ liệu lên, AI sẽ tự động phân tích và kích hoạt toàn bộ các hướng phân tích trực quan phù hợp với dữ liệu thực tế.</p>
                    </div>
                </div>

                <!-- 3B. CHI TIẾT TỪNG GÓC NHÌN ĐƠN LẺ & BẢNG PHÂN HẠNG (KHI CHỌN 1 TAB CỤ THỂ) -->
                <div id="singleAngleChartContainer" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-5">
                    
                    <!-- Left: Dynamic Chart -->
                    <div class="lg:col-span-8 bg-white rounded-3xl border border-slate-200/80 shadow-card p-6">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4 flex-wrap gap-2">
                            <div>
                                <h3 id="chartDynamicTitle" class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                                    <i class="fa-solid fa-chart-line text-[#203833]"></i> Diễn Biến Doanh Thu & Biên Đóng Góp (Sales Statistics)
                                </h3>
                                <p id="chartDynamicSubtitle" class="text-xs text-slate-400">Đường cong so sánh Doanh thu thuần vs Lợi nhuận đóng góp từ dữ liệu thực tế</p>
                            </div>
                            <span id="chartViewBadge" class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-full border border-slate-200">Góc Nhìn Chiến Dịch</span>
                        </div>
                        <div class="h-64 relative flex items-center justify-center">
                            <canvas id="chartSalesWave" class="w-full h-full"></canvas>
                        </div>
                    </div>

                    <!-- Right: Dynamic Top Items Ranking -->
                    <div class="lg:col-span-4 bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 flex flex-col justify-between">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-2">
                            <h3 id="rankingDynamicTitle" class="text-sm font-extrabold text-slate-900">Chiến Dịch Hàng Đầu</h3>
                            <span id="rankingDynamicSub" class="text-xs text-slate-400 font-semibold">Rank by CM</span>
                        </div>

                        <div class="space-y-3.5 my-auto" id="topSellingCampaignsList">
                            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">
                                Chưa có dữ liệu phân hạng.
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 text-center">
                            <span class="text-[11px] text-slate-400 font-semibold">Tự động phân hạng bởi Thu Hà AI Studio</span>
                        </div>
                    </div>
                </div>

                <!-- 4. DYNAMIC DATA TABLES THEO TỪNG GÓC NHÌN PHÂN TÍCH -->
                
                <!-- Bảng 1: BẢNG P&L CHI TIẾT 13 CỘT (CAMPAIGN VIEW) -->
                <div id="angleView-CAMPAIGN" class="angle-view-container bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 overflow-hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-bullhorn text-[#203833]"></i> Bảng Phân Tích Hiệu Quả P&L Chi Tiết Các Chiến Dịch
                            </h3>
                            <p class="text-xs text-slate-400">13 Cột Chỉ Số Tài Chính Chuẩn Kế Toán Quản Trị • Khử Trùng Đa Voucher</p>
                        </div>
                        <span class="text-xs font-semibold text-slate-500">Đơn vị tính: VNĐ</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] border-b border-slate-100">
                                    <th class="py-3 px-3">Chương Trình</th>
                                    <th class="py-3 px-3 text-center">Số Đơn</th>
                                    <th class="py-3 px-3 text-right">Doanh Thu Gộp</th>
                                    <th class="py-3 px-3 text-right">Hàng Trả</th>
                                    <th class="py-3 px-3 text-right font-bold text-slate-700">DT Thuần</th>
                                    <th class="py-3 px-3 text-right">Giá Vốn (COGS)</th>
                                    <th class="py-3 px-3 text-right">Lợi Nhuận Gộp</th>
                                    <th class="py-3 px-3 text-right text-[#872D43]">Voucher</th>
                                    <th class="py-3 px-3 text-right">CP Direct</th>
                                    <th class="py-3 px-3 text-right">CP Phân Bổ</th>
                                    <th class="py-3 px-3 text-right font-bold">Biên CM</th>
                                    <th class="py-3 px-3 text-center">Biên %</th>
                                    <th class="py-3 px-3 text-center">ROI %</th>
                                </tr>
                            </thead>
                            <tbody id="pnlTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr><td colspan="13" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-file-excel text-3xl text-slate-300 block mb-2"></i>Chưa có số liệu. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Bảng 2: BẢNG ĐỐI SOÁT HIỆU QUẢ ĐA KÊNH BÁN HÀNG (CHANNEL VIEW) -->
                <div id="angleView-CHANNEL" class="angle-view-container hidden bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 overflow-hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-store text-[#203833]"></i> Bảng Phân Tích Hiệu Quả Đa Kênh Bán Hàng (Omnichannel)
                            </h3>
                            <p class="text-xs text-slate-400">So sánh doanh số, tỷ lệ hàng hoàn và biên lợi nhuận giữa Online vs Offline</p>
                        </div>
                        <span class="text-xs font-semibold text-slate-500">Đơn vị tính: VNĐ</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] border-b border-slate-100">
                                    <th class="py-3 px-3">Kênh Bán Hàng</th>
                                    <th class="py-3 px-3 text-center">Số Lượng Đơn</th>
                                    <th class="py-3 px-3 text-right">Doanh Thu Gộp</th>
                                    <th class="py-3 px-3 text-right">Chiết Khấu</th>
                                    <th class="py-3 px-3 text-right">Hàng Hoàn Lại</th>
                                    <th class="py-3 px-3 text-center">Tỷ Lệ Hoàn %</th>
                                    <th class="py-3 px-3 text-right font-bold text-[#203833]">Doanh Thu Thuần</th>
                                    <th class="py-3 px-3 text-right">Giá Vốn COGS</th>
                                    <th class="py-3 px-3 text-right">Lợi Nhuận Gộp</th>
                                    <th class="py-3 px-3 text-right font-bold text-[#203833]">Biên Đóng Góp</th>
                                    <th class="py-3 px-3 text-center">Tỷ Trọng %</th>
                                </tr>
                            </thead>
                            <tbody id="channelTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr><td colspan="11" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-store text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu kênh bán hàng.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Bảng 3: BẢNG CƠ CẤU SẢN PHẨM & GIÁ VỐN COGS (PRODUCT VIEW) -->
                <div id="angleView-PRODUCT" class="angle-view-container hidden bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 overflow-hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-box-open text-[#872D43]"></i> Bảng Cơ Cấu Sản Phẩm & Biên Lợi Nhuận Gộp (Pareto 80/20)
                            </h3>
                            <p class="text-xs text-slate-400">Xếp hạng sản phẩm theo doanh số, kiểm soát giá vốn COGS và biên lãi gộp từng SKU</p>
                        </div>
                        <span class="text-xs font-semibold text-slate-500">Đơn vị tính: VNĐ</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] border-b border-slate-100">
                                    <th class="py-3 px-3 text-center w-12">Hạng</th>
                                    <th class="py-3 px-3">Mã SKU</th>
                                    <th class="py-3 px-3">Tên Sản Phẩm</th>
                                    <th class="py-3 px-3 text-center">Số Lượng Bán</th>
                                    <th class="py-3 px-3 text-right">Doanh Thu Gộp</th>
                                    <th class="py-3 px-3 text-right">Giá Vốn COGS</th>
                                    <th class="py-3 px-3 text-right font-bold text-[#203833]">Lợi Nhuận Gộp</th>
                                    <th class="py-3 px-3 text-center">Biên Lãi Gộp %</th>
                                    <th class="py-3 px-3 text-center">Tỷ Trọng Doanh Số</th>
                                </tr>
                            </thead>
                            <tbody id="productTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr><td colspan="9" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-box-open text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu danh mục sản phẩm.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Bảng 4: BẢNG DIỄN BIẾN THEO THỜI GIAN (TIMELINE VIEW) -->
                <div id="angleView-TIMELINE" class="angle-view-container hidden bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 overflow-hidden">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-2 mb-4">
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-days text-[#872D43]"></i> Bảng Diễn Biến Doanh Số Theo Chu Kỳ Ngày (Daily Trend)
                            </h3>
                            <p class="text-xs text-slate-400">Theo dõi doanh số theo từng mốc thời gian để nắm bắt chu kỳ mua sắm</p>
                        </div>
                        <span class="text-xs font-semibold text-slate-500">Đơn vị tính: VNĐ</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] border-b border-slate-100">
                                    <th class="py-3 px-3">Ngày Giao Dịch</th>
                                    <th class="py-3 px-3 text-center">Số Lượng Đơn</th>
                                    <th class="py-3 px-3 text-right">Doanh Thu Gộp</th>
                                    <th class="py-3 px-3 text-right text-[#D991A4]">Chiết Khấu</th>
                                    <th class="py-3 px-3 text-right font-bold text-[#203833]">Doanh Thu Thuần</th>
                                    <th class="py-3 px-3 text-right">Đơn Giá TB / Đơn</th>
                                </tr>
                            </thead>
                            <tbody id="timelineTableBody" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr><td colspan="6" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-calendar-days text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu ngày tháng.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 5. BÁO CÁO PHÂN TÍCH VẤN ĐỀ & BỘ GIẢI PHÁP THỰC THI CHI TIẾT (EXECUTIVE PROBLEM - SOLUTION MATRIX) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                        <div>
                            <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-list-check text-[#203833]"></i> Báo Cáo Phân Tích Vấn Đề & Bộ Giải Pháp Thực Thi Chi Tiết
                            </h3>
                            <p class="text-xs text-slate-400">Trích xuất trực tiếp từ số liệu thực tế • Bóc tách nguyên nhân gốc rễ & Lộ trình hành động 3 cấp độ (24h - 1 tuần - Dài hạn)</p>
                        </div>
                        <span class="px-3.5 py-1.5 rounded-full text-[11px] font-extrabold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3] flex items-center gap-1.5 self-start sm:self-auto">
                            <i class="fa-solid fa-shield-check text-[#203833]"></i> Thu Hà Action Roadmap
                        </span>
                    </div>

                    <!-- Danh sách các thẻ Vấn đề - Giải pháp -->
                    <div id="problemSolutionMatrixContainer" class="space-y-4">
                        <div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center text-xs">
                            <i class="fa-solid fa-wand-magic-sparkles text-2xl text-slate-300 block mb-2"></i>
                            Đang chờ dữ liệu phân tích. Khi hoàn tất tính toán P&L, hệ thống sẽ tự động tổng hợp Ma trận Vấn đề & Giải pháp tại đây.
                        </div>
                    </div>
                </div>

                <!-- 6. STRATEGY & CAUSAL ANALYSIS SECTION -->
                <div class="space-y-5">
                    <!-- Google Gemini Strategic Commentary -->
                    <div class="bg-gradient-to-r from-[#203833] via-[#2A4C45] to-[#75BFB2] rounded-3xl p-6 text-white shadow-soft relative overflow-hidden">
                        <div class="flex items-center justify-between pb-3 border-b border-[#75BFB2]/30 mb-3">
                            <h3 class="text-xs font-extrabold uppercase tracking-wider text-[#75BFB2] flex items-center gap-2">
                                <i class="fa-solid fa-brain text-[#75BFB2]"></i> Nhận Định Chiến Lược Cấp Cao Từ Google Gemini 3.5 Flash Lite
                            </h3>
                            <span class="text-[10px] px-2.5 py-1 rounded-full bg-[#75BFB2]/30 text-[#B8D9D3] font-mono border border-[#75BFB2]/30">Google AI Studio</span>
                        </div>
                        <div id="geminiInsightsContent" class="text-xs lg:text-sm leading-relaxed text-slate-200 whitespace-pre-wrap font-sans">
                            Hệ thống đang ở trạng thái chờ. Vui lòng tải tệp dữ liệu lên ở Bước 1 để AI Agent bắt đầu phân tích P&L và đưa ra nhận định chiến lược.
                        </div>
                    </div>

                    <!-- 3 Recommendation Types Badges -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="p-4 rounded-2xl bg-[#B8D9D3]/30 border-2 border-[#B8D9D3] flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-[#75BFB2] text-white flex items-center justify-center font-bold text-base"><i class="fa-solid fa-check"></i></div>
                            <div>
                                <strong class="text-xs font-extrabold text-[#203833] block">CONTINUE (Tiếp tục)</strong>
                                <span class="text-[11px] text-[#203833]">Chương trình có CM dương, ROI cao</span>
                            </div>
                        </div>

                        <div class="p-4 rounded-2xl bg-[#F2E5E4] border-2 border-[#D9A3AC] flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-[#D9A3AC] text-white flex items-center justify-center font-bold text-base"><i class="fa-solid fa-pen-to-square"></i></div>
                            <div>
                                <strong class="text-xs font-extrabold text-[#872D43] block">ADJUST (Điều chỉnh)</strong>
                                <span class="text-[11px] text-[#872D43]">Hoàn hàng cao hoặc chi phí KOL lớn</span>
                            </div>
                        </div>

                        <div class="p-4 rounded-2xl bg-[#F2E5E4] border-2 border-[#D991A4] flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-[#D991A4] text-white flex items-center justify-center font-bold text-base"><i class="fa-solid fa-ban"></i></div>
                            <div>
                                <strong class="text-xs font-extrabold text-[#872D43] block">DISCONTINUE (Dừng lại)</strong>
                                <span class="text-[11px] text-[#872D43]">Lỗ sâu, không có triển vọng cải thiện</span>
                            </div>
                        </div>
                    </div>

                    <!-- Causal Analysis Banner -->
                    <div class="bg-[#F2E5E4] border border-[#D9A3AC] rounded-2xl p-4 flex gap-3 text-[#872D43]">
                        <i class="fa-solid fa-triangle-exclamation text-xl shrink-0 mt-0.5 text-[#D991A4]"></i>
                        <div class="space-y-1 text-xs">
                            <h4 class="font-bold text-[#872D43]">Cảnh Báo Phương Pháp Luận: Ghi Nhận Kế Toán vs Tác Động Tăng Trưởng (Causal Uplift)</h4>
                            <p class="text-[#872D43] font-medium">Tuyệt đối không đánh đồng Doanh thu kế toán được phân bổ với Doanh thu tăng thêm thực sự do chiến dịch tạo ra.</p>
                            <p class="text-slate-600">Khách hàng quen có thể tự mua hàng dù không có voucher (hiện tượng Cannibalization / Tự ăn lấn doanh thu). Cần đối chứng A/B Testing trước khi khẳng định quan hệ nhân quả.</p>
                        </div>
                    </div>

                    <!-- Campaign Recommendations Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="recommendationsGrid">
                        <div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center col-span-2 text-xs">
                            Chờ kết quả phân tích P&L để đưa ra khuyến nghị chiến lược điều hành.
                        </div>
                    </div>
                </div>

                <!-- KHỐI 7: DUYỆT BƯỚC NÀY (STEP SIGN-OFF & MODIFICATION REQUEST - DATALENS STUDIO STYLE) -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 sm:p-7 space-y-4">
                    <div class="flex items-center gap-2.5 pb-2 border-b border-slate-100">
                        <div class="w-8 h-8 rounded-full bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-black text-slate-900">
                                Duyệt bước này
                            </h3>
                            <p class="text-xs text-slate-400 font-medium">Kiểm tra kết quả phân tích trước khi tạo báo cáo.</p>
                        </div>
                    </div>

                    <!-- Yêu cầu sửa textarea -->
                    <div class="space-y-2">
                        <label class="block text-xs font-bold text-slate-700">
                            Yêu cầu sửa
                        </label>
                        <textarea id="analysisStepModificationInput" rows="3" placeholder="Ví dụ: Tính doanh thu trung bình theo kênh hoặc kiểm tra chi phí marketing." class="w-full bg-slate-50 border border-slate-200 rounded-2xl p-3.5 text-xs text-slate-800 outline-none focus:bg-white focus:ring-2 focus:ring-emerald-500 transition resize-none"></textarea>
                        
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1">
                            <span class="text-[11px] text-slate-400 font-medium">Yêu cầu chỉnh sửa áp dụng cho bộ dữ liệu đang chọn.</span>
                            <button type="button" onclick="submitAnalysisModificationRequest()" class="btn-smooth px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl flex items-center gap-1.5 self-start sm:self-auto cursor-pointer">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#203833]"></i>
                                <span>Đề xuất chỉnh sửa</span>
                            </button>
                        </div>
                    </div>

                    <!-- Alert Feedback Banner -->
                    <div id="analysisModificationAlert" class="hidden p-3.5 rounded-2xl bg-[#F2E5E4] border border-[#D991A4] text-[#872D43] text-xs flex items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation text-[#D991A4]"></i>
                        <span id="analysisModificationAlertText">Chưa thể tạo bản sửa. Hãy thử lại hoặc chỉnh trực tiếp.</span>
                    </div>

                    <!-- Navigation Footers -->
                    <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <button type="button" onclick="goToStep(2)" class="btn-smooth px-5 py-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 font-bold text-xs flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Làm sạch</span>
                        </button>
                        <div class="flex items-center gap-3 justify-end w-full sm:w-auto">
                            <button type="button" onclick="clearAnalysisModificationRequest()" class="text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer">
                                Bỏ yêu cầu sửa
                            </button>
                            <button type="button" onclick="confirmAndProceedToStep4()" class="btn-smooth px-6 py-2.5 rounded-xl bg-[#75BFB2] hover:bg-[#5EABA0] text-white font-black text-xs shadow-md shadow-[#75BFB2]/20 flex items-center gap-2 cursor-pointer">
                                <span>Xác nhận và tạo báo cáo</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- =================================================================== -->
            <!-- BƯỚC 4: PHÊ DUYỆT & XUẤT BÁO CÁO ĐỘC LẬP (STEP 4) -->
            <!-- =================================================================== -->
            <div id="tab-step-4" class="step-container hidden space-y-6">
                <!-- Phê Duyệt & Khóa Báo Cáo Card -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                        <div class="flex items-center gap-2.5">
                            <span class="px-3 py-1 rounded-full text-[10px] font-extrabold uppercase bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]">
                                BƯỚC 4 / 4
                            </span>
                            <h3 class="text-sm font-extrabold text-slate-900">Ký Phê Duyệt & Khóa Báo Cáo Chính Thức</h3>
                        </div>
                        <span class="text-xs text-slate-400">Chuyên viên Thu Hà • Data Analyst & BI</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                        <div class="md:col-span-8 space-y-3">
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Xác nhận hoàn tất quy trình 4 giai đoạn: Tiếp nhận dữ liệu, Làm sạch 5 nhóm lỗi, Khử trùng đa voucher, Tính toán P&L 13 chỉ số và Kiểm định Causal Uplift. Báo cáo sau khi khóa sẽ được bảo mật và lưu vết toàn bộ trong Nhật ký Audit Trail.
                            </p>
                            <label class="flex items-center gap-2.5 cursor-pointer pt-1">
                                <input type="checkbox" id="signApproval" class="w-4 h-4 rounded text-[#203833] focus:ring-0 cursor-pointer">
                                <span class="text-xs text-slate-800 font-bold">Thu Hà xác nhận kiểm tra và chịu trách nhiệm về tính chuẩn xác của số liệu P&L này.</span>
                            </label>
                        </div>
                        <div class="md:col-span-4 flex flex-col gap-2">
                            <button onclick="signAndLockReport()" class="btn-smooth py-3 px-5 bg-[#203833] hover:bg-[#203833]Dark text-white font-extrabold text-xs rounded-2xl shadow-md shadow-[#75BFB2]/20 flex items-center justify-center gap-2 cursor-pointer">
                                <i class="fa-solid fa-stamp text-[#75BFB2] text-sm"></i>
                                <span>KÝ DUYỆT & KHÓA SỐ LIỆU</span>
                            </button>
                            <div id="signStatusPill" class="hidden text-center py-1 rounded-xl bg-[#B8D9D3]/30 text-[#203833] text-[11px] font-bold border border-[#B8D9D3]">
                                <i class="fa-solid fa-circle-check text-[#203833]"></i> ĐÃ KÝ DUYỆT BỞI THU HÀ
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TỔNG KẾT BÁO CÁO VẤN ĐỀ & GIẢI PHÁP TRÌNH BAN GIÁM ĐỐC -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                        <div>
                            <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-file-contract text-[#203833]"></i> Tóm Tắt Báo Cáo Vấn Đề & Giải Pháp Trình Ban Giám Đốc
                            </h3>
                            <p class="text-xs text-slate-400">Các phát hiện rủi ro thâm hụt tài chính & lộ trình giải pháp hành động được đính kèm vào hồ sơ xuất báo cáo</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-[#F2E5E4] text-[#872D43] border border-[#D9A3AC] self-start sm:self-auto">
                            <i class="fa-solid fa-paperclip text-[#872D43] mr-1"></i> Executive Summary Included
                        </span>
                    </div>
                    <div id="step4ProblemSolutionSummary" class="space-y-3">
                        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">
                            Đang chờ dữ liệu phân tích ở Bước 3 để tổng hợp báo cáo vấn đề - giải pháp.
                        </div>
                    </div>
                </div>

                <!-- CỤM 4 NÚT XUẤT BÁO CÁO ĐỘC LẬP -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6">
                    <div class="pb-3 border-b border-slate-100 mb-4">
                        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                            <i class="fa-solid fa-file-export text-[#203833]"></i> Xuất Báo Cáo Kết Quả Độc Lập (4 Sản Phẩm Bàn Giao)
                        </h3>
                        <p class="text-xs text-slate-400">Các file xuất hoạt động độc lập không cần máy chủ, sẵn sàng trình bày Ban Giám Đốc</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- File 1: Excel -->
                        <div class="p-4 bg-[#B8D9D3]/20 rounded-2xl border border-[#B8D9D3] flex flex-col justify-between space-y-3">
                            <div>
                                <div class="w-10 h-10 rounded-xl bg-[#75BFB2] text-white flex items-center justify-center text-lg mb-2">
                                    <i class="fa-solid fa-file-excel"></i>
                                </div>
                                <h4 class="text-xs font-extrabold text-slate-900">Báo Cáo Excel (.xlsx)</h4>
                                <p class="text-[11px] text-slate-500">4 Sheet chi tiết: P&L, Gán đơn, Ngoại lệ, Audit log.</p>
                            </div>
                            <button onclick="exportExcel()" class="btn-smooth w-full py-2.5 bg-[#75BFB2] hover:bg-[#5EABA0] text-white text-xs font-bold rounded-xl shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-download"></i>
                                <span>Tải Excel</span>
                            </button>
                        </div>

                        <!-- File 2: JSON -->
                        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-3">
                            <div>
                                <div class="w-10 h-10 rounded-xl bg-slate-700 text-white flex items-center justify-center text-lg mb-2">
                                    <i class="fa-solid fa-code"></i>
                                </div>
                                <h4 class="text-xs font-extrabold text-slate-900">Dữ Liệu Thô (.json)</h4>
                                <p class="text-[11px] text-slate-500">Toàn bộ cấu trúc P&L, KPI và Audit trail máy đọc.</p>
                            </div>
                            <button onclick="exportJSON()" class="btn-smooth w-full py-2.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-bold rounded-xl shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-download"></i>
                                <span>Tải JSON</span>
                            </button>
                        </div>

                        <!-- File 3: HTML P&L Chi Tiết -->
                        <div class="p-4 bg-[#F2E5E4] rounded-2xl border border-[#B8D9D3] flex flex-col justify-between space-y-3">
                            <div>
                                <div class="w-10 h-10 rounded-xl bg-[#203833] text-white flex items-center justify-center text-lg mb-2">
                                    <i class="fa-solid fa-file-code"></i>
                                </div>
                                <h4 class="text-xs font-extrabold text-slate-900">Báo Cáo P&L (.html)</h4>
                                <p class="text-[11px] text-slate-500">Báo cáo tài chính độc lập kèm giải trình số liệu.</p>
                            </div>
                            <button onclick="exportHtmlPnL()" class="btn-smooth w-full py-2.5 bg-[#203833] hover:bg-[#203833]Dark text-white text-xs font-bold rounded-xl shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span>Mở Báo Cáo P&L</span>
                            </button>
                        </div>

                        <!-- File 4: HTML Dashboard Tổng Quan -->
                        <div class="p-4 bg-[#B8D9D3]/20 rounded-2xl border border-[#B8D9D3] flex flex-col justify-between space-y-3">
                            <div>
                                <div class="w-10 h-10 rounded-xl bg-[#75BFB2] text-white flex items-center justify-center text-lg mb-2">
                                    <i class="fa-solid fa-chart-column"></i>
                                </div>
                                <h4 class="text-xs font-extrabold text-slate-900">Dashboard (.html)</h4>
                                <p class="text-[11px] text-slate-500">Giao diện Dashboard độc lập có biểu đồ tương tác.</p>
                            </div>
                            <button onclick="exportHtmlDashboard()" class="btn-smooth w-full py-2.5 bg-[#75BFB2] hover:bg-[#5EABA0] text-white text-xs font-bold rounded-xl shadow-xs flex items-center justify-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                <span>Mở Dashboard</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- NHẬT KÝ AUDIT TRAIL LOG ĐẦY ĐỦ -->
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2 mb-4">
                        <div>
                            <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                                <i class="fa-solid fa-clock-rotate-left text-[#203833]"></i> Nhật Ký Kiểm Toán (Audit Trail Log) Chi Tiết
                            </h3>
                            <p class="text-xs text-slate-400">Ghi vết toàn bộ hành trình: Nạp dữ liệu, làm sạch, khử trùng đa voucher và duyệt HITL</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="text" id="logFilter" onkeyup="filterLogs()" placeholder="Lọc nhật ký..." class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-forshop-sidebar">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="text-slate-400 font-semibold uppercase tracking-wider text-[11px] border-b border-slate-100">
                                    <th class="py-2.5 px-3">Thời Gian</th>
                                    <th class="py-2.5 px-3 text-center">Cấp Độ</th>
                                    <th class="py-2.5 px-3">Bước Xử Lý</th>
                                    <th class="py-2.5 px-3">Công Cụ / Quy Tắc</th>
                                    <th class="py-2.5 px-3">Nội Dung Chi Tiết</th>
                                </tr>
                            </thead>
                            <tbody id="auditTrailTable" class="divide-y divide-slate-100 font-medium text-slate-700">
                                <tr><td colspan="5" class="py-6 text-center text-slate-400 italic">Đang tải nhật ký...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Step 4 Navigation Buttons -->
                <div class="flex items-center justify-between pt-2">
                    <button type="button" onclick="goToStep(3)" class="btn-smooth px-5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-bold rounded-xl shadow-xs flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Quay Lại Bước 3 (Dashboard)</span>
                    </button>
                    <button type="button" onclick="startNewProjectWorkflow()" class="btn-smooth px-6 py-2.5 bg-gradient-to-r from-[#203833] to-[#75BFB2] hover:from-[#172A26] hover:to-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-md shadow-[#75BFB2]/25 flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-rotate-right text-[#B8D9D3]"></i>
                        <span>BẮT ĐẦU PHÂN TÍCH DỰ ÁN MỚI</span>
                    </button>
                </div>
            </div>


            <!-- =================================================================== -->
            <!-- CỐ VẤN GEMINI COPILOT CHAT (TAB CHAT) -->
            <!-- =================================================================== -->
            <div id="tab-step-chat" class="step-container hidden space-y-6">
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-6 flex flex-col h-[620px]">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl bg-[#F2E5E4] text-[#203833] flex items-center justify-center font-bold text-lg">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#75BFB2]"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-slate-900">Google Gemini Copilot Bán Hàng</h3>
                                <p class="text-xs text-slate-400">Trợ lý phân tích chiến lược thời gian thực (Model: gemini-3.5-flash-lite)</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]">
                            Sẵn Sàng
                        </span>
                    </div>

                    <!-- Messages Window -->
                    <div id="copilotMessages" class="flex-1 overflow-y-auto space-y-4 p-4 bg-slate-50 rounded-2xl border border-slate-100 mb-4">
                        <div class="p-3.5 bg-white text-slate-700 rounded-2xl border border-slate-100 text-xs shadow-xs max-w-[85%]">
                            <strong class="text-[#203833] block mb-1">Gemini AI Copilot:</strong>
                            Xin chào Thu Hà và Quý Quản trị viên! Tôi là Trợ lý Cố vấn AI cao cấp. Khi bạn tải tệp dữ liệu lên, tôi sẽ trực tiếp đối chiếu P&L, kiểm định Causal Uplift và giải đáp mọi câu hỏi phân tích của bạn!
                        </div>
                    </div>

                    <!-- Input Bar -->
                    <div class="flex gap-2">
                        <input type="text" id="copilotInput" onkeydown="if(event.key==='Enter') sendCopilotQuery()" placeholder="Hỏi Gemini về hiệu quả chiến dịch, biên đóng góp hoặc ngoại lệ..." class="flex-1 bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-forshop-sidebar">
                        <button onclick="sendCopilotQuery()" class="btn-smooth px-6 py-3 bg-[#203833] hover:bg-[#203833]Dark text-white font-bold text-xs rounded-2xl shadow-sm flex items-center gap-2 cursor-pointer">
                            <span>Gửi</span>
                            <i class="fa-solid fa-paper-plane text-[#75BFB2]"></i>
                        </button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- =================================================================== -->
    <!-- JAVASCRIPT CONTROLLER: 4-STEP WORKFLOW, PIPELINE & DATA BINDING -->
    <!-- =================================================================== -->
    <script>
        // Global State - KHÔNG CÓ SỐ LIỆU MẪU CỐ ĐỊNH BAN ĐẦU
        let currentScenario = null; // Chỉ có khi người dùng bấm kịch bản mẫu
        let uploadedFileBase64 = null;
        let uploadedFileName = null;
        let lastApiResponse = null;
        let salesWaveChartInstance = null;
        let isDemoMode = false;
        let currentStepNumber = 1;

        // ===================================================================
        // WORKFLOW CONTROLLER: 4 BƯỚC TIẾN TRÌNH THEO LUỒNG
        // ===================================================================
        function goToStep(step) {
            // Hide all step containers
            document.querySelectorAll('.step-container').forEach(el => el.classList.add('hidden'));

            // Ẩn hoàn toàn hàng KPI đầu tiên vì Bước 3 đã có Thước Đo Doanh Thu, Chi Phí & Lợi Nhuận Toàn Diện đầy đủ
            const mainKpis = document.getElementById('mainKpiCardsSection');
            if (mainKpis) {
                mainKpis.classList.add('hidden');
            }
            
            // Remove active states on sidebar buttons
            document.querySelectorAll('.side-btn').forEach(btn => {
                btn.classList.remove('bg-[#75BFB2]', 'text-[#203833]', 'font-black', 'shadow-sm');
                btn.classList.add('text-[#B8D9D3]');
                if (isSidebarCollapsed) {
                    btn.classList.add('justify-center', '!px-2');
                }
            });

            // Remove active states on stepper cards
            for (let i = 1; i <= 4; i++) {
                const stCard = document.getElementById(`step-tab-${i}`);
                const stBadge = document.getElementById(`st-badge-${i}`);
                if (stCard) {
                    if (i === 3) {
                        stCard.className = "step-card bg-white/80 text-[#203833] border-2 border-[#D991A4] p-2.5 rounded-xl text-center transition cursor-pointer hover:bg-white shadow-xs";
                    } else {
                        stCard.className = "step-card bg-white/70 text-[#203833] border border-[#B8D9D3] p-2.5 rounded-xl text-center transition cursor-pointer hover:bg-white";
                    }
                }
                if (stBadge) {
                    stBadge.className = i === 3 ? "text-[10px] font-black text-[#D991A4] block" : "text-[10px] font-bold text-[#75BFB2] block";
                    stBadge.innerText = i === 3 ? `★ BƯỚC 3 (TRỌNG TÂM)` : `BƯỚC ${i}`;
                }
            }

            if (step === 'chat') {
                const chatEl = document.getElementById('tab-step-chat');
                if (chatEl) chatEl.classList.remove('hidden');
                const sideChat = document.getElementById('side-step-chat');
                if (sideChat) {
                    sideChat.classList.remove('text-[#B8D9D3]');
                    sideChat.classList.add('bg-[#75BFB2]', 'text-[#203833]', 'font-black', 'shadow-sm');
                    if (isSidebarCollapsed) sideChat.classList.add('justify-center', '!px-2');
                }
            } else {
                currentStepNumber = step;
                const containerEl = document.getElementById(`tab-step-${step}`);
                if (containerEl) containerEl.classList.remove('hidden');

                // Active sidebar button
                const sideBtn = document.getElementById(`side-step-${step}`);
                if (sideBtn) {
                    sideBtn.classList.remove('text-[#B8D9D3]');
                    sideBtn.classList.add('bg-[#75BFB2]', 'text-[#203833]', 'font-black', 'shadow-sm');
                    if (isSidebarCollapsed) sideBtn.classList.add('justify-center', '!px-2');
                }

                // Active stepper card
                const activeStCard = document.getElementById(`step-tab-${step}`);
                const activeStBadge = document.getElementById(`st-badge-${step}`);
                if (activeStCard) {
                    activeStCard.className = "step-card bg-[#203833] text-white p-2.5 rounded-xl text-center shadow-md transition cursor-pointer border-2 border-[#75BFB2]";
                }
                if (activeStBadge) {
                    activeStBadge.className = "text-[10px] font-black text-[#75BFB2] block";
                    activeStBadge.innerText = step === 3 ? `★ BƯỚC 3 (TRỌNG TÂM - Đang Xem)` : `BƯỚC ${step} (Đang Xem)`;
                }

                // Mark previous steps as completed if data analyzed
                if (lastApiResponse && lastApiResponse.pnl_table && lastApiResponse.pnl_table.length > 0) {
                    for (let i = 1; i < step; i++) {
                        const prevBadge = document.getElementById(`st-badge-${i}`);
                        if (prevBadge) {
                            prevBadge.className = "text-[10px] font-bold text-[#203833] block";
                            prevBadge.innerHTML = `<i class="fa-solid fa-check mr-0.5"></i> BƯỚC ${i} (ĐÃ XỬ LÝ)`;
                        }
                    }
                }

                if (step === 3 && lastApiResponse) {
                    renderSalesWaveChart(lastApiResponse);
                }
            }

            // Scroll workspace to top smoothly
            const mainContainer = document.getElementById('mainWorkspaceContainer');
            if (mainContainer) mainContainer.scrollTop = 0;
        }

        // Advance from Step 1 to Step 2
        async function advanceFromStep1ToStep2() {
            if (!uploadedFileBase64 && !currentScenario) {
                // If user hasn't loaded any file yet, open file picker
                const fInput = document.getElementById('landingFileInput') || document.getElementById('appHeaderFileInput');
                if (fInput) fInput.click();
                showToast("📁 Vui lòng chọn tệp Excel/CSV hoặc chọn 1 kịch bản kiểm thử mẫu!", "info");
                return;
            }
            await saveBusinessContext();
            goToStep(2);
            showToast("✨ Đang quét và làm sạch dữ liệu cho tệp...");
            await fetchBackendPipeline();
        }

        // Advance from Step 2 to Step 3
        async function advanceFromStep2ToStep3() {
            if (!lastApiResponse || !lastApiResponse.pnl_table || lastApiResponse.pnl_table.length === 0) {
                await fetchBackendPipeline();
            }
            goToStep(3);
            showToast("📊 Chuyển sang Bước 3: Phân tích P&L & Causal!");
        }

        // Advance from Step 3 to Step 4
        function advanceFromStep3ToStep4() {
            goToStep(4);
            showToast("📑 Chuyển sang Bước 4: Duyệt & Xuất Báo Cáo!");
        }

        // Start Workflow From Landing Page
        async function startWorkflowFromLanding() {
            if (!validateInputRealtime()) return;
            
            // Sync project context from landing to step 1
            const pName = document.getElementById('landingProjectName').value.trim() || "Dự Án Bán Hàng Đa Kênh";
            const bType = document.getElementById('landingBusinessType').value.trim() || "Bán lẻ & Thương mại điện tử";
            const qs = document.getElementById('landingQuestions').value.trim() || "";

            const ctxNameEl = document.getElementById('ctxProjectName');
            const ctxTypeEl = document.getElementById('ctxBusinessType');
            const ctxQuesEl = document.getElementById('ctxQuestions');
            if (ctxNameEl) ctxNameEl.value = pName;
            if (ctxTypeEl) ctxTypeEl.value = bType;
            if (ctxQuesEl) ctxQuesEl.value = qs;

            const headerProj = document.getElementById('headerProjectName');
            if (headerProj) headerProj.innerText = pName;

            navigateTo('app');

            if (uploadedFileBase64 || currentScenario) {
                showToast(`🚀 Đang phân tích tệp dữ liệu cho dự án [${pName}]...`);
                setTimeout(async () => {
                    await fetchBackendPipeline();
                    goToStep(2); // Jump to cleaning to see live results
                }, 300);
            } else {
                setTimeout(() => {
                    goToStep(1); // Stay on step 1 to prompt upload
                    showToast("📁 Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1!", "info");
                }, 300);
            }
        }

        // Start new project workflow (Reset all data)
        function startNewProjectWorkflow() {
            uploadedFileBase64 = null;
            uploadedFileName = null;
            currentScenario = null;
            lastApiResponse = null;
            
            document.getElementById('selectedFilePill').classList.add('hidden');
            document.getElementById('fileUploadActionBox').classList.add('hidden');
            document.getElementById('landingFileInput').value = '';
            document.getElementById('appHeaderFileInput').value = '';
            document.getElementById('uploadStatusText').innerHTML = `Kéo thả file Excel / CSV vào đây hoặc <span class="text-[#203833] underline">Chọn file</span>`;
            
            renderEmptyState();
            navigateTo('landing');
            showToast("🔄 Đã sẵn sàng phân tích một dự án mới!");
        }

        // Realtime Input Validation (Trang 1)
        function validateInputRealtime() {
            const urlInput = document.getElementById('landingGSheetUrl');
            const url = urlInput ? urlInput.value.trim() : "";
            const errBanner = document.getElementById('inputErrorBanner');
            const btnProceed = document.getElementById('btnProceedDashboard');

            if (url && !url.includes("docs.google.com/spreadsheets/d/")) {
                errBanner.classList.remove('hidden');
                document.getElementById('inputErrorMsg').innerText = "Báo lỗi: Đường dẫn Google Sheet không đúng định dạng. Vui lòng cung cấp link dạng: https://docs.google.com/spreadsheets/d/.../edit";
                btnProceed.classList.add('opacity-50', 'pointer-events-none');
                return false;
            } else {
                errBanner.classList.add('hidden');
                btnProceed.classList.remove('opacity-50', 'pointer-events-none');
                return true;
            }
        }

        // Save Business Context to Backend
        async function saveBusinessContext() {
            const projectName = document.getElementById('ctxProjectName') ? document.getElementById('ctxProjectName').value.trim() : "Dự Án Bán Hàng Đa Kênh";
            const businessType = document.getElementById('ctxBusinessType') ? document.getElementById('ctxBusinessType').value.trim() : "Bán lẻ & Thương mại điện tử";
            const questions = document.getElementById('ctxQuestions') ? document.getElementById('ctxQuestions').value.trim() : "";

            const headerProj = document.getElementById('headerProjectName');
            if (headerProj) headerProj.innerText = projectName;

            try {
                await fetch('/api/save_context', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        project_name: projectName,
                        business_type: businessType,
                        questions: questions
                    })
                });
                showToast(`✅ Đã lưu bối cảnh dự án [${projectName}] cho AI!`);
            } catch (err) {
                console.warn("Could not save context remotely:", err);
            }
        }

        // Floating Toast Notification
        function showToast(msg, type = 'info') {
            const existing = document.getElementById('appToast');
            if (existing) existing.remove();

            const toast = document.createElement('div');
            toast.id = 'appToast';
            const bgClass = type === 'error' 
                ? 'bg-[#203833] text-[#F2E5E4] border-[#D991A4] shadow-[#D991A4]/30' 
                : (type === 'success' ? 'bg-[#203833] text-[#B8D9D3] border-[#75BFB2] shadow-[#75BFB2]/30' : 'bg-slate-900/95 text-slate-100 border-slate-700 shadow-slate-900/40');
            const iconClass = type === 'error' 
                ? 'fa-triangle-exclamation text-[#D991A4]' 
                : (type === 'success' ? 'fa-circle-check text-[#75BFB2]' : 'fa-circle-info text-[#75BFB2]');
            
            toast.className = `fixed top-6 right-6 z-50 max-w-md px-4 py-3 ${bgClass} rounded-2xl shadow-2xl border flex items-center justify-between gap-3 text-xs font-semibold backdrop-blur-md transition-all duration-300 transform translate-y-0 opacity-100`;
            toast.innerHTML = `
                <div class="flex items-center gap-2.5">
                    <i class="fa-solid ${iconClass} text-sm shrink-0"></i>
                    <span class="leading-snug">${msg}</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-white/60 hover:text-white shrink-0 ml-2 p-1 text-sm cursor-pointer" title="Đóng thông báo">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            `;
            document.body.appendChild(toast);
            setTimeout(() => {
                if (toast && toast.parentElement) {
                    toast.classList.add('opacity-0', '-translate-y-2');
                    setTimeout(() => toast.remove(), 300);
                }
            }, 4500);
        }

        // Open Gemini Copilot
        function openGeminiCopilot() {
            const landingEl = document.getElementById('landing-view');
            const isLandingVisible = landingEl && !landingEl.classList.contains('hidden');
            
            if (isLandingVisible) {
                navigateTo('app');
                setTimeout(() => {
                    goToStep('chat');
                    const input = document.getElementById('copilotInput');
                    if (input) input.focus();
                }, 350);
            } else {
                goToStep('chat');
                setTimeout(() => {
                    const input = document.getElementById('copilotInput');
                    if (input) input.focus();
                }, 50);
            }
            showToast("✨ Đã mở Cố Vấn Google Gemini 3.5 Copilot!");
        }

        // View Navigation (Trang 1 <-> Trang 2)
        function navigateTo(viewName) {
            const landingEl = document.getElementById('landing-view');
            const appEl = document.getElementById('app-view');

            if (viewName === 'app') {
                landingEl.classList.remove('opacity-100', 'scale-100');
                landingEl.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    landingEl.classList.add('hidden');
                    appEl.classList.remove('hidden');
                    setTimeout(() => {
                        appEl.classList.remove('opacity-0', 'scale-95');
                        appEl.classList.add('opacity-100', 'scale-100');
                        
                        // If file or scenario present, run pipeline; else stay in clean empty state
                        if (uploadedFileBase64 || currentScenario) {
                            fetchBackendPipeline();
                        } else {
                            renderEmptyState();
                            goToStep(1);
                        }
                    }, 30);
                }, 250);
            } else {
                appEl.classList.remove('opacity-100', 'scale-100');
                appEl.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    appEl.classList.add('hidden');
                    landingEl.classList.remove('hidden');
                    setTimeout(() => {
                        landingEl.classList.remove('opacity-0', 'scale-95');
                        landingEl.classList.add('opacity-100', 'scale-100');
                    }, 30);
                }, 250);
            }
        }

        function proceedToDashboard() {
            if (!validateInputRealtime()) return;
            navigateTo('app');
        }

        async function refreshDataBtn() {
            const btn = document.getElementById('btnHeaderRefresh');
            if (btn) btn.innerHTML = `<i class="fa-solid fa-rotate fa-spin text-[#B8D9D3]"></i> <span>Đang Quét Lại...</span>`;
            
            if (uploadedFileBase64 || currentScenario) {
                await fetchBackendPipeline();
            } else {
                showToast("📁 Chưa có tệp dữ liệu. Vui lòng bấm 'Nạp Tệp Mới'!", "info");
            }
            
            if (btn) btn.innerHTML = `<i class="fa-solid fa-rotate text-[#B8D9D3]"></i> <span>Phân Tích Lại</span>`;
        }

        // File Drag & Drop Handlers on Landing
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('landingFileInput');
        if (dropZone && fileInput) {
            dropZone.addEventListener('click', () => fileInput.click());
        }

        function handleDragOver(e) {
            e.preventDefault();
            dropZone.classList.add('border-[#203833]', 'bg-[#B8D9D3]/40');
        }

        function handleDragLeave(e) {
            e.preventDefault();
            dropZone.classList.remove('border-[#203833]', 'bg-[#B8D9D3]/40');
        }

        function handleFileDrop(e) {
            e.preventDefault();
            dropZone.classList.remove('border-[#203833]', 'bg-[#B8D9D3]/40');
            if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                processFile(e.dataTransfer.files[0]);
            }
        }

        function handleFileSelect(e) {
            if (e.target.files && e.target.files.length > 0) {
                processFile(e.target.files[0]);
                e.target.value = '';
            }
        }

        function handleAppHeaderFileSelect(e) {
            if (e.target.files && e.target.files.length > 0) {
                const file = e.target.files[0];
                const validExts = [".xlsx", ".xls", ".csv"];
                const isValid = validExts.some(ext => file.name.toLowerCase().endsWith(ext));
                if (!isValid) {
                    alert(`Báo lỗi: File [${file.name}] không đúng định dạng. Vui lòng chọn file bảng tính (.xlsx, .xls, .csv).`);
                    return;
                }

                uploadedFileName = file.name;
                currentScenario = null;
                isDemoMode = false;
                const reader = new FileReader();
                reader.onload = function(evt) {
                    uploadedFileBase64 = evt.target.result.split(',')[1];
                    lastApiResponse = null;
                    showToast(`⚡ Đã nhận tệp [${file.name}]! Đang chuyển sang Bước 2 làm sạch...`);
                    
                    // Update Step 1 status UI
                    updateStep1FileUI(file.name, file.size);
                    
                    // Run analysis on this file
                    fetchBackendPipeline().then(() => {
                        goToStep(2);
                    });
                };
                reader.readAsDataURL(file);
                e.target.value = '';
            }
        }

        function processFile(file) {
            const validExts = [".xlsx", ".xls", ".csv"];
            const isValid = validExts.some(ext => file.name.toLowerCase().endsWith(ext));
            const errBanner = document.getElementById('inputErrorBanner');

            if (!isValid) {
                errBanner.classList.remove('hidden');
                document.getElementById('inputErrorMsg').innerText = `Báo lỗi: File [${file.name}] không đúng định dạng. Chỉ chấp nhận các file bảng tính (.xlsx, .xls, .csv).`;
                return;
            }

            errBanner.classList.add('hidden');
            uploadedFileName = file.name;
            currentScenario = null;
            isDemoMode = false;
            
            const reader = new FileReader();
            reader.onload = function(e) {
                uploadedFileBase64 = e.target.result.split(',')[1];
                lastApiResponse = null;
                
                document.getElementById('uploadStatusText').innerText = `Đã nhận tệp: ${file.name}`;
                const pill = document.getElementById('selectedFilePill');
                pill.classList.remove('hidden');
                document.getElementById('selectedFileName').innerText = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;

                const actionBox = document.getElementById('fileUploadActionBox');
                if (actionBox) {
                    actionBox.classList.remove('hidden');
                    document.getElementById('fileActionBoxName').innerText = file.name;
                }

                updateStep1FileUI(file.name, file.size);
                showToast(`✅ Đã nạp [${file.name}]! Bấm BẮT ĐẦU QUY TRÌNH để làm sạch.`);
            };
            reader.readAsDataURL(file);
        }

        function updateStep1FileUI(fname, fsize) {
            const sStatus = document.getElementById('step1SourceStatus');
            const sDetail = document.getElementById('step1SourceDetail');
            const btn = document.getElementById('btnAdvanceToStep2');
            if (sStatus) {
                sStatus.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#B8D9D3]/40 text-[#203833]";
                sStatus.innerText = `Đã nạp tệp: ${fname}`;
            }
            if (sDetail) {
                sDetail.innerText = `Dung lượng: ${(fsize/1024).toFixed(1)} KB • Sẵn sàng quét và làm sạch dữ liệu tự động.`;
            }
            if (btn) {
                btn.innerHTML = `<span>TIẾN HÀNH LÀM SẠCH [${fname}] (BƯỚC 2 ➔)</span>`;
            }
        }

        function selectScenarioAndProceed(sc) {
            currentScenario = sc;
            uploadedFileBase64 = null;
            uploadedFileName = null;
            document.getElementById('landingGSheetUrl').value = '';
            document.getElementById('inputErrorBanner').classList.add('hidden');
            lastApiResponse = null;
            startWorkflowFromLanding();
        }

        function loadFromGSheetUrl() {
            if (!validateInputRealtime()) return;
            const url = document.getElementById('landingGSheetUrl').value.trim();
            if (!url) {
                alert('Vui lòng nhập đường link Google Sheet hợp lệ!');
                return;
            }
            uploadedFileBase64 = null;
            uploadedFileName = null;
            lastApiResponse = null;
            isDemoMode = false;
            startWorkflowFromLanding();
        }

        function selectScenarioInStep1(sc) {
            currentScenario = sc;
            uploadedFileBase64 = null;
            uploadedFileName = null;
            isDemoMode = false;

            const scNames = {
                'normal': 'Kịch Bản Chuẩn (4 Chiến Dịch P&L)',
                'missing': 'Kịch Bản Thiếu Chi Phí [Test HITL]',
                'boundary': 'Kịch Bản Ranh Giới Lãi/Lỗ [Stress Test]'
            };

            // Highlight Step 1 scenario card
            ['normal', 'missing', 'boundary'].forEach(k => {
                const el = document.getElementById('step1-sc-' + k);
                if (el) {
                    if (k === sc) {
                        el.classList.add('ring-4', 'ring-[#75BFB2]', 'shadow-lg');
                    } else {
                        el.classList.remove('ring-4', 'ring-[#75BFB2]', 'shadow-lg');
                    }
                }
            });

            // Update Step 1 Status
            const sStatus = document.getElementById('step1SourceStatus');
            const sDetail = document.getElementById('step1SourceDetail');
            const btn = document.getElementById('btnAdvanceToStep2');
            if (sStatus) {
                sStatus.className = "px-3 py-1 rounded-full text-xs font-bold bg-[#B8D9D3] text-[#203833] border border-[#75BFB2]";
                sStatus.innerText = `Đã chọn: ${scNames[sc] || sc}`;
            }
            if (sDetail) {
                sDetail.innerText = `Kịch bản mẫu đã sẵn sàng. Bấm nút bên phải để bắt đầu quét và làm sạch dữ liệu tự động.`;
            }
            if (btn) {
                btn.innerHTML = `<span>BẮT ĐẦU LÀM SẠCH [${scNames[sc] || sc}] (BƯỚC 2 ➔)</span> <i class="fa-solid fa-arrow-right text-[#D991A4]"></i>`;
            }

            // Sync with header selector
            document.querySelectorAll('.scenario-btn').forEach(btnEl => {
                btnEl.className = "scenario-btn px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition";
            });
            const activeBtn = document.getElementById(`btn-${sc}`);
            if (activeBtn) {
                activeBtn.className = "scenario-btn px-2.5 py-1 rounded-full text-xs font-bold bg-[#203833] text-[#75BFB2] shadow-xs transition";
            }

            showToast(`🎯 Đã chọn [${scNames[sc]}]! Bấm SANG BƯỚC 2 để tiến hành làm sạch.`);
        }

        function setScenario(sc) {
            currentScenario = sc;
            uploadedFileBase64 = null;
            uploadedFileName = null;
            document.querySelectorAll('.scenario-btn').forEach(btn => {
                btn.className = "scenario-btn px-2.5 py-1 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition";
            });
            const activeBtn = document.getElementById(`btn-${sc}`);
            if (activeBtn) {
                activeBtn.className = "scenario-btn px-2.5 py-1 rounded-full text-xs font-bold bg-[#203833] text-[#75BFB2] shadow-xs transition";
            }

            // Also highlight Step 1 scenario cards if present
            ['normal', 'missing', 'boundary'].forEach(k => {
                const el = document.getElementById('step1-sc-' + k);
                if (el) {
                    if (k === sc) {
                        el.classList.add('ring-4', 'ring-[#75BFB2]', 'shadow-lg');
                    } else {
                        el.classList.remove('ring-4', 'ring-[#75BFB2]', 'shadow-lg');
                    }
                }
            });

            fetchBackendPipeline();
        }

        function toggleModeBtn() {
            isDemoMode = !isDemoMode;
            alert(isDemoMode ? 'Đã chuyển sang chế độ Demo Giả lập.' : 'Đã kết nối lại Backend Python (Port 8050).');
            if (uploadedFileBase64 || currentScenario) {
                fetchBackendPipeline();
            }
        }

        function formatVND(num) {
            if (num === undefined || num === null || isNaN(num)) return '0 đ';
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num);
        }

        function triggerFeedbackLoop() {
            if (!uploadedFileBase64 && !currentScenario) {
                showToast("📁 Chưa có tệp dữ liệu để thực hiện Feedback Loop. Vui lòng tải file lên!", "info");
                return;
            }
            const btn = document.getElementById('btnFeedbackLoop');
            if (btn) {
                btn.innerHTML = `<i class="fa-solid fa-arrows-rotate fa-spin text-[#D991A4]"></i> <span>Đang Tái Thực Thi...</span>`;
            }
            fetchBackendPipeline();
            setTimeout(() => {
                if (btn) btn.innerHTML = `<i class="fa-solid fa-arrows-rotate text-[#D991A4]"></i> <span>Feedback Loop (Tái Thực Thi)</span>`;
            }, 800);
        }

        // Fetch Pipeline from Python Server
        async function fetchBackendPipeline(extraPayload = {}) {
            const gsheetInput = document.getElementById('landingGSheetUrl');
            const gsheetUrl = gsheetInput ? gsheetInput.value.trim() : "";

            const overrides = getDynamicHumanOverrides();
            const overheadMethod = (extraPayload && extraPayload.overhead_method) || getDynamicOverheadMethod();
            const multiTouchRule = getDynamicMultiTouchRule();

            const payload = {
                scenario: currentScenario,
                multi_touch_rule: multiTouchRule,
                overhead_method: overheadMethod,
                gsheet_url: gsheetUrl,
                file_base64: uploadedFileBase64,
                file_name: uploadedFileName,
                human_overrides: overrides,
                ...extraPayload
            };

            let data = null;

            try {
                const res = await fetch('/api/run_pipeline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const resText = await res.text();
                if (!res.ok) {
                    let errJson = {};
                    try { errJson = JSON.parse(resText); } catch {}
                    throw new Error(errJson.error || ('Lỗi máy chủ HTTP ' + res.status));
                }
                data = JSON.parse(resText);
            } catch (err) {
                console.error('Backend pipeline error:', err);
                let userMsg = err.message;
                if (err.message && err.message.includes('Failed to fetch')) {
                    userMsg = 'Đang kết nối lại máy chủ (Port 8050)... Vui lòng tải lại trang (Ctrl + F5).';
                } else if (err.message && err.message.includes('JSON')) {
                    userMsg = 'Tệp tải lên chứa giá trị trống hoặc định dạng chưa chuẩn. Vui lòng kiểm tra lại cột dữ liệu.';
                }
                showToast(`Thông báo hệ thống: ${userMsg}`, 'error');
                renderEmptyState();
                return;
            }

            lastApiResponse = data;

            if (data.status === 'AWAITING_INPUT' || !data.pnl_table || data.pnl_table.length === 0) {
                renderEmptyState();
            } else {
                renderDashboard(data);
            }
        }

        // Render Empty State (Chưa có dữ liệu - KHÔNG CÓ SỐ LIỆU MẪU)
        function renderEmptyState() {
            document.getElementById('kpiNetRev').innerText = "-- đ";
            document.getElementById('kpiReturnsSubtext').innerText = "Chờ tải tệp dữ liệu";
            document.getElementById('kpiOrdersCount').innerText = "0 đơn hàng";

            document.getElementById('kpiCM').innerText = "-- đ";
            document.getElementById('kpiProfitMarginPct').innerText = "--% CM";
            document.getElementById('kpiLeadingCampaign').innerText = "Chờ tính toán P&L";

            document.getElementById('kpiCosts').innerText = "-- đ";
            document.getElementById('kpiCampaignsCount').innerText = "Chờ phân bổ chi phí";

            document.getElementById('kpiExceptions').innerText = "--";
            document.getElementById('kpiExceptionsSubtext').innerText = "Chờ quét tệp ở Bước 2";
            document.getElementById('kpiHitlStatus').innerText = "Chờ dữ liệu";

            const sideBadge = document.getElementById('sideExceptionsBadge');
            if (sideBadge) sideBadge.classList.add('hidden');

            const headerLabel = document.getElementById('headerSourceLabel');
            if (headerLabel) headerLabel.innerText = "Chờ tải tệp dữ liệu...";

            // Stepper verify
            const badgeVerify = document.getElementById('badgeVerifyStatus');
            if (badgeVerify) {
                badgeVerify.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200";
                badgeVerify.innerHTML = `<i class="fa-solid fa-clock text-slate-400"></i> CHỜ TẢI DỮ LIỆU`;
            }

            // Cleaning Solutions container
            const solutionsEl = document.getElementById('cleaningSolutionsList');
            if (solutionsEl) {
                solutionsEl.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200 rounded-2xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-300 block mb-2"></i>
                        Chưa có tệp dữ liệu để rà soát lỗi. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1.
                    </div>
                `;
            }
            renderHumanControlPanel(null);

            // Cleaned Data Table Body & Pagination Reset
            currentCleanedRecords = [];
            isShowAllCleanedRows = false;
            const paginationBar = document.getElementById('cleanedDataPaginationBar');
            if (paginationBar) paginationBar.classList.add('hidden');
            const cleanedTbody = document.getElementById('cleanedDataTableBody');
            if (cleanedTbody) {
                cleanedTbody.innerHTML = `
                    <tr>
                        <td colspan="12" class="py-10 text-center text-slate-400 italic">
                            <i class="fa-solid fa-file-excel text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu làm sạch. Tải tệp ở Bước 1 để hiển thị dữ liệu mới tại đây.
                        </td>
                    </tr>
                `;
            }

            const errBadge = document.getElementById('detectedErrorsBadge');
            if (errBadge) errBadge.innerText = "0 Phát hiện";

            const countBadge = document.getElementById('badgeCleanedRecordsCount');
            if (countBadge) countBadge.innerText = "-- Đơn Hàng";

            const verifyBadge = document.getElementById('dataCleanVerificationBadge');
            if (verifyBadge) {
                verifyBadge.className = "px-3 py-1 rounded-full text-[11px] font-bold bg-[#F2E5E4] text-[#203833] border border-[#B8D9D3]";
                verifyBadge.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-[#75BFB2] mr-1"></i> Sẵn Sàng Kiểm Tra`;
            }

            const btnApprove = document.getElementById('btnApproveCleaning');
            if (btnApprove) {
                btnApprove.className = "btn-smooth px-5 py-2.5 bg-[#75BFB2] hover:bg-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-md shadow-[#75BFB2]/20 flex items-center gap-2 cursor-pointer shrink-0";
                btnApprove.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2] text-sm"></i> <span>ĐỒNG Ý VỚI CÁC HƯỚNG GIẢI QUYẾT LÀM SẠCH</span>`;
            }

            // P&L table
            document.getElementById('pnlTableBody').innerHTML = `
                <tr><td colspan="13" class="py-12 text-center text-slate-400 italic font-medium">
                    <i class="fa-solid fa-file-excel text-3xl text-slate-300 block mb-2"></i>
                    Chưa có số liệu. Khi bạn tải tệp dữ liệu lên, hệ thống sẽ tự động quét lỗi, tính P&L 13 chỉ số và hiển thị tại đây.
                </td></tr>
            `;

            // Top campaigns
            document.getElementById('topSellingCampaignsList').innerHTML = `
                <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">
                    Chờ tính toán P&L từ tệp...
                </div>
            `;

            // Recommendations
            document.getElementById('recommendationsGrid').innerHTML = `
                <div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center col-span-2 text-xs">
                    Chờ kết quả phân tích P&L để đưa ra khuyến nghị chiến lược điều hành.
                </div>
            `;

            // Gemini insights
            const geminiEl = document.getElementById('geminiInsightsContent');
            if (geminiEl) {
                geminiEl.innerText = "Hệ thống đang ở trạng thái chờ. Vui lòng tải tệp dữ liệu lên ở Bước 1 để AI Agent bắt đầu phân tích và đưa ra nhận định chiến lược.";
            }

            // Hide main 4 KPI cards when in empty state
            const mainKpis = document.getElementById('mainKpiCardsSection');
            if (mainKpis) mainKpis.classList.add('hidden');

            // Reset Financial KPIs Waterfall
            const resetTxt = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.innerText = val;
            };
            ['finGrossRev', 'finDiscount', 'finReturns', 'finNetRev', 'finCogs', 'finGrossProfit', 'finTotalCosts', 'finCM', 'finAov'].forEach(id => resetTxt(id, '-- đ'));
            ['finGrossMarginPct', 'finCmPct', 'finReturnRate', 'finRoi'].forEach(id => resetTxt(id, '(--%)'));
            resetTxt('finRoas', '--x');

            // Reset Problem Solution Matrix
            const probContainer = document.getElementById('problemSolutionMatrixContainer');
            if (probContainer) {
                probContainer.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center text-xs">
                        <i class="fa-solid fa-wand-magic-sparkles text-2xl text-slate-300 block mb-2"></i>
                        Đang chờ dữ liệu phân tích. Khi hoàn tất tính toán P&L, hệ thống sẽ tự động tổng hợp Ma trận Vấn đề & Giải pháp tại đây.
                    </div>
                `;
            }

            // Reset DataLens Studio Step 3 Metrics to 0 / Empty Placeholders
            const elTotalRows = document.getElementById('statTotalRows');
            if (elTotalRows) elTotalRows.innerText = '0';
            const elTotalCols = document.getElementById('statTotalCols');
            if (elTotalCols) elTotalCols.innerText = '0';
            const elNumCols = document.getElementById('statNumericCols');
            if (elNumCols) elNumCols.innerText = '0';

            const selectOpt = document.getElementById('datasetSelectOption');
            if (selectOpt) selectOpt.innerText = '-- Chưa tải tệp dữ liệu --';

            const sub = document.getElementById('ctxQaSubtitle');
            if (sub) sub.innerText = 'Chờ tải tệp dữ liệu...';

            const ctxQa = document.getElementById('contextualQaContainer');
            if (ctxQa) {
                ctxQa.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-300 block mb-2"></i>
                        Chưa có dữ liệu. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1 để AI tự động khám phá và trả lời các câu hỏi kinh doanh.
                    </div>
                `;
            }

            const grpSelectDim = document.getElementById('grpDimSelect');
            if (grpSelectDim) grpSelectDim.innerHTML = `<option value="">-- Chưa tải dữ liệu --</option>`;
            const grpSelectMetric = document.getElementById('grpMetricSelect');
            if (grpSelectMetric) grpSelectMetric.innerHTML = `<option value="">-- Chưa tải dữ liệu --</option>`;

            const grpBars = document.getElementById('groupBarsContainer');
            if (grpBars) {
                grpBars.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-chart-simple text-2xl text-slate-300 block mb-2"></i>
                        Chưa có dữ liệu. Vui lòng tải tệp để AI tự động tổng hợp và so sánh theo từng nhóm.
                    </div>
                `;
            }

            const grpSub = document.getElementById('grpSubtextCaption');
            if (grpSub) grpSub.innerText = 'Chưa có dữ liệu phân nhóm.';

            const grpInsights = document.getElementById('grpAutoInsightsList');
            if (grpInsights) {
                grpInsights.innerHTML = `
                    <div class="p-4 bg-slate-50/80 border border-slate-200/60 rounded-xl text-slate-400 italic text-center">
                        Chưa có nhận xét. AI sẽ tự động phân tích và đưa ra nhận xét chiến lược từ dữ liệu khi bạn tải tệp lên.
                    </div>
                `;
            }

            const aiSliceDeep = document.getElementById('aiSliceDeepInsightContainer');
            if (aiSliceDeep) aiSliceDeep.classList.add('hidden');

            const colTable = document.getElementById('columnProfilingTableBody');
            if (colTable) {
                colTable.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 text-center text-slate-400 italic">
                            <i class="fa-solid fa-table-columns text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu. Vui lòng tải tệp ở Bước 1 để AI nhận diện kiểu dữ liệu và thống kê chi tiết từng cột.
                        </td>
                    </tr>
                `;
            }

            // Reset Multi-angle Tables
            const resetTbody = (id, msg) => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = `<tr><td colspan="12" class="py-12 text-center text-slate-400 italic font-medium">${msg}</td></tr>`;
            };
            resetTbody('channelTableBody', '<i class="fa-solid fa-store text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu kênh bán hàng.');
            resetTbody('productTableBody', '<i class="fa-solid fa-box-open text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu danh mục sản phẩm.');
            resetTbody('timelineTableBody', '<i class="fa-solid fa-calendar-days text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu ngày tháng.');

            // Sales wave chart canvas
            if (salesWaveChartInstance) {
                salesWaveChartInstance.destroy();
                salesWaveChartInstance = null;
            }
            const canvas = document.getElementById('chartSalesWave');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }

            // Reset dynamic multi-chart overview
            activeDynamicChartInstances.forEach(chart => {
                try { if (chart) chart.destroy(); } catch(e) {}
            });
            activeDynamicChartInstances = [];

            const multiContainer = document.getElementById('multiChartOverviewContainer');
            if (multiContainer) {
                multiContainer.innerHTML = `
                    <div class="col-span-1 lg:col-span-2 p-12 bg-white rounded-3xl border border-slate-200/80 shadow-card text-center text-slate-400 italic text-xs space-y-2">
                        <i class="fa-solid fa-chart-pie text-3xl text-slate-300 block mb-1"></i>
                        <p class="font-bold text-slate-600 text-sm">Chưa có dữ liệu để vẽ biểu đồ đa chiều</p>
                        <p>Khi bạn tải tệp dữ liệu lên, AI sẽ tự động phân tích và kích hoạt toàn bộ các hướng phân tích trực quan phù hợp với dữ liệu thực tế.</p>
                    </div>
                `;
            }

            const tabsContainer = document.getElementById('analysisAngleTabs');
            if (tabsContainer) {
                tabsContainer.innerHTML = `
                    <button type="button" onclick="switchAnalysisAngle('OVERVIEW')" id="angleTab-OVERVIEW" class="angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl bg-white text-[#203833] font-extrabold shadow-xs cursor-pointer border border-slate-200 flex items-center gap-1.5">
                        <i class="fa-solid fa-table-cells-large text-[#75BFB2]"></i> Lưới Toàn Cảnh
                    </button>
                `;
            }

            const badgeText = document.getElementById('aiAngleBadgeText');
            if (badgeText) {
                badgeText.innerText = "AI: Tự động kích hoạt các góc nhìn phân tích phù hợp";
            }
        }

        // Render Dashboard Data (Khi có dữ liệu thực tế)
        function renderDashboard(data) {
            const kpis = data.summary_kpis || {};
            const sourceLabel = document.getElementById('headerSourceLabel');
            if (sourceLabel) {
                const nowStr = new Date().toLocaleTimeString('vi-VN');
                if (uploadedFileName) {
                    sourceLabel.innerHTML = `<span class="text-[#203833] font-extrabold">Tệp: ${uploadedFileName}</span> <span class="text-[11px] text-slate-400 font-normal">(${nowStr})</span>`;
                } else if (document.getElementById('landingGSheetUrl') && document.getElementById('landingGSheetUrl').value.trim()) {
                    sourceLabel.innerHTML = `<span class="text-[#203833] font-extrabold">Google Sheet trực tiếp</span> <span class="text-[11px] text-slate-400 font-normal">(${nowStr})</span>`;
                } else if (currentScenario) {
                    sourceLabel.innerHTML = `<span class="text-[#203833] font-extrabold">Kịch bản: ${currentScenario.toUpperCase()}</span> <span class="text-[11px] text-slate-400 font-normal">(${nowStr})</span>`;
                }
            }

            // Update Step 2: Cleaning Solutions & Cleaned Data Table
            const excs = data.exceptions_list || [];
            renderCleaningSolutions(excs);
            renderHumanControlPanel(data);
            renderCleanedDataTable(data.cleaned_orders_table || data.attributed_orders_sample || []);

            // KPI Cards Update
            const fin = data.financial_kpis || {};
            const netRevVal = (kpis.total_net_revenue !== undefined && kpis.total_net_revenue !== 0) ? kpis.total_net_revenue : (fin.total_net_revenue || 0);
            const cmVal = (kpis.total_contribution_margin !== undefined && kpis.total_contribution_margin !== 0) ? kpis.total_contribution_margin : (fin.total_contribution_margin || 0);
            const totalCosts = (fin.total_campaign_costs !== undefined) ? fin.total_campaign_costs : (data.pnl_table || []).reduce((acc, cur) => acc + (cur.total_cost || 0), 0);

            document.getElementById('kpiNetRev').innerText = formatVND(netRevVal);
            document.getElementById('kpiCM').innerText = formatVND(cmVal);
            document.getElementById('kpiCosts').innerText = formatVND(totalCosts);

            const exceptionsCount = (data.exceptions_list || []).length;
            document.getElementById('kpiExceptions').innerText = `${exceptionsCount} Ngoại lệ HITL`;

            // Update Card Subtexts & Details
            const ordersCount = fin.total_orders || kpis.total_orders || (data.attributed_orders_sample || []).length;
            const kpiOrdersCountEl = document.getElementById('kpiOrdersCount');
            if (kpiOrdersCountEl) {
                kpiOrdersCountEl.innerText = `${ordersCount} đơn hàng đối soát`;
            }

            const kpiReturnsSubtextEl = document.getElementById('kpiReturnsSubtext');
            if (kpiReturnsSubtextEl) {
                const retAmt = fin.total_return_amount || 0;
                kpiReturnsSubtextEl.innerText = retAmt > 0 ? `Đã trừ hoàn trả ${formatVND(retAmt)}` : `Không phát sinh hàng hoàn`;
            }

            const kpiProfitMarginPctEl = document.getElementById('kpiProfitMarginPct');
            if (kpiProfitMarginPctEl) {
                const cmPct = fin.cm_pct !== undefined ? fin.cm_pct : (netRevVal > 0 ? Math.round(cmVal / netRevVal * 1000) / 10 : 0);
                kpiProfitMarginPctEl.innerText = `${cmPct >= 0 ? '+' : ''}${cmPct}% CM`;
            }

            const kpiLeadingCampaignEl = document.getElementById('kpiLeadingCampaign');
            if (kpiLeadingCampaignEl) {
                const pnl = data.pnl_table || [];
                const best = [...pnl].sort((a,b) => (b.contribution_margin || 0) - (a.contribution_margin || 0))[0];
                if (best) {
                    kpiLeadingCampaignEl.innerText = `${best.campaign_name || best.campaign_id} dẫn đầu`;
                } else {
                    kpiLeadingCampaignEl.innerText = `Lợi nhuận thực tế sau chi phí`;
                }
            }

            const kpiCampaignsCountEl = document.getElementById('kpiCampaignsCount');
            if (kpiCampaignsCountEl) {
                const mktCount = (data.pnl_table || []).filter(p => p.campaign_id !== 'ORGANIC').length;
                if (mktCount > 0) {
                    kpiCampaignsCountEl.innerText = `${mktCount} Chiến dịch triển khai`;
                } else {
                    kpiCampaignsCountEl.innerText = `Bán hàng tự nhiên & Đa kênh`;
                }
            }

            const kpiHitlStatusEl = document.getElementById('kpiHitlStatus');
            if (kpiHitlStatusEl) {
                if (exceptionsCount > 0) {
                    kpiHitlStatusEl.innerText = `Sẵn sàng rà soát ở Bước 2`;
                } else {
                    kpiHitlStatusEl.innerText = `100% Chuẩn dữ liệu`;
                }
            }

            const sideExceptionsBadge = document.getElementById('sideExceptionsBadge');
            if (exceptionsCount > 0) {
                sideExceptionsBadge.innerText = exceptionsCount;
                sideExceptionsBadge.classList.remove('hidden');
            } else {
                sideExceptionsBadge.classList.add('hidden');
            }

            // Verify Status Badge
            const verify = data.verification_results || { is_ok: true };
            const badgeVerify = document.getElementById('badgeVerifyStatus');
            if (badgeVerify) {
                if (verify.is_ok) {
                    badgeVerify.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]";
                    badgeVerify.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2]"></i> VERIFY: OK`;
                } else {
                    badgeVerify.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#F2E5E4] text-[#872D43] border border-[#D991A4] animate-pulse";
                    badgeVerify.innerHTML = `<i class="fa-solid fa-triangle-exclamation text-[#D991A4]"></i> FEEDBACK CẦN THIẾT`;
                }
            }

            renderFinancialKpis(data.financial_kpis || {});
            renderContextualQA(data);
            renderDatasetMeta(data);
            setupDynamicGroupSelects(data);
            renderGroupComparison();
            renderColumnProfilingTable();
            renderChannelTable(data.channel_breakdown || []);
            renderProductTable(data.product_breakdown || []);
            renderTimelineTable(data.timeline_breakdown || []);
            renderProblemSolutionMatrix(data.problem_solution_matrix || []);

            const activeAngles = data.analysis_dimensions?.total_active_angles || 3;
            const aiBadgeText = document.getElementById('aiAngleBadgeText');
            if (aiBadgeText) {
                aiBadgeText.textContent = `AI: Tự động kích hoạt ${activeAngles} góc nhìn phân tích phù hợp`;
            } else {
                const aiBadge = document.getElementById('aiAngleBadge');
                if (aiBadge) {
                    aiBadge.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-[#203833] animate-pulse text-sm"></i> <span id="aiAngleBadgeText">AI: Tự động kích hoạt ${activeAngles} góc nhìn phân tích phù hợp</span> <span class="bg-[#203833] group-hover:bg-[#203833] text-white text-[10px] px-2.5 py-1 rounded-xl font-bold flex items-center gap-1.5 shadow-2xs"><i class="fa-solid fa-play text-[8px]"></i> <span>Chạy AI</span></span>`;
                }
            }
            const targetAngle = 'OVERVIEW';
            switchAnalysisAngle(targetAngle);
            
            renderPnLTable(data.pnl_table || []);
            renderTopSellingCampaigns(data.pnl_table || []);
            renderRecommendations(data.recommendations || []);

            const geminiEl = document.getElementById('geminiInsightsContent');
            if (geminiEl) {
                geminiEl.innerText = data.ai_executive_insights || "Đã phân tích toàn bộ P&L và ngoại lệ từ tệp tải lên.";
            }

            renderAuditTrail(data.audit_trail || []);
        }

        // Render Top Selling Campaigns
        function renderTopSellingCampaigns(rows) {
            const listContainer = document.getElementById('topSellingCampaignsList');
            if (!listContainer) return;
            let valid = rows.filter(r => r.campaign_id !== 'ORGANIC').sort((a,b) => b.contribution_margin - a.contribution_margin);
            if (!valid.length) {
                valid = [...rows].sort((a,b) => b.contribution_margin - a.contribution_margin);
            }
            
            if (!valid.length) {
                listContainer.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có dữ liệu chiến dịch.</div>`;
                return;
            }

            const icons = {
                'CT2_LOYAL': { icon: 'fa-medal', bg: 'bg-[#D9A3AC]/30 text-[#872D43]' },
                'CT3_COMBO': { icon: 'fa-utensils', bg: 'bg-[#B8D9D3]/40 text-[#203833]' },
                'CT1_FLASH': { icon: 'fa-bolt', bg: 'bg-[#D9A3AC]/30 text-[#872D43]' },
                'CT4_SMART': { icon: 'fa-robot', bg: 'bg-slate-100 text-slate-700' }
            };

            listContainer.innerHTML = valid.map(r => {
                const conf = icons[r.campaign_id] || { icon: 'fa-tag', bg: 'bg-[#B8D9D3]/40 text-[#203833]' };
                const isPositive = r.contribution_margin >= 0;
                return `
                <div class="flex items-center justify-between p-2 rounded-2xl hover:bg-slate-50 transition">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl ${conf.bg} flex items-center justify-center font-bold text-sm">
                            <i class="fa-solid ${conf.icon}"></i>
                        </div>
                        <div>
                            <div class="text-xs font-bold text-slate-900">${r.campaign_name}</div>
                            <div class="text-[10px] text-slate-400">${r.campaign_id} • ${r.orders_count} Đơn</div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-xs font-extrabold ${isPositive ? 'text-[#203833]' : 'text-[#D991A4]'}">${formatVND(r.contribution_margin)}</div>
                        <span class="text-[10px] font-bold ${isPositive ? 'bg-[#B8D9D3]/30 text-[#203833]' : 'bg-[#F2E5E4] text-[#872D43]'} px-2 py-0.5 rounded-full">${r.contribution_margin_pct}% CM</span>
                    </div>
                </div>
                `;
            }).join('');
        }

        // Render P&L Table (13 Financial Columns)
        
        // ===================================================================
        // THU HÀ MULTI-DIMENSIONAL ANALYSIS & FINANCIAL KPIS CONTROLLER
        // ===================================================================
        let currentAnalysisAngle = 'CAMPAIGN';

        function renderFinancialKpis(kpis) {
            if (!kpis) return;
            const setTxt = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.innerText = val;
            };

            setTxt('finGrossRev', formatVND(kpis.total_gross_revenue || 0));
            setTxt('finDiscount', formatVND(kpis.total_discount_amount || 0));
            setTxt('finReturns', formatVND(kpis.total_return_amount || 0));
            setTxt('finNetRev', formatVND(kpis.total_net_revenue || 0));
            setTxt('finCogs', formatVND(kpis.total_cogs || 0));
            setTxt('finGrossProfit', formatVND(kpis.total_gross_profit || 0));
            setTxt('finGrossMarginPct', `(${kpis.gross_margin_pct || 0}% biên gộp)`);
            setTxt('finTotalCosts', formatVND(kpis.total_campaign_costs || 0));
            setTxt('finCM', formatVND(kpis.total_contribution_margin || 0));
            setTxt('finCmPct', `(${kpis.cm_pct || 0}% CM)`);
            setTxt('finAov', formatVND(kpis.aov || 0));
            setTxt('finReturnRate', `${kpis.return_rate_pct || 0}%`);
            setTxt('finRoas', `${kpis.roas || 0}x`);
            setTxt('finRoi', `${kpis.roi_pct || 0}%`);
        }

        let activeDynamicChartInstances = [];

        function renderDynamicAiCharts(data) {
            if (!data) return;

            // 1. Destroy previous chart instances
            activeDynamicChartInstances.forEach(chart => {
                try { if (chart) chart.destroy(); } catch(e) {}
            });
            activeDynamicChartInstances = [];

            const multiContainer = document.getElementById('multiChartOverviewContainer');
            if (!multiContainer) return;

            // 2. Discover all populated, valid angles from dataset
            const activeAngles = [];

            // A. Omnichannel (Kênh bán)
            const channels = (data.channel_breakdown || []).filter(c => c && c.channel && c.channel !== 'Unknown');
            if (channels.length > 1) {
                activeAngles.push({
                    id: 'CHANNEL',
                    name: 'Theo Kênh Bán (Omnichannel)',
                    shortName: 'Kênh Bán',
                    icon: 'fa-solid fa-store text-[#75BFB2]',
                    badge: 'Phân Phối Đa Kênh',
                    title: 'Phân Phối Đa Kênh (Omnichannel)',
                    subtitle: 'So sánh Doanh thu gộp vs Doanh thu thuần vs Hàng hoàn giữa các kênh bán',
                    type: 'channel'
                });
            }

            // B. Product Pareto (Sản phẩm)
            const products = (data.product_breakdown || []).filter(p => p && p.product_id);
            if (products.length > 1) {
                activeAngles.push({
                    id: 'PRODUCT',
                    name: 'Theo Cơ Cấu Sản Phẩm (Pareto)',
                    shortName: 'Sản Phẩm',
                    icon: 'fa-solid fa-boxes-stacked text-[#D991A4]',
                    badge: 'Sản Phẩm Pareto',
                    title: 'Cơ Cấu Sản Phẩm Bán Chạy (Pareto 80/20)',
                    subtitle: 'Doanh thu gộp vs Lợi nhuận gộp của Top mặt hàng chủ lực',
                    type: 'product'
                });
            }

            // C. Region (Khu vực / Địa bàn)
            const regions = (data.region_breakdown || []).filter(r => r && r.region && r.region !== 'None');
            if (regions.length > 1) {
                activeAngles.push({
                    id: 'REGION',
                    name: 'Theo Khu Vực (Địa Bàn)',
                    shortName: 'Khu Vực',
                    icon: 'fa-solid fa-map-location-dot text-[#75BFB2]',
                    badge: 'Thị Phần Địa Bàn',
                    title: 'Phân Phối Thị Phần Theo Khu Vực',
                    subtitle: 'Tỷ trọng đóng góp doanh thu thuần & biên lợi nhuận giữa các vùng miền',
                    type: 'region'
                });
            }

            // D. Timeline (Xu hướng ngày / tháng)
            const timeline = (data.timeline_breakdown || []).filter(t => t && t.date);
            if (timeline.length > 1) {
                activeAngles.push({
                    id: 'TIMELINE',
                    name: 'Theo Dòng Thời Gian (Daily Trend)',
                    shortName: 'Thời Gian',
                    icon: 'fa-solid fa-calendar-days text-[#D991A4]',
                    badge: 'Dòng Thời Gian',
                    title: 'Xu Hướng Doanh Số & Số Lượng Đơn Theo Thời Gian',
                    subtitle: 'Đường cong phát sinh doanh thu thuần và nhịp độ giao dịch',
                    type: 'timeline'
                });
            }

            // E. Campaign P&L (Chiến dịch marketing)
            const campaigns = (data.pnl_table || []).filter(p => p && p.campaign_id !== 'ORGANIC');
            if (campaigns.length > 1) {
                activeAngles.push({
                    id: 'CAMPAIGN',
                    name: 'Theo Chiến Dịch (Campaign P&L)',
                    shortName: 'Chiến Dịch',
                    icon: 'fa-solid fa-bullhorn text-[#75BFB2]',
                    badge: 'Hiệu Quả P&L',
                    title: 'Hiệu Quả Chiến Dịch Marketing & Biên Đóng Góp (Sales Wave)',
                    subtitle: 'So sánh Doanh thu thuần vs Biên đóng góp CM giữa các chiến dịch',
                    type: 'campaign'
                });
            }

            // F. Cost Structure (Cơ cấu chi phí & Giá vốn)
            const kpis = data.financial_kpis || {};
            if ((kpis.total_cogs > 0 || kpis.total_discount_amount > 0 || kpis.total_campaign_costs > 0) && kpis.total_gross_revenue > 0) {
                activeAngles.push({
                    id: 'COST_STRUCTURE',
                    name: 'Cơ Cấu Chi Phí & Giá Vốn',
                    shortName: 'Chi Phí & COGS',
                    icon: 'fa-solid fa-chart-pie text-[#D991A4]',
                    badge: 'Cơ Cấu Chi Phí',
                    title: 'Cơ Cấu Chi Phí & Giá Vốn Toàn Diện (Waterfall P&L)',
                    subtitle: 'Tỷ trọng Giá vốn COGS, Chiết khấu Voucher, Chi phí MKT và Lợi nhuận',
                    type: 'cost'
                });
            }

            // G. Category (Ngành hàng / Danh mục)
            const categories = (data.category_breakdown || []).filter(c => c && c.category);
            if (categories.length > 1) {
                activeAngles.push({
                    id: 'CATEGORY',
                    name: 'Theo Ngành Hàng (Category)',
                    shortName: 'Ngành Hàng',
                    icon: 'fa-solid fa-layer-group text-teal-500',
                    badge: 'Ngành Hàng',
                    title: 'Phân Phối Doanh Số Theo Ngành Hàng / Danh Mục',
                    subtitle: 'Quy mô doanh thu thuần theo từng phân loại danh mục sản phẩm',
                    type: 'category'
                });
            }

            // 3. Update Dynamic Tabs in Header
            const tabsContainer = document.getElementById('analysisAngleTabs');
            if (tabsContainer) {
                if (activeAngles.length === 0) {
                    tabsContainer.innerHTML = `
                        <button type="button" onclick="switchAnalysisAngle('OVERVIEW')" id="angleTab-OVERVIEW" class="angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl bg-white text-[#203833] font-extrabold shadow-xs cursor-pointer border border-slate-200 flex items-center gap-1.5">
                            <i class="fa-solid fa-table-cells-large text-[#75BFB2]"></i> Lưới Toàn Cảnh
                        </button>
                    `;
                } else {
                    tabsContainer.innerHTML = `
                        <button type="button" onclick="switchAnalysisAngle('OVERVIEW')" id="angleTab-OVERVIEW" class="angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl ${currentAnalysisAngle === 'OVERVIEW' ? 'bg-white text-[#203833] font-extrabold shadow-xs border border-slate-200' : 'text-slate-600 hover:text-slate-900 font-bold'} flex items-center gap-1.5 cursor-pointer">
                            <i class="fa-solid fa-table-cells-large text-[#75BFB2]"></i> Tất Cả ${activeAngles.length} Biểu Đồ (Lưới Toàn Cảnh)
                        </button>
                        ${activeAngles.map(a => `
                            <button type="button" onclick="switchAnalysisAngle('${a.id}')" id="angleTab-${a.id}" class="angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl ${currentAnalysisAngle === a.id ? 'bg-white text-[#203833] font-extrabold shadow-xs border border-slate-200' : 'text-slate-600 hover:text-slate-900 font-bold'} flex items-center gap-1.5 cursor-pointer">
                                <i class="${a.icon}"></i> <span>${a.name}</span>
                            </button>
                        `).join('')}
                    `;
                }
            }

            // 4. Update Badge Text
            const badgeText = document.getElementById('aiAngleBadgeText');
            if (badgeText) {
                badgeText.innerText = `AI: Tự động kích hoạt ${activeAngles.length} góc nhìn phân tích phù hợp`;
            }

            // 5. Render Container Content
            if (activeAngles.length === 0) {
                multiContainer.innerHTML = `
                    <div class="col-span-1 lg:col-span-2 p-12 bg-white rounded-3xl border border-slate-200/80 shadow-card text-center text-slate-400 italic text-xs space-y-2">
                        <i class="fa-solid fa-chart-pie text-3xl text-slate-300 block mb-1"></i>
                        <p class="font-bold text-slate-600 text-sm">Chưa có dữ liệu để vẽ biểu đồ đa chiều</p>
                        <p>Khi bạn tải tệp dữ liệu lên, AI sẽ tự động phân tích và kích hoạt toàn bộ các hướng phân tích trực quan phù hợp với dữ liệu thực tế.</p>
                    </div>
                `;
                return;
            }

            // Render active chart cards - ONLY ACTIVE CARDS, ZERO EMPTY CANVASES!
            multiContainer.innerHTML = activeAngles.map((a, idx) => `
                <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card p-5 flex flex-col justify-between hover:shadow-md transition">
                    <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-100">
                        <div>
                            <h4 class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                                <i class="${a.icon}"></i> ${idx + 1}. ${a.title}
                            </h4>
                            <p class="text-[10px] text-slate-400 font-medium">${a.subtitle}</p>
                        </div>
                        <span class="text-[10px] font-bold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200 shrink-0">
                            ${a.badge}
                        </span>
                    </div>
                    <div class="h-60 relative w-full flex items-center justify-center">
                        <canvas id="dynChartCanvas_${a.id}" class="w-full h-full"></canvas>
                    </div>
                </div>
            `).join('');

            // 6. Draw Charts for each active angle
            activeAngles.forEach(a => {
                const canvas = document.getElementById(`dynChartCanvas_${a.id}`);
                if (!canvas) return;
                const ctx = canvas.getContext('2d');

                let chart = null;
                if (a.type === 'channel') {
                    chart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: channels.map(c => c.channel),
                            datasets: [
                                { label: 'Doanh Thu Gộp (Tr. đ)', data: channels.map(c => (c.gross_revenue || 0) / 1e6), backgroundColor: '#75BFB2', borderRadius: 6 },
                                { label: 'Hàng Hoàn (Tr. đ)', data: channels.map(c => (c.return_amount || 0) / 1e6), backgroundColor: '#D991A4', borderRadius: 6 },
                                { label: 'Doanh Thu Thuần (Tr. đ)', data: channels.map(c => (c.net_revenue || 0) / 1e6), backgroundColor: '#B8D9D3', borderRadius: 6 }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } } },
                            scales: {
                                x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } }, grid: { display: false } },
                                y: { ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                            }
                        }
                    });
                } else if (a.type === 'product') {
                    const topProds = products.slice(0, 6);
                    chart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: topProds.map(p => `${p.product_id} (${p.quantity_sold} SP)`),
                            datasets: [
                                { label: 'Doanh Thu Gộp (Tr. đ)', data: topProds.map(p => (p.gross_revenue || 0) / 1e6), backgroundColor: '#75BFB2', borderRadius: 6 },
                                { label: 'Lợi Nhuận Gộp (Tr. đ)', data: topProds.map(p => (p.gross_profit || 0) / 1e6), backgroundColor: '#D991A4', borderRadius: 6 }
                            ]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } } },
                            scales: {
                                x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } },
                                y: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } }, grid: { display: false } }
                            }
                        }
                    });
                } else if (a.type === 'region') {
                    chart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: regions.map(r => `${r.region} (${r.revenue_share_pct}%)`),
                            datasets: [{
                                data: regions.map(r => (r.net_revenue || 0) / 1e6),
                                backgroundColor: [
                                    '#75BFB2',
                                    '#D991A4',
                                    '#B8D9D3',
                                    '#D9A3AC',
                                    '#203833'
                                ],
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'right', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                            }
                        }
                    });
                } else if (a.type === 'timeline') {
                    chart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: timeline.map(t => t.date),
                            datasets: [
                                {
                                    label: 'Doanh Thu Thuần (Tr. đ)',
                                    data: timeline.map(t => (t.net_revenue || 0) / 1e6),
                                    borderColor: '#75BFB2',
                                    backgroundColor: 'rgba(117, 191, 178, 0.35)',
                                    borderWidth: 2.5,
                                    fill: true,
                                    tension: 0.35,
                                    pointRadius: 3,
                                    pointBackgroundColor: '#75BFB2',
                                    yAxisID: 'y'
                                },
                                {
                                    label: 'Số Lượng Đơn',
                                    data: timeline.map(t => t.orders_count || 0),
                                    borderColor: '#D991A4',
                                    backgroundColor: 'rgba(217, 145, 164, 0.45)',
                                    borderWidth: 2,
                                    borderDash: [3, 3],
                                    pointRadius: 3,
                                    pointBackgroundColor: '#D991A4',
                                    yAxisID: 'y1'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } } },
                            scales: {
                                x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 9 } }, grid: { display: false } },
                                y: { position: 'left', ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } },
                                y1: { position: 'right', ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, stepSize: 1 }, grid: { display: false } }
                            }
                        }
                    });
                } else if (a.type === 'campaign') {
                    chart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: campaigns.map(x => x.campaign_name),
                            datasets: [
                                {
                                    label: 'Doanh Thu Thuần (Tr. đ)',
                                    data: campaigns.map(x => (x.net_revenue || 0) / 1e6),
                                    borderColor: '#75BFB2',
                                    backgroundColor: 'rgba(117, 191, 178, 0.35)',
                                    borderWidth: 2.5,
                                    fill: true,
                                    tension: 0.35,
                                    pointRadius: 4,
                                    pointBackgroundColor: '#75BFB2'
                                },
                                {
                                    label: 'Biên Đóng Góp CM (Tr. đ)',
                                    data: campaigns.map(x => (x.contribution_margin || 0) / 1e6),
                                    borderColor: '#D991A4',
                                    backgroundColor: 'rgba(217, 145, 164, 0.45)',
                                    borderWidth: 2.5,
                                    fill: true,
                                    tension: 0.35,
                                    pointRadius: 4,
                                    pointBackgroundColor: '#D991A4'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } } },
                            scales: {
                                x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } }, grid: { display: false } },
                                y: { ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                            }
                        }
                    });
                } else if (a.type === 'cost') {
                    const costLabels = [];
                    const costVals = [];
                    const costColors = [];

                    if (kpis.total_cogs > 0) {
                        costLabels.push('Giá Vốn (COGS)');
                        costVals.push(kpis.total_cogs / 1e6);
                        costColors.push('#D9A3AC');
                    }
                    if (kpis.total_discount_amount > 0) {
                        costLabels.push('Chiết Khấu Voucher');
                        costVals.push(kpis.total_discount_amount / 1e6);
                        costColors.push('#D991A4');
                    }
                    if (kpis.total_campaign_costs > 0) {
                        costLabels.push('Chi Phí Marketing');
                        costVals.push(kpis.total_campaign_costs / 1e6);
                        costColors.push('#B8D9D3');
                    }
                    if (kpis.total_contribution_margin > 0) {
                        costLabels.push('Biên Đóng Góp (CM)');
                        costVals.push(kpis.total_contribution_margin / 1e6);
                        costColors.push('#75BFB2');
                    }

                    chart = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: costLabels,
                            datasets: [{
                                data: costVals,
                                backgroundColor: costColors,
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'right', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } }
                            }
                        }
                    });
                } else if (a.type === 'category') {
                    chart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: categories.map(c => c.category),
                            datasets: [
                                { label: 'Doanh Thu Thuần (Tr. đ)', data: categories.map(c => (c.net_revenue || 0) / 1e6), backgroundColor: '#75BFB2', borderRadius: 6 }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } } } },
                            scales: {
                                x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } }, grid: { display: false } },
                                y: { ticks: { font: { family: 'Plus Jakarta Sans', size: 9 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                            }
                        }
                    });
                }

                if (chart) {
                    activeDynamicChartInstances.push(chart);
                }
            });
        }

        // Backward compatibility alias
        function renderWebOverviewCharts(data) {
            renderDynamicAiCharts(data);
        }

        function switchAnalysisAngle(angle) {
            currentAnalysisAngle = angle;

            // 1. Update Tabs Active Styling
            document.querySelectorAll('.angle-tab-btn').forEach(btn => {
                btn.className = "angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 font-bold cursor-pointer flex items-center gap-1.5";
            });
            const activeBtn = document.getElementById(`angleTab-${angle}`);
            if (activeBtn) {
                activeBtn.className = "angle-tab-btn btn-smooth px-3.5 py-1.5 rounded-xl bg-white text-[#203833] font-extrabold shadow-xs cursor-pointer border border-slate-200 flex items-center gap-1.5";
            }

            const multiContainer = document.getElementById('multiChartOverviewContainer');
            const singleContainer = document.getElementById('singleAngleChartContainer');

            if (angle === 'OVERVIEW') {
                if (multiContainer) multiContainer.classList.remove('hidden');
                if (singleContainer) singleContainer.classList.add('hidden');
                if (lastApiResponse) {
                    renderDynamicAiCharts(lastApiResponse);
                }
            } else {
                if (multiContainer) multiContainer.classList.add('hidden');
                if (singleContainer) singleContainer.classList.remove('hidden');

                // 2. Update Dynamic Chart Title & Subtitle for Single Angle
                const chartTitle = document.getElementById('chartDynamicTitle');
                const chartSub = document.getElementById('chartDynamicSubtitle');
                const chartBadge = document.getElementById('chartViewBadge');
                const rankTitle = document.getElementById('rankingDynamicTitle');
                const rankSub = document.getElementById('rankingDynamicSub');

                if (angle === 'CAMPAIGN') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-bullhorn text-[#203833]"></i> Diễn Biến Doanh Thu & Biên Đóng Góp Theo Chiến Dịch`;
                    if (chartSub) chartSub.innerText = "So sánh Doanh thu thuần vs Lợi nhuận đóng góp (CM) giữa các chiến dịch";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Chiến Dịch";
                    if (rankTitle) rankTitle.innerText = "Chiến Dịch Hàng Đầu";
                    if (rankSub) rankSub.innerText = "Rank by CM";
                    if (lastApiResponse) renderTopSellingCampaigns(lastApiResponse.pnl_table || []);
                } else if (angle === 'CHANNEL') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-store text-[#203833]"></i> Đối Soát Doanh Số, Hàng Hoàn & Lợi Nhuận Đa Kênh`;
                    if (chartSub) chartSub.innerText = "So sánh hiệu quả phân phối giữa Kênh Trực Tuyến (Online) vs Kênh Cửa Hàng (Offline)";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Đa Kênh";
                    if (rankTitle) rankTitle.innerText = "Tỷ Trọng Kênh Bán";
                    if (rankSub) rankSub.innerText = "Rank by Net Rev";
                    renderTopChannelRankings(lastApiResponse?.channel_breakdown || []);
                } else if (angle === 'PRODUCT') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-box-open text-[#872D43]"></i> Cơ Cấu Doanh Số & Biên Lãi Gộp Sản Phẩm (Pareto 80/20)`;
                    if (chartSub) chartSub.innerText = "Top sản phẩm mang lại doanh số lớn nhất và kiểm soát biên lợi nhuận gộp";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Sản Phẩm";
                    if (rankTitle) rankTitle.innerText = "Top Sản Phẩm Bán Chạy";
                    if (rankSub) rankSub.innerText = "Rank by Revenue";
                    renderTopProductRankings(lastApiResponse?.product_breakdown || []);
                } else if (angle === 'REGION') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-map-location-dot text-[#203833]"></i> Phân Phối Thị Phần Theo Khu Vực & Địa Bàn`;
                    if (chartSub) chartSub.innerText = "Tỷ trọng đóng góp doanh thu và lợi nhuận giữa các vùng miền";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Khu Vực";
                    if (rankTitle) rankTitle.innerText = "Xếp Hạng Khu Vực";
                    if (rankSub) rankSub.innerText = "Rank by Revenue";
                    renderTopRegionRankings(lastApiResponse?.region_breakdown || []);
                } else if (angle === 'TIMELINE') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-calendar-days text-[#872D43]"></i> Diễn Biến Doanh Thu Theo Chu Kỳ Thời Gian`;
                    if (chartSub) chartSub.innerText = "Đường xu hướng doanh số phát sinh theo từng mốc thời gian giao dịch";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Thời Gian";
                    if (rankTitle) rankTitle.innerText = "Ngày Bán Đỉnh Điểm";
                    if (rankSub) rankSub.innerText = "Rank by Daily Sales";
                    renderTopTimelineRankings(lastApiResponse?.timeline_breakdown || []);
                } else if (angle === 'COST_STRUCTURE') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-chart-pie text-[#D991A4]"></i> Phân Tích Dòng Chảy Chi Phí & Lợi Nhuận (Waterfall)`;
                    if (chartSub) chartSub.innerText = "Tỷ trọng Giá vốn COGS, Chiết khấu, Chi phí Marketing và Biên đóng góp";
                    if (chartBadge) chartBadge.innerText = "Cơ Cấu Chi Phí";
                    if (rankTitle) rankTitle.innerText = "Khoản Mục Chi Phí";
                    if (rankSub) rankSub.innerText = "Cost Breakdown";
                    renderTopCostRankings(lastApiResponse?.financial_kpis || {});
                } else if (angle === 'CATEGORY') {
                    if (chartTitle) chartTitle.innerHTML = `<i class="fa-solid fa-layer-group text-teal-600"></i> Phân Bổ Doanh Số Theo Ngành Hàng`;
                    if (chartSub) chartSub.innerText = "Quy mô doanh thu thuần theo từng phân loại danh mục sản phẩm";
                    if (chartBadge) chartBadge.innerText = "Góc Nhìn Ngành Hàng";
                    if (rankTitle) rankTitle.innerText = "Top Ngành Hàng";
                    if (rankSub) rankSub.innerText = "Rank by Revenue";
                    renderTopCategoryRankings(lastApiResponse?.category_breakdown || []);
                }

                // 3. Render Chart for Selected Single Angle
                if (lastApiResponse) {
                    renderSalesWaveChart(lastApiResponse, angle);
                }
            }
        }

        function renderTopRegionRankings(regions) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            if (!regions || !regions.length) {
                list.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có số liệu khu vực.</div>`;
                return;
            }
            list.innerHTML = regions.map(r => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition hover:border-[#75BFB2]">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center text-xs font-black">
                                <i class="fa-solid fa-map-pin text-[10px]"></i>
                            </span>
                            <span class="font-extrabold text-xs text-slate-900">${r.region}</span>
                        </div>
                        <span class="font-mono text-xs font-bold text-[#203833]">${formatVND(r.net_revenue)}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                        <span>${r.orders_count} đơn hàng</span>
                        <span class="text-[#203833] font-bold">${r.revenue_share_pct}% thị phần</span>
                    </div>
                </div>
            `).join('');
        }

        function renderTopCostRankings(kpis) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            const items = [
                { name: 'Giá vốn (COGS)', val: kpis.total_cogs || 0, color: 'text-[#D991A4]', icon: 'fa-boxes-stacked' },
                { name: 'Chiết khấu Voucher', val: kpis.total_discount_amount || 0, color: 'text-[#872D43]', icon: 'fa-tag' },
                { name: 'Chi phí Marketing', val: kpis.total_campaign_costs || 0, color: 'text-[#872D43]', icon: 'fa-bullhorn' },
                { name: 'Biên đóng góp (CM)', val: kpis.total_contribution_margin || 0, color: 'text-[#203833]', icon: 'fa-sack-dollar' }
            ];
            list.innerHTML = items.map(item => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-slate-200 text-slate-700 flex items-center justify-center text-xs font-black">
                                <i class="fa-solid ${item.icon} text-[10px]"></i>
                            </span>
                            <span class="font-extrabold text-xs text-slate-900">${item.name}</span>
                        </div>
                        <span class="font-mono text-xs font-bold ${item.color}">${formatVND(item.val)}</span>
                    </div>
                </div>
            `).join('');
        }

        function renderTopCategoryRankings(categories) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            if (!categories || !categories.length) {
                list.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có số liệu ngành hàng.</div>`;
                return;
            }
            list.innerHTML = categories.map(c => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition hover:border-teal-300">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-teal-100 text-teal-800 flex items-center justify-center text-xs font-black">
                                <i class="fa-solid fa-layer-group text-[10px]"></i>
                            </span>
                            <span class="font-extrabold text-xs text-slate-900">${c.category}</span>
                        </div>
                        <span class="font-mono text-xs font-bold text-teal-700">${formatVND(c.net_revenue)}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                        <span>${c.orders_count} đơn hàng</span>
                        <span class="text-teal-700 font-bold">${c.revenue_share_pct}%</span>
                    </div>
                </div>
            `).join('');
        }

        function renderTopChannelRankings(channels) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            if (!channels || !channels.length) {
                list.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có số liệu kênh bán.</div>`;
                return;
            }
            list.innerHTML = channels.map(c => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition hover:border-[#75BFB2]">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg ${c.channel === 'Online' ? 'bg-[#B8D9D3]/40 text-[#203833]' : 'bg-[#D9A3AC]/30 text-[#872D43]'} flex items-center justify-center text-xs font-black">
                                <i class="fa-solid ${c.channel === 'Online' ? 'fa-globe' : 'fa-shop'} text-[10px]"></i>
                            </span>
                            <span class="font-extrabold text-xs text-slate-900">${c.channel}</span>
                        </div>
                        <span class="font-mono text-xs font-bold text-[#203833]">${formatVND(c.net_revenue)}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                        <span>${c.orders_count} đơn hàng • Hoàn ${c.return_rate_pct}%</span>
                        <span class="text-[#203833] font-bold">CM: ${c.cm_pct}%</span>
                    </div>
                </div>
            `).join('');
        }

        function renderTopProductRankings(products) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            if (!products || !products.length) {
                list.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có số liệu sản phẩm.</div>`;
                return;
            }
            list.innerHTML = products.slice(0, 4).map((p, idx) => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition hover:border-[#D991A4]">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center text-xs font-black">#${idx + 1}</span>
                            <div>
                                <span class="font-extrabold text-xs text-slate-900">${p.product_id}</span>
                                <span class="text-[10px] text-slate-400 block">${p.product_name}</span>
                            </div>
                        </div>
                        <span class="font-mono text-xs font-bold text-[#872D43]">${formatVND(p.gross_revenue)}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                        <span>Đã bán: ${p.quantity_sold} SP</span>
                        <span class="text-[#203833] font-bold">Lãi gộp: ${p.gross_margin_pct}%</span>
                    </div>
                </div>
            `).join('');
        }

        function renderTopTimelineRankings(timeline) {
            const list = document.getElementById('topSellingCampaignsList');
            if (!list) return;
            if (!timeline || !timeline.length) {
                list.innerHTML = `<div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 text-center text-slate-400 italic text-xs">Chưa có số liệu thời gian.</div>`;
                return;
            }
            const sorted = [...timeline].sort((a, b) => b.net_revenue - a.net_revenue).slice(0, 4);
            list.innerHTML = sorted.map((t, idx) => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200/70 space-y-1.5 transition hover:border-[#D991A4]">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-[#D9A3AC]/30 text-[#872D43] flex items-center justify-center text-xs font-black">#${idx + 1}</span>
                            <span class="font-mono font-bold text-xs text-slate-900">${t.date}</span>
                        </div>
                        <span class="font-mono text-xs font-bold text-[#872D43]">${formatVND(t.net_revenue)}</span>
                    </div>
                    <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                        <span>Số đơn: ${t.orders_count}</span>
                        <span class="text-slate-600">Gộp: ${formatVND(t.gross_revenue)}</span>
                    </div>
                </div>
            `).join('');
        }

        function renderChannelTable(channels) {
            const tbody = document.getElementById('channelTableBody');
            if (!tbody) return;
            if (!channels || !channels.length) {
                tbody.innerHTML = `<tr><td colspan="11" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-store text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu kênh bán hàng.</td></tr>`;
                return;
            }
            tbody.innerHTML = channels.map(c => `
                <tr class="hover:bg-[#B8D9D3]/30/40 transition group border-b border-slate-100 text-xs">
                    <td class="py-3 px-3 font-bold text-slate-900 flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full ${c.channel === 'Online' ? 'bg-[#75BFB2]' : 'bg-[#D991A4]'}"></span>
                        <span>${c.channel}</span>
                    </td>
                    <td class="py-3 px-3 text-center font-bold font-mono">${c.orders_count}</td>
                    <td class="py-3 px-3 text-right font-mono text-slate-700">${formatVND(c.gross_revenue)}</td>
                    <td class="py-3 px-3 text-right font-mono text-[#D991A4]">${formatVND(c.discount_amount)}</td>
                    <td class="py-3 px-3 text-right font-mono text-[#872D43]">${formatVND(c.return_amount)}</td>
                    <td class="py-3 px-3 text-center font-mono ${c.return_rate_pct > 15 ? 'text-[#D991A4] font-bold' : 'text-slate-600'}">${c.return_rate_pct}%</td>
                    <td class="py-3 px-3 text-right font-bold font-mono text-[#203833]">${formatVND(c.net_revenue)}</td>
                    <td class="py-3 px-3 text-right font-mono text-slate-600">${formatVND(c.cogs)}</td>
                    <td class="py-3 px-3 text-right font-mono font-bold text-[#203833]">${formatVND(c.gross_profit)}</td>
                    <td class="py-3 px-3 text-right font-mono font-bold ${c.contribution_margin >= 0 ? 'text-[#203833]' : 'text-[#872D43]'}">${formatVND(c.contribution_margin)}</td>
                    <td class="py-3 px-3 text-center font-bold text-slate-700">${c.revenue_share_pct}%</td>
                </tr>
            `).join('');
        }

        function renderProductTable(products) {
            const tbody = document.getElementById('productTableBody');
            if (!tbody) return;
            if (!products || !products.length) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-box-open text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu danh mục sản phẩm.</td></tr>`;
                return;
            }
            tbody.innerHTML = products.map((p, idx) => `
                <tr class="hover:bg-[#F2E5E4]/40 transition group border-b border-slate-100 text-xs">
                    <td class="py-3 px-3 text-center font-bold text-slate-400 font-mono">#${idx + 1}</td>
                    <td class="py-3 px-3 font-mono font-bold text-slate-900">${p.product_id}</td>
                    <td class="py-3 px-3 font-semibold text-slate-800">${p.product_name}</td>
                    <td class="py-3 px-3 text-center font-mono font-bold text-slate-900">${p.quantity_sold}</td>
                    <td class="py-3 px-3 text-right font-mono text-slate-700">${formatVND(p.gross_revenue)}</td>
                    <td class="py-3 px-3 text-right font-mono text-slate-600">${formatVND(p.cogs)}</td>
                    <td class="py-3 px-3 text-right font-mono font-bold text-[#872D43]">${formatVND(p.gross_profit)}</td>
                    <td class="py-3 px-3 text-center font-mono font-bold ${p.gross_margin_pct >= 45 ? 'text-[#203833]' : 'text-[#872D43]'}">${p.gross_margin_pct}%</td>
                    <td class="py-3 px-3 text-center font-bold text-slate-700">${p.revenue_share_pct}%</td>
                </tr>
            `).join('');
        }

        function renderTimelineTable(timeline) {
            const tbody = document.getElementById('timelineTableBody');
            if (!tbody) return;
            if (!timeline || !timeline.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-calendar-days text-3xl text-slate-300 block mb-2"></i>Chưa có dữ liệu ngày tháng.</td></tr>`;
                return;
            }
            tbody.innerHTML = timeline.map(t => {
                const aov = t.orders_count > 0 ? (t.net_revenue / t.orders_count) : 0;
                return `
                    <tr class="hover:bg-[#F2E5E4]/40 transition group border-b border-slate-100 text-xs">
                        <td class="py-3 px-3 font-mono font-bold text-slate-900">${t.date}</td>
                        <td class="py-3 px-3 text-center font-mono font-bold text-slate-900">${t.orders_count}</td>
                        <td class="py-3 px-3 text-right font-mono text-slate-700">${formatVND(t.gross_revenue)}</td>
                        <td class="py-3 px-3 text-right font-mono text-[#D991A4]">${formatVND(t.discount_amount)}</td>
                        <td class="py-3 px-3 text-right font-mono font-bold text-[#203833]">${formatVND(t.net_revenue)}</td>
                        <td class="py-3 px-3 text-right font-mono text-slate-600">${formatVND(aov)}</td>
                    </tr>
                `;
            }).join('');
        }

        // Render Executive Problem & Solution Matrix
        function renderProblemSolutionMatrix(matrix) {
            const container = document.getElementById('problemSolutionMatrixContainer');
            if (!container) return;
            if (!matrix || !matrix.length) {
                container.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center text-xs">
                        <i class="fa-solid fa-circle-check text-2xl text-[#75BFB2] block mb-2"></i>
                        Dữ liệu đạt chuẩn tối ưu hoàn hảo. Không ghi nhận vấn đề thâm hụt tài chính cần xử lý.
                    </div>
                `;
                return;
            }

            const step4Summary = document.getElementById('step4ProblemSolutionSummary');
            if (step4Summary) {
                step4Summary.innerHTML = matrix.map((item, idx) => `
                    <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center text-xs font-bold">#${idx+1}</span>
                                <strong class="text-xs text-slate-900">${item.title}</strong>
                            </div>
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white border border-slate-200 text-slate-700">${item.severity}</span>
                        </div>
                        <p class="text-xs text-slate-600"><strong>Thực trạng & Bằng chứng:</strong> ${item.problem} (${item.evidence})</p>
                        <div class="text-xs text-[#203833] font-semibold bg-[#B8D9D3]/30 p-2.5 rounded-xl border border-[#B8D9D3]">
                            <strong>Khuyến nghị hành động:</strong> ${item.urgent_solution || item.medium_solution} • <span class="text-[#203833]">Kỳ vọng: ${item.expected_impact}</span>
                        </div>
                    </div>
                `).join('');
            }

            container.innerHTML = matrix.map((item, idx) => {
                let badgeClass = "bg-[#D9A3AC]/30 text-[#872D43] border-[#D991A4]";
                let iconClass = "fa-triangle-exclamation text-[#D991A4]";
                if (item.severity === 'WARNING') {
                    badgeClass = "bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]";
                    iconClass = "fa-circle-exclamation text-[#872D43]";
                } else if (item.severity === 'OPPORTUNITY') {
                    badgeClass = "bg-[#B8D9D3]/40 text-[#203833] border-[#B8D9D3]";
                    iconClass = "fa-boxes-stacked text-[#203833]";
                } else if (item.severity === 'STRATEGIC') {
                    badgeClass = "bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]";
                    iconClass = "fa-brain text-[#872D43]";
                }

                return `
                <div class="p-5 bg-slate-50/90 border border-slate-200 rounded-2xl space-y-3.5 transition hover:border-[#B8D9D3] shadow-2xs">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                        <div class="flex items-center gap-2.5">
                            <span class="w-7 h-7 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center text-xs font-black shadow-2xs">${idx + 1}</span>
                            <div>
                                <h4 class="font-extrabold text-xs sm:text-sm text-slate-900 flex items-center gap-2">
                                    <span>${item.title}</span>
                                </h4>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-md ${badgeClass} border inline-block mt-0.5">${item.severity}</span>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-white text-slate-700 border border-slate-200 shadow-2xs">
                            <i class="fa-solid fa-id-badge text-[#75BFB2] mr-1"></i> ${item.id}
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                        <!-- Cột 1: Vấn Đề & Bằng Chứng Số Liệu -->
                        <div class="bg-white p-3.5 rounded-xl border border-slate-200/80 space-y-2">
                            <span class="text-[11px] font-extrabold text-slate-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-magnifying-glass text-[#D991A4]"></i> Vấn Đề Phát Hiện & Minh Chứng Số Liệu:
                            </span>
                            <p class="text-slate-800 font-semibold leading-relaxed">${item.problem}</p>
                            <div class="p-2.5 bg-[#F2E5E4]/60 rounded-lg border border-rose-100 text-[11px] text-[#872D43] font-medium">
                                <i class="fa-solid fa-chart-column mr-1 text-[#D991A4]"></i>
                                <span><strong>Dữ liệu:</strong> ${item.evidence}</span>
                            </div>
                            <div class="pt-1 text-[11px] text-slate-500 font-medium">
                                <span class="font-bold text-slate-700">Nguyên nhân cốt lõi:</span> ${item.root_cause}
                            </div>
                        </div>

                        <!-- Cột 2: Bộ Giải Pháp & Lộ Trình Hành Động -->
                        <div class="bg-[#B8D9D3]/40 p-3.5 rounded-xl border border-[#B8D9D3]/90 space-y-2.5">
                            <span class="text-[11px] font-black text-[#203833] flex items-center gap-1.5">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#203833]"></i> Bộ Giải Pháp Thực Thi Chi Tiết:
                            </span>

                            <div class="space-y-1.5 text-xs text-[#203833] font-medium">
                                <div class="flex items-start gap-1.5">
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-[#D991A4] text-white shrink-0 mt-0.5">24H</span>
                                    <span><strong>Khẩn cấp:</strong> ${item.urgent_solution || item.solutions?.urgent_actions?.[0] || 'Tạm dừng ngay ngân sách lãng phí.'}</span>
                                </div>
                                <div class="flex items-start gap-1.5">
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-[#D991A4] text-white shrink-0 mt-0.5">1-2W</span>
                                    <span><strong>Tối ưu hóa:</strong> ${item.medium_solution || item.solutions?.medium_term?.[0] || 'Cơ cấu lại chính sách chiết khấu và kênh bán.'}</span>
                                </div>
                                <div class="flex items-start gap-1.5">
                                    <span class="px-1.5 py-0.5 rounded text-[9px] font-black bg-[#203833] text-white shrink-0 mt-0.5">A/B</span>
                                    <span><strong>Chiến lược:</strong> ${item.strategic_solution || item.solutions?.strategic?.[0] || 'Thử nghiệm nhóm đối chứng chứng minh Causal Uplift.'}</span>
                                </div>
                            </div>

                            <div class="pt-2 border-t border-[#B8D9D3]/70 flex items-center gap-1.5 text-[11px] text-[#203833] font-extrabold">
                                <i class="fa-solid fa-circle-check text-[#203833]"></i>
                                <span>Kỳ vọng tác động: ${item.expected_impact}</span>
                            </div>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }


        function renderPnLTable(rows) {
            const tbody = document.getElementById('pnlTableBody');
            if (!rows.length) {
                tbody.innerHTML = `<tr><td colspan="13" class="py-12 text-center text-slate-400 italic font-medium"><i class="fa-solid fa-file-excel text-3xl text-slate-300 block mb-2"></i>Chưa có số liệu. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1.</td></tr>`;
                return;
            }

            tbody.innerHTML = rows.map(r => `
                <tr class="hover:bg-[#F2E5E4]/40 transition group border-b border-slate-100">
                    <td class="py-3 px-3 font-bold text-slate-900 flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full ${r.contribution_margin >= 0 ? 'bg-[#75BFB2]' : 'bg-[#D991A4]'}"></span>
                        <div>
                            <div class="font-bold text-slate-800">${r.campaign_name}</div>
                            <div class="text-[10px] text-slate-400 font-mono">${r.campaign_id}</div>
                        </div>
                    </td>
                    <td class="py-3 px-3 text-center">
                        <span class="px-2.5 py-1 rounded-xl text-xs font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]">
                            ${r.orders_count}
                        </span>
                    </td>
                    <td class="py-3 px-3 text-right text-slate-600 font-medium">${formatVND(r.gross_revenue)}</td>
                    <td class="py-3 px-3 text-right">
                        ${r.returns_value > 0 ? `<span class="px-2 py-0.5 rounded-lg text-xs font-semibold bg-[#F2E5E4] text-[#D991A4]">${formatVND(r.returns_value)}</span>` : `<span class="text-slate-400">0 đ</span>`}
                    </td>
                    <td class="py-3 px-3 text-right">
                        <span class="px-2.5 py-1 rounded-xl text-xs font-black bg-[#F2E5E4] text-[#203833] border border-[#B8D9D3]/60">
                            ${formatVND(r.net_revenue)}
                        </span>
                    </td>
                    <td class="py-3 px-3 text-right text-slate-500">${formatVND(r.cogs)}</td>
                    <td class="py-3 px-3 text-right text-slate-700 font-medium">${formatVND(r.gross_profit || (r.net_revenue - r.cogs))}</td>
                    <td class="py-3 px-3 text-right text-[#872D43] font-semibold">${formatVND(r.discount_cost)}</td>
                    <td class="py-3 px-3 text-right text-slate-500">${formatVND(r.direct_cost)}</td>
                    <td class="py-3 px-3 text-right text-slate-500">${formatVND(r.allocated_overhead)}</td>
                    <td class="py-3 px-3 text-right">
                        <span class="px-2.5 py-1 rounded-xl text-xs font-black ${r.contribution_margin >= 0 ? 'bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]' : 'bg-[#F2E5E4] text-[#872D43] border border-[#D991A4]'}">
                            ${formatVND(r.contribution_margin)}
                        </span>
                    </td>
                    <td class="py-3 px-3 text-center">
                        <span class="px-2.5 py-1 rounded-xl text-[11px] font-extrabold ${r.contribution_margin_pct >= 0 ? 'bg-[#B8D9D3]/40/70 text-[#203833]' : 'bg-[#D9A3AC]/30/70 text-[#872D43]'}">
                            ${r.contribution_margin_pct}%
                        </span>
                    </td>
                    <td class="py-3 px-3 text-center">
                        <span class="px-2.5 py-1 rounded-xl text-[11px] font-extrabold ${r.roi_pct >= 0 ? 'bg-[#D9A3AC]/30/70 text-[#872D43]' : 'bg-[#D9A3AC]/30/70 text-[#872D43]'}">
                            ${r.roi_pct}%
                        </span>
                    </td>
                </tr>
            `).join('');
        }

        // Render Strategy Recommendations
        function renderRecommendations(recs) {
            const grid = document.getElementById('recommendationsGrid');
            if (!recs.length) {
                grid.innerHTML = `<div class="p-8 bg-slate-50 border border-slate-200 rounded-3xl text-slate-400 italic text-center col-span-2 text-xs">Chờ kết quả phân tích P&L để đưa ra khuyến nghị chiến lược.</div>`;
                return;
            }

            const badgeStyles = {
                'success': 'bg-[#B8D9D3]/30 text-[#203833] border-[#B8D9D3]',
                'warning': 'bg-[#F2E5E4] text-[#872D43] border-[#D9A3AC]',
                'danger': 'bg-[#F2E5E4] text-[#872D43] border-[#D991A4]'
            };

            grid.innerHTML = recs.map(r => `
                <div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-card flex flex-col justify-between space-y-3">
                    <div>
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-2">
                            <span class="font-extrabold text-sm text-slate-900">${r.campaign_name} (${r.campaign_id})</span>
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold border ${badgeStyles[r.decision_badge] || badgeStyles.warning}">
                                ${r.decision}
                            </span>
                        </div>
                        <p class="text-xs text-slate-700 font-medium mb-3"><i class="fa-solid fa-quote-left mr-1.5 text-[#203833]"></i>${r.primary_reason}</p>
                        
                        <div class="space-y-1 mb-2">
                            <span class="text-[11px] font-bold uppercase text-slate-400">Hành động đề xuất (Action Items):</span>
                            <ul class="list-disc list-inside text-xs text-slate-600 space-y-0.5">
                                ${(r.action_items || []).map(item => `<li>${item}</li>`).join('')}
                            </ul>
                        </div>
                    </div>

                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 text-[11px]">
                        <span class="font-bold text-[#203833] block mb-0.5"><i class="fa-solid fa-database mr-1"></i>Dữ liệu cần bổ sung:</span>
                        <p class="text-slate-500">${(r.data_needed || []).join(' • ')}</p>
                    </div>
                </div>
            `).join('');
        }

        // Render Cleaning Exceptions & AI Proposed Solutions
        // Helper: Nhóm các lỗi làm sạch theo từng loại lỗi duy nhất (Mỗi loại lỗi chỉ hiện 1 lần)
        function groupCleaningExceptions(exceptions) {
            if (!exceptions || !exceptions.length) return [];

            const typeConfig = {
                'MISSING_CRITICAL_FIELDS': {
                    title: 'Khuyết Thiếu Mã Đơn Hàng Cốt Lõi (Order ID)',
                    category: 'Lỗi Dữ Liệu Cốt Lõi',
                    icon: 'fa-id-card-clip text-[#D991A4]',
                    badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D991A4]',
                    defaultDesc: 'Tệp tải lên phát hiện các dòng đơn hàng bị khuyết thiếu Mã đơn hàng định danh.',
                    defaultImpact: 'Không thể đối soát doanh thu chi tiết từng đơn hàng.',
                    defaultSolution: 'AI tự động nhận diện và gán mã định danh chuẩn (ORD_xxx / ORD_IMP_xxx) cho toàn bộ các đơn bị thiếu để bảo toàn dữ liệu.'
                },
                'MISSING_PRODUCT_ID': {
                    title: 'Khuyết Thiếu Mã Sản Phẩm (Product ID)',
                    category: 'Lỗi Dữ Liệu Cốt Lõi',
                    icon: 'fa-barcode text-[#D991A4]',
                    badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]',
                    defaultDesc: 'Phát hiện các đơn hàng không có mã sản phẩm tương ứng trong danh mục hàng hóa.',
                    defaultImpact: 'Không thể tra cứu trực tiếp giá vốn COGS để tính biên lợi nhuận.',
                    defaultSolution: 'AI tự động ước tính giá vốn COGS theo tỷ suất tiêu chuẩn ngành (65% doanh thu) cho toàn bộ các đơn này để không gián đoạn tính P&L.'
                },
                'INVALID_PRICE': {
                    title: 'Đơn Giá Rỗng Hoặc Bằng 0 (Invalid Unit Price)',
                    category: 'Lỗi Định Dạng Số & Tiền Tệ',
                    icon: 'fa-tag text-[#D991A4]',
                    badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]',
                    defaultDesc: 'Phát hiện các dòng giao dịch có đơn giá bằng 0 hoặc định dạng tiền tệ không hợp lệ.',
                    defaultImpact: 'Gây sai lệch doanh thu gộp của chiến dịch.',
                    defaultSolution: 'AI tự động làm sạch ký tự tiền tệ và đối soát bù đắp theo giá trị niêm yết hoặc giá trị trung bình hợp lệ.'
                },
                'DUPLICATE_DATA': {
                    title: 'Trùng Lặp Bản Ghi Đơn Hàng (Duplicate Records)',
                    category: 'Lỗi Trùng Lặp & Xung Đột',
                    icon: 'fa-clone text-orange-500',
                    badgeClass: 'bg-orange-100 text-orange-800 border-orange-200',
                    defaultDesc: 'Phát hiện các dòng dữ liệu bị ghi nhận lặp lại cùng một mã đơn hàng trong tệp giao dịch.',
                    defaultImpact: 'Làm phình ảo doanh thu và số lượng đơn hàng nếu không khử trùng lặp.',
                    defaultSolution: 'AI tự động khử trùng lặp (Deduplicate) theo Order ID, chỉ giữ lại bản ghi chuẩn đầu tiên cho toàn bộ các đơn trùng.'
                },
                'DATE_TIME_INCONSISTENCY': {
                    title: 'Sai Lệch Định Dạng Thời Gian & Ngày Tháng',
                    category: 'Sai Lệch Thời Gian & Ngày Tháng',
                    icon: 'fa-calendar-xmark text-[#75BFB2]',
                    badgeClass: 'bg-[#B8D9D3]/40 text-[#203833] border-[#B8D9D3]',
                    defaultDesc: 'Định dạng ngày tháng không đồng nhất giữa các dòng (lẫn lộn DD/MM/YYYY, MM/DD/YYYY hoặc ngày không hợp lệ).',
                    defaultImpact: 'Làm sai lệch biểu đồ diễn biến doanh thu theo thời gian.',
                    defaultSolution: 'AI tự động quy đổi và chuẩn hóa 100% ngày tháng về định dạng chuẩn quốc tế ISO (YYYY-MM-DD).'
                },
                'LATE_RETURN': {
                    title: 'Đơn Hoàn Hàng Sau Kỳ Chiến Dịch (Post-Campaign Return)',
                    category: 'Hàng Đổi Trả & Đối Soát',
                    icon: 'fa-arrow-rotate-left text-[#D991A4]',
                    badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]',
                    defaultDesc: 'Phát hiện đơn hàng hoàn trả sau khi chương trình khuyến mãi đã kết thúc kỳ đối soát.',
                    defaultImpact: 'Nếu không khấu trừ sẽ làm sai lệch lợi nhuận thực tế của chương trình.',
                    defaultSolution: 'AI tự động bóc tách và khấu trừ ngược giá trị hàng hoàn trễ vào đúng chiến dịch gốc ban đầu.'
                },
                'MULTI_TOUCH_CONFLICT': {
                    title: 'Xung Đột Đa Chương Trình Khuyến Mãi (Multi-Touch Stacking)',
                    category: 'Xung Đột Khuyến Mãi',
                    icon: 'fa-layer-group text-[#75BFB2]',
                    badgeClass: 'bg-[#B8D9D3]/40 text-[#203833] border-[#B8D9D3]',
                    defaultDesc: 'Đơn hàng áp dụng đồng thời từ 2 chương trình khuyến mãi hoặc nhiều mã voucher cùng lúc.',
                    defaultImpact: 'Nguy cơ tính trùng lặp doanh thu 2 lần nếu cộng gộp từng chiến dịch riêng rẽ.',
                    defaultSolution: 'AI tự động áp dụng phương pháp Proportional Split: Chia đều tỷ trọng doanh thu & chiết khấu theo các voucher để khử 100% doanh số ảo.'
                },
                'UNASSIGNED_COST_CAMPAIGN': {
                    title: 'Khoản Chi Phí Chưa Gán Mã Chiến Dịch',
                    category: 'Phân Bổ Chi Phí',
                    icon: 'fa-receipt text-[#D991A4]',
                    badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]',
                    defaultDesc: 'Khoản chi phí phát sinh nhưng bị khuyết thiếu mã chiến dịch cụ thể.',
                    defaultImpact: 'Không thể ghi nhận trực tiếp vào bảng P&L của từng chương trình.',
                    defaultSolution: 'AI tự động chuyển vào nhóm Chi Phí Chung (Overhead) để phân bổ khoa học theo tỷ trọng doanh thu.'
                },
                'PENDING_ALLOCATION_RULE': {
                    title: 'Chi Phí Chung Chưa Được Phê Duyệt Tiêu Thức Phân Bổ',
                    category: 'Phân Bổ Chi Phí',
                    icon: 'fa-scale-balanced text-[#203833]',
                    badgeClass: 'bg-[#B8D9D3]/40 text-[#203833] border-[#B8D9D3]',
                    defaultDesc: 'Khoản chi phí gián tiếp (Overhead) chưa xác định rõ quy tắc phân chia.',
                    defaultImpact: 'Có thể làm sai lệch biên đóng góp (CM) giữa các chương trình.',
                    defaultSolution: 'AI tự động áp dụng tiêu thức phân bổ theo Tỷ Trọng Doanh Thu Thuần (Revenue Share) đạt chuẩn kế toán quản trị.'
                }
            };

            const groups = {};
            exceptions.forEach(ex => {
                const typeKey = ex.type || 'OTHER_ISSUE';
                if (!groups[typeKey]) {
                    const cfg = typeConfig[typeKey] || {
                        title: typeKey.replace(/_/g, ' '),
                        category: 'Vấn Đề Dữ Liệu Khác',
                        icon: 'fa-circle-exclamation text-[#D991A4]',
                        badgeClass: 'bg-[#D9A3AC]/30 text-[#872D43] border-[#D9A3AC]',
                        defaultDesc: ex.description || 'Phát hiện sự không nhất quán trong dữ liệu.',
                        defaultImpact: ex.impact || 'Ảnh hưởng đến độ tin cậy của báo cáo.',
                        defaultSolution: ex.ai_solution || 'AI tự động chuẩn hóa và phân bổ số liệu hợp lệ.'
                    };

                    groups[typeKey] = {
                        type: typeKey,
                        title: cfg.title,
                        category: cfg.category,
                        icon: cfg.icon,
                        badgeClass: cfg.badgeClass,
                        count: 0,
                        itemIds: [],
                        description: ex.description || cfg.defaultDesc,
                        impact: ex.impact || cfg.defaultImpact,
                        ai_solution: ex.ai_solution || cfg.defaultSolution
                    };
                }

                groups[typeKey].count += 1;
                const itemIdStr = String(ex.item_id || '').trim();
                if (itemIdStr && !groups[typeKey].itemIds.includes(itemIdStr)) {
                    groups[typeKey].itemIds.push(itemIdStr);
                }
            });

            return Object.values(groups);
        }

        // Render Cleaning Solutions List in Step 2 (Hiển thị mỗi loại lỗi đúng 1 lần duy nhất)
        function renderCleaningSolutions(exceptions) {
            const container = document.getElementById('cleaningSolutionsList');
            const errBadge = document.getElementById('detectedErrorsBadge');
            const btnApprove = document.getElementById('btnApproveCleaning');
            const step2Status = document.getElementById('step2StatusBadge');

            if (!container) return;

            if (!exceptions || !exceptions.length) {
                if (errBadge) {
                    errBadge.innerText = "0 Phát hiện (100% Sạch)";
                    errBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#B8D9D3]/40 text-[#203833] border border-[#B8D9D3]";
                }
                if (btnApprove) {
                    btnApprove.className = "btn-smooth px-5 py-2.5 bg-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-xs flex items-center gap-2 cursor-default shrink-0";
                    btnApprove.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2] text-sm"></i> <span>DỮ LIỆU ĐÃ ĐẠT CHUẨN 100%</span>`;
                }
                if (step2Status) {
                    step2Status.innerHTML = `<i class="fa-solid fa-shield-halved text-[#75BFB2] mr-1"></i> Dữ Liệu Sạch Hoàn Hảo`;
                }

                container.innerHTML = `
                    <div class="p-6 bg-[#B8D9D3]/30 border border-[#B8D9D3] rounded-2xl flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-2xl bg-[#75BFB2] text-white flex items-center justify-center text-lg shrink-0 shadow-sm">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-black text-[#203833] uppercase tracking-wide">Dữ Liệu Đạt Chuẩn 100% - Không Phát Hiện Lỗi Cần Xử Lý</h4>
                            <p class="text-xs text-[#203833] mt-0.5">Toàn bộ ID đơn hàng, ngày tháng, tiền tệ và chi phí đều hợp lệ. Bạn có thể kiểm tra bảng dữ liệu mới bên dưới và bấm nút chuyển sang Bước 3.</p>
                        </div>
                    </div>
                `;
                return;
            }

            const groupedErrors = groupCleaningExceptions(exceptions);

            if (errBadge) {
                errBadge.innerText = `${groupedErrors.length} Nhóm lỗi (${exceptions.length} vị trí dữ liệu đã được AI xử lý sạch)`;
                errBadge.className = "px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-[#D9A3AC]/30 text-[#872D43] border border-[#D9A3AC]";
            }
            if (btnApprove) {
                btnApprove.className = "btn-smooth px-5 py-2.5 bg-[#75BFB2] hover:bg-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-md shadow-[#75BFB2]/20 flex items-center gap-2 cursor-pointer shrink-0";
                btnApprove.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2] text-sm"></i> <span>ĐỒNG Ý VỚI CÁC HƯỚNG GIẢI QUYẾT LÀM SẠCH (${groupedErrors.length} NHÓM LỖI)</span>`;
            }

            container.innerHTML = groupedErrors.map((grp, idx) => {
                const sampleItems = grp.itemIds.slice(0, 3).join(', ');
                const remainingCount = grp.itemIds.length > 3 ? ` (+${grp.itemIds.length - 3} vị trí khác)` : '';
                const itemsDisplay = sampleItems ? `${sampleItems}${remainingCount}` : `${grp.count} dòng dữ liệu`;

                return `
                <div class="p-4 bg-slate-50/90 border border-slate-200 rounded-2xl space-y-3 transition hover:border-[#B8D9D3] shadow-2xs">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div class="flex items-center gap-2.5">
                            <span class="w-7 h-7 rounded-lg bg-[#B8D9D3]/40 text-[#203833] flex items-center justify-center text-xs font-black shadow-2xs">${idx + 1}</span>
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-extrabold text-xs text-slate-900">${grp.title}</h4>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md ${grp.badgeClass} border">${grp.category}</span>
                                </div>
                                <div class="text-[11px] text-slate-500 font-medium mt-0.5 flex items-center gap-1.5 flex-wrap">
                                    <span><i class="fa-solid fa-bullseye text-[#75BFB2] text-[10px]"></i> Phát hiện ở <strong>${grp.count}</strong> vị trí:</span>
                                    <span class="font-mono text-[11px] bg-white border border-slate-200 px-1.5 py-0.5 rounded text-[#203833] font-semibold">${itemsDisplay}</span>
                                </div>
                            </div>
                        </div>
                        <span class="exc-status-pill px-3 py-1 rounded-full text-[10px] font-bold bg-[#D9A3AC]/30 text-[#872D43] border border-[#D9A3AC] shadow-2xs">
                            <i class="fa-solid fa-clock mr-1"></i> Chờ duyệt giải pháp
                        </span>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs pt-1">
                        <div class="bg-white p-3 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] font-bold text-slate-500 block mb-1">
                                <i class="fa-solid fa-magnifying-glass text-slate-400 mr-1"></i>Vấn đề dữ liệu gốc & Nguy cơ:
                            </span>
                            <p class="text-slate-800 font-medium leading-relaxed">${grp.description}</p>
                            <p class="text-[11px] text-[#872D43] font-semibold mt-1.5 flex items-start gap-1">
                                <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0"></i>
                                <span>Rủi ro: ${grp.impact || 'Ảnh hưởng trực tiếp đến tính chính xác của P&L'}</span>
                            </p>
                        </div>
                        <div class="p-3 bg-[#F2E5E4]/80 border border-[#B8D9D3] rounded-xl">
                            <span class="text-[11px] font-extrabold text-[#203833] flex items-center gap-1.5 mb-1">
                                <i class="fa-solid fa-wand-magic-sparkles text-[#203833]"></i> Hướng Giải Quyết Đề Xuất Của AI:
                            </span>
                            <p class="text-xs text-[#203833] font-semibold leading-relaxed">${grp.ai_solution || 'AI tự động nhận diện, chuẩn hóa và xử lý triệt để 100% dòng dữ liệu bị ảnh hưởng.'}</p>
                            <div class="mt-2 text-[10px] text-[#203833] font-bold flex items-center gap-1">
                                <i class="fa-solid fa-circle-check text-[#75BFB2]"></i> AI Brain: Đã tự động xử lý và làm sạch toàn bộ ${grp.count} dòng trong bảng dữ liệu mới bên dưới
                            </div>
                        </div>
                    </div>
                </div>
                `;
            }).join('');
        }

        // User Approves Cleaning Solutions
        function approveAllCleaningSolutions() {
            document.querySelectorAll('.exc-status-pill').forEach(pill => {
                pill.className = "exc-status-pill px-3 py-1 rounded-full text-[10px] font-bold bg-[#B8D9D3]/40 text-[#203833] border border-[#B8D9D3] shadow-2xs";
                pill.innerHTML = `<i class="fa-solid fa-circle-check text-[#203833] mr-1"></i> ĐÃ ĐỒNG Ý ÁP DỤNG`;
            });
            const btn = document.getElementById('btnApproveCleaning');
            if (btn) {
                btn.className = "btn-smooth px-5 py-2.5 bg-[#5EABA0] text-white text-xs font-extrabold rounded-xl shadow-xs flex items-center gap-2 cursor-default";
                btn.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2] text-sm"></i> <span>ĐÃ ĐỒNG Ý CÁC HƯỚNG GIẢI QUYẾT CỦA AI</span>`;
            }
            const verifyBadge = document.getElementById('dataCleanVerificationBadge');
            if (verifyBadge) {
                verifyBadge.className = "px-3 py-1 rounded-full text-[11px] font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]";
                verifyBadge.innerHTML = `<i class="fa-solid fa-circle-check text-[#203833] mr-1"></i> ĐÃ PHÊ DUYỆT LÀM SẠCH`;
            }
            showToast("🎉 Bạn đã đồng ý với các hướng giải quyết của AI! Bảng dữ liệu sạch đã sẵn sàng bên dưới để bạn duyệt tiếp.", "success");
        }

        // Global storage for active human overrides
        let currentHumanOverrides = {
            orders: {},
            costs: {},
            cogs_default_ratio: 0.65,
            zero_price_policy: "AUTO_IMPUTE"
        };

        // Render Dynamic Human Control Panel tailored to uploaded dataset
        function renderHumanControlPanel(data) {
            const container = document.getElementById('hitlDynamicControlsContainer');
            const badge = document.getElementById('hitlContextBadge');
            if (!container) return;

            if (!data || data.status === 'AWAITING_INPUT' || !data.pnl_table || data.pnl_table.length === 0) {
                if (badge) {
                    badge.innerHTML = `<i class="fa-solid fa-clock mr-1"></i> Chờ Tải Dữ Liệu`;
                    badge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200";
                }
                container.innerHTML = `
                    <div class="p-4 bg-white/80 border border-slate-200 rounded-xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-cloud-arrow-up text-lg text-slate-300 block mb-1"></i>
                        Chưa có tệp dữ liệu. Sau khi bạn tải tệp ở Bước 1, AI sẽ tự động phân tích và tạo các tùy chọn can thiệp phù hợp nhất với dữ liệu thực tế.
                    </div>
                `;
                return;
            }

            const excs = data.exceptions_list || [];
            const pnlTable = data.pnl_table || [];
            const costsData = data.costs_data || [];
            
            // Check specific findings
            const hasMissingProdOrCogs = excs.some(e => 
                e.type === 'MISSING_PRODUCT_ID' || 
                e.type === 'MISSING_COGS' || 
                (e.description && (e.description.toLowerCase().includes('sản phẩm') || e.description.toLowerCase().includes('giá vốn')))
            );

            const hasInvalidPrice = excs.some(e => 
                e.type === 'INVALID_PRICE' || 
                (e.description && e.description.toLowerCase().includes('đơn giá'))
            );

            const multiTouchExcs = excs.filter(e => 
                e.type === 'MULTI_TOUCH_CONFLICT' || 
                e.type === 'OVERLAPPING_DISCOUNT' || 
                (e.description && e.description.toLowerCase().includes('voucher') && e.item_id && !e.item_id.includes('vị trí'))
            );

            // Overhead costs in file
            const overheadCostItems = costsData.filter(c => {
                const ctype = String(c.cost_type || '').toUpperCase();
                const cid = String(c.campaign_id || '').toUpperCase();
                return ctype === 'OVERHEAD' || ['ALL', 'OVERHEAD', ''].includes(cid);
            });

            if (badge) {
                const anomalyCount = (hasMissingProdOrCogs ? 1 : 0) + (hasInvalidPrice ? 1 : 0) + multiTouchExcs.length;
                if (anomalyCount > 0) {
                    badge.innerHTML = `<i class="fa-solid fa-sliders text-[#D991A4] mr-1"></i> Phát hiện ${anomalyCount} điểm cần quyết định nghiệp vụ`;
                    badge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#F2E5E4] text-[#872D43] border border-[#D9A3AC]";
                } else {
                    badge.innerHTML = `<i class="fa-solid fa-circle-check text-[#75BFB2] mr-1"></i> Dữ Liệu Sạch (Tùy chỉnh thông số tùy chọn)`;
                    badge.className = "px-2.5 py-1 rounded-full text-[10px] font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]";
                }
            }

            // Extract campaign list for dropdowns
            const detectedCampaigns = pnlTable.map(p => ({
                id: p.campaign_id,
                name: p.campaign_name || p.campaign_id
            })).filter(c => c.id && c.id !== 'ORGANIC');

            let html = `
                <div class="space-y-4 text-xs">
                    <!-- KHỐI 1: CHÍNH SÁCH GIÁ BÁN & GIÁ VỐN (COGS & PRICING) -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 flex-wrap gap-2">
                            <span class="font-extrabold text-slate-800 flex items-center gap-1.5">
                                <i class="fa-solid fa-calculator text-[#203833]"></i>
                                <span>1. Chính Sách Định Giá & Ước Tính Giá Vốn (COGS):</span>
                            </span>
                            ${hasMissingProdOrCogs ? '<span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-[#F2E5E4] text-[#872D43] border border-[#D9A3AC]"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Có đơn thiếu mã SP/giá vốn</span>' : '<span class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-[#B8D9D3]/30 text-[#203833] border border-[#B8D9D3]"><i class="fa-solid fa-check mr-1"></i>Đã có mã SP</span>'}
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-slate-700 font-bold mb-1 text-[11px]">
                                    Tỷ lệ Giá Vốn (COGS) ước tính mặc định:
                                </label>
                                <select id="hitlCogsRatio" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar">
                                    <option value="0.65" ${currentHumanOverrides.cogs_default_ratio == 0.65 ? 'selected' : ''}>65% Doanh Thu (Tiêu chuẩn Bán Lẻ Thời Trang / FMCG - Khuyên dùng)</option>
                                    <option value="0.50" ${currentHumanOverrides.cogs_default_ratio == 0.50 ? 'selected' : ''}>50% Doanh Thu (Biên Lợi Nhuận Gộp Cao ~50%)</option>
                                    <option value="0.75" ${currentHumanOverrides.cogs_default_ratio == 0.75 ? 'selected' : ''}>75% Doanh Thu (Biên Lợi Nhuận Gộp Thấp ~25% / Đại lý)</option>
                                    <option value="0.40" ${currentHumanOverrides.cogs_default_ratio == 0.40 ? 'selected' : ''}>40% Doanh Thu (Hàng Xưởng Tự Sản Xuất / Biên Rất Cao)</option>
                                    <option value="0.00" ${currentHumanOverrides.cogs_default_ratio == 0 ? 'selected' : ''}>0% (Ngành Dịch Vụ / Không tạm tính giá vốn hàng bán)</option>
                                </select>
                                <p class="text-[10px] text-slate-500 mt-1">Áp dụng cho các sản phẩm chưa có giá vốn trong tệp để tính toán Lợi nhuận gộp.</p>
                            </div>

                            <div>
                                <label class="block text-slate-700 font-bold mb-1 text-[11px]">
                                    Chính sách xử lý Đơn Giá = 0 hoặc Rỗng:
                                </label>
                                <select id="hitlZeroPricePolicy" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar">
                                    <option value="AUTO_IMPUTE" ${currentHumanOverrides.zero_price_policy === 'AUTO_IMPUTE' ? 'selected' : ''}>Tự động bù đắp theo giá bán TB sản phẩm (Auto-Impute - Khuyên dùng)</option>
                                    <option value="KEEP_ZERO" ${currentHumanOverrides.zero_price_policy === 'KEEP_ZERO' ? 'selected' : ''}>Giữ nguyên 0đ (Ghi nhận là Hàng Quà Tặng Kèm / Hàng Mẫu Thử)</option>
                                    <option value="EXCLUDE" ${currentHumanOverrides.zero_price_policy === 'EXCLUDE' ? 'selected' : ''}>Loại trừ dòng này khỏi phân tích Doanh thu & P&L</option>
                                </select>
                                <p class="text-[10px] text-slate-500 mt-1">${hasInvalidPrice ? 'Phát hiện có dòng giá = 0; hãy chọn chính sách phù hợp với thực tế kinh doanh.' : 'Tránh làm sai lệch doanh thu bình quân khi có đơn hàng dùng thử.'}</p>
                            </div>
                        </div>
                    </div>

                    <!-- KHỐI 2: PHÂN BỔ CHI PHÍ CHUNG & CHIẾN DỊCH (OVERHEAD & ATTRIBUTION) -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200/90 shadow-2xs space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-100 flex-wrap gap-2">
                            <span class="font-extrabold text-slate-800 flex items-center gap-1.5">
                                <i class="fa-solid fa-diagram-project text-[#203833]"></i>
                                <span>2. Tiêu Thức Phân Bổ Chi Phí Chung & Khử Trùng Khuyến Mãi:</span>
                            </span>
                            <span class="text-[10px] text-slate-400">Điều chỉnh theo mô hình quản trị tài chính doanh nghiệp</span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-slate-700 font-bold mb-1 text-[11px]">
                                    Quy tắc Phân Bổ Chi Phí Chung (Overhead Allocation):
                                </label>
                                <select id="hitlOverheadMethod" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar">
                                    <option value="REVENUE_SHARE" selected>Phân bổ theo Tỷ Trọng Doanh Thu Thực Tế (Revenue Share - Khuyên dùng)</option>
                                    <option value="EQUAL_SHARE">Chia đều cho tất cả các Kênh / Chiến dịch (Equal Split)</option>
                                    <option value="ORDER_SHARE">Phân bổ theo Tỷ Lệ Số Lượng Đơn Hàng (Order Volume Share)</option>
                                    <option value="NO_ALLOCATION">Không phân bổ vào kênh (Giữ nguyên cấp toàn công ty)</option>
                                </select>
                                <p class="text-[10px] text-slate-500 mt-1">Chi phí gián tiếp (thuê văn phòng, máy chủ, quản lý) sẽ phân bổ vào từng kênh theo tiêu thức này.</p>
                            </div>

                            <div>
            `;

            // If multi-touch conflicts detected in the file
            if (multiTouchExcs.length > 0) {
                html += `
                                <div class="space-y-2">
                                    <label class="block text-slate-700 font-bold mb-1 text-[11px]">
                                        Xử lý đơn đa voucher được phát hiện (${multiTouchExcs.length} đơn):
                                    </label>
                `;
                multiTouchExcs.slice(0, 3).forEach(mt => {
                    const orderId = mt.item_id || 'ORDER_CONFLICT';
                    html += `
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-[11px] bg-[#F2E5E4] border border-[#B8D9D3] px-2 py-1 rounded text-[#203833] font-bold shrink-0">${orderId}</span>
                                        <select data-hitl-order-id="${orderId}" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar">
                                            <option value="AUTO_SPLIT" selected>Tự động Chia Tỷ Lệ (Auto Split - Khuyên dùng)</option>
                                            ${detectedCampaigns.map(c => `<option value="${c.id}">Gán 100% về ${c.name} (${c.id})</option>`).join('')}
                                        </select>
                                    </div>
                    `;
                });
                html += `
                                    <p class="text-[10px] text-slate-500">Tránh tính đúp doanh thu khi khách hàng gộp nhiều voucher trên 1 đơn.</p>
                                </div>
                `;
            } else {
                html += `
                                <div>
                                    <label class="block text-slate-700 font-bold mb-1 text-[11px]">
                                        Quy tắc Khử Trùng Khuyến Mãi (Attribution Rule):
                                    </label>
                                    <div class="p-3 bg-[#B8D9D3]/30/70 border border-[#B8D9D3]/80 rounded-xl flex items-start gap-2.5">
                                        <i class="fa-solid fa-circle-check text-[#203833] text-sm mt-0.5"></i>
                                        <div>
                                            <div class="text-[11px] font-bold text-[#203833]">Không có xung đột đa voucher trong tệp này</div>
                                            <div class="text-[10px] text-[#203833] leading-relaxed mt-0.5">100% đơn hàng có mã chương trình duy nhất hoặc bán hàng tự nhiên. Số liệu đã được khử trùng triệt để.</div>
                                        </div>
                                    </div>
                                </div>
                `;
            }

            html += `
                            </div>
                        </div>
            `;

            // Overhead items adjustment
            html += `
                        <div class="pt-3 border-t border-slate-100">
            `;
            if (overheadCostItems.length > 0) {
                html += `
                            <label class="block text-slate-700 font-bold mb-1.5 text-[11px]">
                                Điều chỉnh các khoản chi phí chung trong tệp (${overheadCostItems.length} khoản mục):
                            </label>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                `;
                overheadCostItems.forEach(ci => {
                    const cid = ci.cost_id || 'CST_OVERHEAD';
                    const cdesc = ci.description || cid;
                    const camt = parseFloat(ci.amount) || 0;
                    html += `
                                <div>
                                    <span class="text-[10px] font-semibold text-slate-500 block mb-0.5">${cdesc} (${cid}):</span>
                                    <div class="relative">
                                        <input type="number" data-hitl-cost-id="${cid}" value="${camt}" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar pr-10">
                                        <span class="absolute right-2.5 top-2 text-[10px] text-slate-400 font-bold">đ</span>
                                    </div>
                                </div>
                    `;
                });
                html += `   </div>`;
            } else {
                html += `
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div>
                                    <label class="block text-slate-700 font-bold text-[11px]">
                                        Bổ sung Chi phí Gián tiếp ngoài tệp nếu cần (Tiền thuê mặt bằng, máy chủ, lương vận hành):
                                    </label>
                                    <p class="text-[10px] text-slate-400">Nếu tệp của bạn chỉ gồm doanh thu bán lẻ, bạn có thể nhập chi phí cố định để tính Biên Lợi Nhuận Ròng (Net CM).</p>
                                </div>
                                <div class="relative sm:w-60 shrink-0">
                                    <input type="number" id="hitlExtraOverhead" placeholder="0" value="0" min="0" step="500000" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2.5 text-xs text-slate-800 font-semibold outline-none focus:ring-2 focus:ring-forshop-sidebar pr-12">
                                    <span class="absolute right-3 top-2.5 text-xs text-slate-400 font-bold">VNĐ</span>
                                </div>
                            </div>
                `;
            }

            html += `
                        </div>
                    </div>

                    <!-- ACTION BUTTON -->
                    <div class="flex items-center justify-between flex-wrap gap-3 pt-1">
                        <div class="text-[11px] text-slate-500 flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-info text-[#203833]"></i>
                            <span>Sau khi chọn thông số, bấm nút bên phải để AI tính toán lại P&L theo tiêu chuẩn bạn chọn.</span>
                        </div>
                        <button onclick="applyHumanControlOverrides()" class="btn-smooth px-6 py-2.5 bg-gradient-to-r from-forshop-sidebar to-[#75BFB2] hover:from-[#203833] hover:to-[#203833] text-white text-xs font-extrabold rounded-xl shadow-md shadow-indigo-900/20 flex items-center gap-2 cursor-pointer">
                            <i class="fa-solid fa-sliders text-[#75BFB2]"></i>
                            <span>Áp Dụng Can Thiệp & Tính Toán Lại P&L</span>
                        </button>
                    </div>
                </div>
            `;

            container.innerHTML = html;
        }

        function getDynamicHumanOverrides() {
            const overrides = {
                orders: {},
                costs: {}
            };

            const cogsSelect = document.getElementById('hitlCogsRatio');
            if (cogsSelect) {
                overrides.cogs_default_ratio = parseFloat(cogsSelect.value) || 0.65;
            }

            const zeroPriceSelect = document.getElementById('hitlZeroPricePolicy');
            if (zeroPriceSelect) {
                overrides.zero_price_policy = zeroPriceSelect.value;
            }

            document.querySelectorAll('[data-hitl-order-id]').forEach(el => {
                const orderId = el.getAttribute('data-hitl-order-id');
                const val = el.value;
                if (val && val !== 'AUTO_SPLIT') {
                    overrides.orders[orderId] = { assigned_campaign: val };
                }
            });

            document.querySelectorAll('[data-hitl-cost-id]').forEach(el => {
                const costId = el.getAttribute('data-hitl-cost-id');
                const val = parseFloat(el.value);
                if (!isNaN(val)) {
                    overrides.costs[costId] = val;
                }
            });

            const extraOverheadInput = document.getElementById('hitlExtraOverhead');
            if (extraOverheadInput) {
                const extraVal = parseFloat(extraOverheadInput.value);
                if (!isNaN(extraVal) && extraVal > 0) {
                    overrides.costs['MANUAL_OVERHEAD'] = extraVal;
                }
            }

            currentHumanOverrides = { ...currentHumanOverrides, ...overrides };
            return overrides;
        }

        function getDynamicOverheadMethod() {
            const el = document.getElementById('hitlOverheadMethod');
            return el ? el.value : 'REVENUE_SHARE';
        }

        function getDynamicMultiTouchRule() {
            return 'PROPORTIONAL';
        }

        async function applyHumanControlOverrides() {
            showToast('✨ Đã ghi nhận tùy chọn can thiệp! Đang tính toán lại báo cáo P&L theo thông số mới...', 'info');
            const overrides = getDynamicHumanOverrides();
            const overheadMethod = getDynamicOverheadMethod();
            await fetchBackendPipeline({
                human_overrides: overrides,
                overhead_method: overheadMethod
            });
            showToast('✅ Báo cáo P&L đã được tính toán lại thành công theo các tùy chọn can thiệp của bạn!', 'success');
        }

        let currentCleanedRecords = [];
        let isShowAllCleanedRows = false;

        // Render Cleaned Data Preview Table (Show 50 rows by default, expandable with Show button)
        function renderCleanedDataTable(records) {
            const tbody = document.getElementById('cleanedDataTableBody');
            const countBadge = document.getElementById('badgeCleanedRecordsCount');
            const paginationBar = document.getElementById('cleanedDataPaginationBar');
            const showingCountEl = document.getElementById('showingRowCount');
            const totalCountEl = document.getElementById('totalRowCount');
            const btnToggle = document.getElementById('btnToggleShowAllCleaned');
            if (!tbody) return;

            if (records !== undefined) {
                currentCleanedRecords = records || [];
                isShowAllCleanedRows = false; // Reset collapse state upon new data loading
            }

            const data = currentCleanedRecords || [];

            if (!data || !data.length) {
                if (countBadge) countBadge.innerText = "0 Đơn Hàng";
                if (paginationBar) paginationBar.classList.add('hidden');
                tbody.innerHTML = `
                    <tr>
                        <td colspan="12" class="py-10 text-center text-slate-400 italic">
                            <i class="fa-solid fa-file-excel text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu làm sạch. Tải tệp ở Bước 1 để hiển thị dữ liệu mới tại đây.
                        </td>
                    </tr>
                `;
                return;
            }

            const totalRows = data.length;
            if (countBadge) {
                countBadge.innerText = `${totalRows} Đơn Hàng Đã Làm Sạch`;
            }

            const displayRows = isShowAllCleanedRows ? data : data.slice(0, 50);

            if (paginationBar) {
                if (totalRows > 50) {
                    paginationBar.classList.remove('hidden');
                    if (showingCountEl) showingCountEl.innerText = displayRows.length;
                    if (totalCountEl) totalCountEl.innerText = totalRows;
                    if (btnToggle) {
                        if (isShowAllCleanedRows) {
                            btnToggle.innerHTML = `<i class="fa-solid fa-chevron-up mr-1.5"></i> Thu Gọn (Xem 50 dòng)`;
                        } else {
                            btnToggle.innerHTML = `<i class="fa-solid fa-table-list mr-1.5"></i> Show Toàn Bộ Dữ Liệu (${totalRows} dòng)`;
                        }
                    }
                } else {
                    paginationBar.classList.add('hidden');
                }
            }

            tbody.innerHTML = displayRows.map((r, i) => {
                const channelClass = r.channel === 'Online' ? 'bg-[#B8D9D3]/30 text-[#203833] border-[#B8D9D3]' : 'bg-[#F2E5E4] text-[#872D43] border-[#D9A3AC]';
                const statusClass = r.status === 'COMPLETED' ? 'bg-[#B8D9D3]/30 text-[#203833]' : 'bg-[#F2E5E4] text-[#872D43]';
                const orderId = r.order_id || ('ORD_' + String(i + 1).padStart(3, '0'));
                return `
                    <tr class="hover:bg-[#F2E5E4]/30 transition-colors">
                        <td class="py-2.5 px-3.5 text-center text-slate-400 font-mono text-[11px]">${i + 1}</td>
                        <td class="py-2.5 px-3.5 font-bold font-mono text-slate-900">${orderId}</td>
                        <td class="py-2.5 px-3.5 font-mono text-slate-600">${r.date || '2026-10-01'}</td>
                        <td class="py-2.5 px-3.5">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${channelClass}">${r.channel || 'Direct'}</span>
                        </td>
                        <td class="py-2.5 px-3.5 font-bold text-slate-800">${r.product_id || 'SP01'}</td>
                        <td class="py-2.5 px-3.5 text-center font-bold text-slate-800">${r.quantity || 1}</td>
                        <td class="py-2.5 px-3.5 text-right font-mono text-slate-700">${formatVND(r.unit_price || 0)}</td>
                        <td class="py-2.5 px-3.5 text-right font-mono text-[#D991A4]">${formatVND(r.discount_amount || 0)}</td>
                        <td class="py-2.5 px-3.5 text-right font-mono font-bold text-[#203833]">${formatVND(r.net_revenue || 0)}</td>
                        <td class="py-2.5 px-3.5">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-[#F2E5E4] text-[#203833] border border-[#B8D9D3]/60">${r.campaign_id || 'ORGANIC'}</span>
                        </td>
                        <td class="py-2.5 px-3.5 text-center">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${statusClass}">${r.status || 'COMPLETED'}</span>
                        </td>
                        <td class="py-2.5 px-3.5 text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#B8D9D3]/40 text-[#203833] inline-flex items-center gap-1">
                                <i class="fa-solid fa-check text-[#203833] text-[10px]"></i> Đã làm sạch
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Toggle between 50 rows and all rows
        function toggleShowAllCleanedData() {
            isShowAllCleanedRows = !isShowAllCleanedRows;
            renderCleanedDataTable();
        }

        // Confirm Cleaned Data and Proceed to Step 3
        function confirmCleanedDataAndProceed() {
            if (!lastApiResponse || !lastApiResponse.summary_kpis || lastApiResponse.status === 'AWAITING_INPUT') {
                showToast("📁 Chưa có tệp dữ liệu nào được tải lên. Vui lòng tải file ở Bước 1!", "info");
                goToStep(1);
                return;
            }
            showToast("🚀 Dữ liệu sạch đã được xác nhận! Bắt đầu chuyển sang Bước 3: Phân Tích P&L 13 Chỉ Số...", "success");
            goToStep(3);
        }

        // Render Audit Logs
        function renderAuditTrail(logs) {
            const tbody = document.getElementById('auditTrailTable');
            if (!logs || !logs.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-400 italic font-sans">Chưa có nhật ký nào...</td></tr>`;
                return;
            }

            const levelBadges = {
                'INFO': 'bg-[#B8D9D3]/30 text-[#203833] border-[#B8D9D3]',
                'WARNING': 'bg-[#F2E5E4] text-[#872D43] border-[#D9A3AC]',
                'ACTION_REQUIRED': 'bg-[#F2E5E4] text-[#872D43] border-[#D991A4]'
            };

            tbody.innerHTML = logs.map(log => `
                <tr class="hover:bg-slate-50/80">
                    <td class="p-3 text-slate-500 whitespace-nowrap">${log.timestamp}</td>
                    <td class="p-3 text-center">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ${levelBadges[log.level] || levelBadges.INFO}">
                            ${log.level}
                        </span>
                    </td>
                    <td class="p-3 text-slate-800 font-bold">${log.step}</td>
                    <td class="p-3 text-slate-600">${log.tool_name}</td>
                    <td class="p-3 text-slate-700 font-sans">${log.message}</td>
                </tr>
            `).join('');
        }

        function filterLogs() {
            const input = document.getElementById('logFilter').value.toLowerCase();
            const rows = document.querySelectorAll('#auditTrailTable tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        // Render Sales Wave Chart
        function renderSalesWaveChart(data, angle) {
            const canvas = document.getElementById('chartSalesWave');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (salesWaveChartInstance) {
                salesWaveChartInstance.destroy();
                salesWaveChartInstance = null;
            }

            const currentAngle = angle || currentAnalysisAngle || 'CAMPAIGN';

            if (currentAngle === 'CHANNEL') {
                const channels = data?.channel_breakdown || [];
                if (!channels.length) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                const labels = channels.map(c => c.channel);
                const grossRevs = channels.map(c => (c.gross_revenue || 0) / 1e6);
                const netRevs = channels.map(c => (c.net_revenue || 0) / 1e6);
                const returns = channels.map(c => (c.return_amount || 0) / 1e6);

                salesWaveChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Doanh Thu Gộp (Tr. VNĐ)',
                                data: grossRevs,
                                backgroundColor: '#75BFB2',
                                borderRadius: 8
                            },
                            {
                                label: 'Hàng Hoàn Lại (Tr. VNĐ)',
                                data: returns,
                                backgroundColor: '#D991A4',
                                borderRadius: 8
                            },
                            {
                                label: 'Doanh Thu Thuần (Tr. VNĐ)',
                                data: netRevs,
                                backgroundColor: '#B8D9D3',
                                borderRadius: 8
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                        },
                        scales: {
                            x: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } }, grid: { display: false } },
                            y: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                        }
                    }
                });
                return;
            }

            if (currentAngle === 'PRODUCT') {
                const products = (data?.product_breakdown || []).slice(0, 6);
                if (!products.length) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                const labels = products.map(p => `${p.product_id} (${p.quantity_sold} SP)`);
                const revs = products.map(p => (p.gross_revenue || 0) / 1e6);
                const margins = products.map(p => (p.gross_profit || 0) / 1e6);

                salesWaveChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Doanh Thu Gộp (Tr. VNĐ)',
                                data: revs,
                                backgroundColor: '#75BFB2',
                                borderRadius: 6
                            },
                            {
                                label: 'Lợi Nhuận Gộp (Tr. VNĐ)',
                                data: margins,
                                backgroundColor: '#D991A4',
                                borderRadius: 6
                            }
                        ]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                        },
                        scales: {
                            x: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } },
                            y: { ticks: { color: '#334155', font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } }, grid: { display: false } }
                        }
                    }
                });
                return;
            }

            if (currentAngle === 'TIMELINE') {
                const timeline = data?.timeline_breakdown || [];
                if (!timeline.length) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                const labels = timeline.map(t => t.date);
                const netRevs = timeline.map(t => (t.net_revenue || 0) / 1e6);
                const orders = timeline.map(t => t.orders_count || 0);

                salesWaveChartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Doanh Thu Thuần (Tr. VNĐ)',
                                data: netRevs,
                                borderColor: '#75BFB2',
                                backgroundColor: 'rgba(117, 191, 178, 0.35)',
                                borderWidth: 3,
                                fill: true,
                                tension: 0.35,
                                pointRadius: 4,
                                pointBackgroundColor: '#75BFB2',
                                yAxisID: 'y'
                            },
                            {
                                label: 'Số Lượng Đơn',
                                data: orders,
                                borderColor: '#D991A4',
                                backgroundColor: 'rgba(217, 145, 164, 0.45)',
                                borderWidth: 2,
                                borderDash: [4, 4],
                                pointRadius: 4,
                                pointBackgroundColor: '#D991A4',
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                        },
                        scales: {
                            x: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 } }, grid: { display: false } },
                            y: { position: 'left', ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } },
                            y1: { position: 'right', ticks: { color: '#D991A4', font: { family: 'Plus Jakarta Sans', size: 10 }, stepSize: 1 }, grid: { display: false } }
                        }
                    }
                });
                return;
            }

            if (currentAngle === 'REGION') {
                const regions = data?.region_breakdown || [];
                if (!regions.length) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                salesWaveChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: regions.map(r => `${r.region} (${r.revenue_share_pct}%)`),
                        datasets: [{
                            data: regions.map(r => (r.net_revenue || 0) / 1e6),
                            backgroundColor: [
                                '#75BFB2',
                                '#D991A4',
                                '#B8D9D3',
                                '#D9A3AC',
                                '#203833'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                        }
                    }
                });
                return;
            }

            if (currentAngle === 'COST_STRUCTURE') {
                const kpis = data?.financial_kpis || {};
                const costLabels = [];
                const costVals = [];
                const costColors = [];
                if (kpis.total_cogs > 0) { costLabels.push('Giá Vốn (COGS)'); costVals.push(kpis.total_cogs / 1e6); costColors.push('#D9A3AC'); }
                if (kpis.total_discount_amount > 0) { costLabels.push('Chiết Khấu'); costVals.push(kpis.total_discount_amount / 1e6); costColors.push('#D991A4'); }
                if (kpis.total_campaign_costs > 0) { costLabels.push('Chi Phí MKT'); costVals.push(kpis.total_campaign_costs / 1e6); costColors.push('#B8D9D3'); }
                if (kpis.total_contribution_margin > 0) { costLabels.push('Biên Đóng Góp (CM)'); costVals.push(kpis.total_contribution_margin / 1e6); costColors.push('#75BFB2'); }

                salesWaveChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: costLabels,
                        datasets: [{ data: costVals, backgroundColor: costColors, borderWidth: 2, borderColor: '#ffffff' }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } } }
                    }
                });
                return;
            }

            if (currentAngle === 'CATEGORY') {
                const categories = data?.category_breakdown || [];
                if (!categories.length) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    return;
                }
                salesWaveChartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: categories.map(c => c.category),
                        datasets: [
                            { label: 'Doanh Thu Thuần (Tr. VNĐ)', data: categories.map(c => (c.net_revenue || 0) / 1e6), backgroundColor: '#75BFB2', borderRadius: 6 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } } },
                        scales: {
                            x: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10, weight: 'bold' } }, grid: { display: false } },
                            y: { ticks: { font: { family: 'Plus Jakarta Sans', size: 10 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                        }
                    }
                });
                return;
            }

            // Default: CAMPAIGN Angle
            let pnl = (data && data.pnl_table ? data.pnl_table : []).filter(p => p.campaign_id !== 'ORGANIC');
            if (!pnl.length) {
                pnl = (data && data.pnl_table ? data.pnl_table : []);
            }
            if (!pnl.length) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                return;
            }

            const labels = pnl.map(x => x.campaign_name);
            const netRevenues = pnl.map(x => x.net_revenue / 1e6);
            const contributionMargins = pnl.map(x => x.contribution_margin / 1e6);

            const tealGradient = ctx.createLinearGradient(0, 0, 0, 250);
            tealGradient.addColorStop(0, 'rgba(117, 191, 178, 0.40)');
            tealGradient.addColorStop(1, 'rgba(117, 191, 178, 0.0)');

            const roseGradient = ctx.createLinearGradient(0, 0, 0, 250);
            roseGradient.addColorStop(0, 'rgba(217, 145, 164, 0.45)');
            roseGradient.addColorStop(1, 'rgba(217, 145, 164, 0.0)');

            salesWaveChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh Thu Thuần (Triệu VNĐ)',
                            data: netRevenues,
                            borderColor: '#75BFB2',
                            backgroundColor: tealGradient,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.45,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#75BFB2',
                            pointBorderWidth: 2,
                            pointRadius: 5
                        },
                        {
                            label: 'Biên Đóng Góp CM (Triệu VNĐ)',
                            data: contributionMargins,
                            borderColor: '#D991A4',
                            backgroundColor: roseGradient,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.45,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#D991A4',
                            pointBorderWidth: 2,
                            pointRadius: 5
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' } } }
                    },
                    scales: {
                        x: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 } }, grid: { display: false } },
                        y: { ticks: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 10 }, callback: v => v + ' tr' }, grid: { color: '#f1f5f9' } }
                    }
                }
            });
        }

        // Markdown formatter for Copilot
        function renderMarkdownToHtml(mdText) {
            if (!mdText) return '';
            let html = mdText
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            html = html.replace(/^### (.*$)/gim, '<h4 class="font-bold text-[#203833] mt-2.5 mb-1">$1</h4>');
            html = html.replace(/^## (.*$)/gim, '<h3 class="font-extrabold text-[#203833] mt-3 mb-1.5 text-sm">$1</h3>');
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-slate-900">$1</strong>');
            html = html.replace(/`([^`]+)`/g, '<code class="bg-[#F2E5E4] text-[#203833] px-1.5 py-0.5 rounded text-[11px] font-mono border border-[#B8D9D3]/60">$1</code>');
            html = html.replace(/^\s*(\d+)\.\s+(.*$)/gim, '<div class="flex items-start gap-1.5 my-1"><span class="font-bold text-[#203833] min-w-[20px]">$1.</span><span>$2</span></div>');
            html = html.replace(/^\s*[-*]\s+(.*$)/gim, '<div class="flex items-start gap-1.5 my-0.5"><span class="text-[#203833] font-bold">•</span><span>$1</span></div>');
            html = html.replace(/\n\n/g, '<div class="h-2"></div>');
            html = html.replace(/\n/g, '<br>');
            return html;
        }

        function sendCopilotQueryDirect(q) {
            const input = document.getElementById('copilotInput');
            if (input) {
                input.value = q;
                sendCopilotQuery();
            }
        }

        // Gemini Copilot Query
        async function sendCopilotQuery() {
            const input = document.getElementById('copilotInput');
            const query = input.value.trim();
            if (!query) return;

            const chatBox = document.getElementById('copilotMessages');
            const userMsg = document.createElement('div');
            userMsg.className = 'p-3 bg-[#203833] text-white rounded-2xl max-w-[80%] ml-auto text-xs font-medium shadow-xs';
            userMsg.innerText = query;
            chatBox.appendChild(userMsg);
            input.value = '';

            const loadingMsg = document.createElement('div');
            loadingMsg.className = 'p-3 bg-white text-[#203833] rounded-2xl border border-[#B8D9D3]/60 text-xs flex items-center gap-2 shadow-xs';
            loadingMsg.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-[#203833]"></i> Gemini đang phân tích dữ liệu và suy nghĩ câu trả lời...`;
            chatBox.appendChild(loadingMsg);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: query })
                });
                const data = await res.json().catch(() => ({}));
                const answerText = data.answer || data.error || "Hệ thống đang bận phân tích, vui lòng gửi lại câu hỏi.";
                loadingMsg.className = 'p-3.5 bg-white text-slate-700 rounded-2xl border border-slate-100 text-xs shadow-xs max-w-[85%]';
                loadingMsg.innerHTML = `
                    <div class="flex items-center gap-2 mb-1.5 pb-1 border-b border-slate-100">
                        <i class="fa-solid fa-wand-magic-sparkles text-[#75BFB2]"></i>
                        <strong class="text-[#203833] font-bold text-xs">Gemini AI Cố Vấn:</strong>
                    </div>
                    <div class="leading-relaxed text-slate-700">
                        ${renderMarkdownToHtml(answerText)}
                    </div>`;
            } catch (err) {
                loadingMsg.className = 'p-3 bg-[#F2E5E4] rounded-2xl border border-[#D9A3AC] text-[#872D43] text-xs shadow-xs max-w-[85%]';
                loadingMsg.innerHTML = `
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-circle-exclamation text-[#872D43]"></i>
                            <span>Máy chủ đang bận xử lý. Bạn có thể nhấn để thử lại ngay.</span>
                        </div>
                        <button onclick="sendCopilotQueryDirect('${query.replace(/'/g, "\\'")}')" class="px-2.5 py-1 bg-[#D991A4] hover:bg-[#872D43] text-white font-medium rounded-lg text-[11px] shrink-0 transition">
                            Thử lại
                        </button>
                    </div>`;
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        // Standalone Exports
        function exportHtmlPnL() {
            window.location.href = '/api/export_html_pnl';
        }

        function exportHtmlDashboard() {
            window.location.href = '/api/export_html_dashboard';
        }

        function exportExcel() {
            window.location.href = '/api/export_excel';
        }

        function exportJSON() {
            window.location.href = '/api/export_json';
        }

        function signAndLockReport() {
            const signed = document.getElementById('signApproval').checked;
            if (!signed) {
                alert('Vui lòng tích chọn ô xác nhận trước khi duyệt khóa báo cáo.');
                return;
            }
            const pill = document.getElementById('signStatusPill');
            if (pill) pill.classList.remove('hidden');
            showToast('✅ Báo cáo P&L đã được THU HÀ KÝ DUYỆT THÀNH CÔNG và lưu vào Nhật ký Audit Trail!');
        }

        // ===================================================================
        // AI COPILOT SMART ANGLES CONTROLLER & MODAL
        // ===================================================================
        function triggerAiSmartAngleAnalysis() {
            if (!lastApiResponse || !lastApiResponse.pnl_table || lastApiResponse.pnl_table.length === 0) {
                showToast("⚠️ Vui lòng tải dữ liệu và nhấn 'Đồng ý với các hướng giải quyết làm sạch' trước khi chạy phân tích AI!", "warning");
                goToStep(1);
                return;
            }

            renderAiSmartModalContent(lastApiResponse);
            
            const modal = document.getElementById('modalAiSmartAnalysis');
            if (modal) {
                modal.classList.remove('hidden');
            }
            showToast("✨ AI đã kích hoạt toàn diện các góc nhìn phân tích phù hợp!", "success");
        }

        function closeAiSmartModal() {
            const modal = document.getElementById('modalAiSmartAnalysis');
            if (modal) {
                modal.classList.add('hidden');
            }
        }

        function runAiOverviewNow() {
            closeAiSmartModal();
            switchAnalysisAngle('OVERVIEW');
            showToast("📊 Đang hiển thị Toàn bộ các Biểu Đồ Phân Tích Đa Chiều!", "info");
            setTimeout(() => {
                const target = document.getElementById('multiChartOverviewContainer') || document.getElementById('salesWaveContainer');
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 150);
        }

        function selectAngleFromModal(angle) {
            closeAiSmartModal();
            switchAnalysisAngle(angle);
            showToast(`🎯 Chuyển sang góc nhìn phân tích: ${angle}`, "info");
            setTimeout(() => {
                const target = document.getElementById('singleAngleChartContainer') || document.getElementById('salesWaveContainer');
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 150);
        }

        function renderAiSmartModalContent(data) {
            if (!data) return;
            const container = document.getElementById('aiModalCardsContainer');
            if (!container) return;

            const channels = (data.channel_breakdown || []).filter(c => c && c.channel && c.channel !== 'Unknown');
            const products = (data.product_breakdown || []).filter(p => p && p.product_id);
            const timeline = (data.timeline_breakdown || []).filter(t => t && t.date);
            const regions = (data.region_breakdown || []).filter(r => r && r.region && r.region !== 'None');
            const campaigns = (data.pnl_table || []).filter(p => p && p.campaign_id !== 'ORGANIC');
            const categories = (data.category_breakdown || []).filter(c => c && c.category);
            const kpis = data.financial_kpis || {};
            const hasCosts = (kpis.total_cogs > 0 || kpis.total_discount_amount > 0 || kpis.total_campaign_costs > 0) && kpis.total_gross_revenue > 0;

            const modalAngles = [];

            if (channels.length > 1) {
                const topCh = [...channels].sort((a,b) => (b.net_revenue||0) - (a.net_revenue||0))[0];
                modalAngles.push({
                    id: 'CHANNEL',
                    name: 'Kênh Bán (Omnichannel)',
                    icon: 'fa-solid fa-store text-[#203833]',
                    bg: 'bg-[#B8D9D3]/30/70 border-[#B8D9D3]/90 hover:border-[#75BFB2]',
                    btnBg: 'bg-[#75BFB2] hover:bg-[#203833]',
                    desc: `Phân tích <b>${channels.length}</b> kênh bán. Dẫn đầu: <b>${topCh.channel}</b> (${formatVND(topCh.net_revenue)} DT thuần, ${topCh.orders_count || 0} đơn).`
                });
            }

            if (products.length > 1) {
                const topProd = [...products].sort((a,b) => (b.net_revenue||0) - (a.net_revenue||0))[0];
                modalAngles.push({
                    id: 'PRODUCT',
                    name: 'Sản Phẩm (Pareto 80/20)',
                    icon: 'fa-solid fa-box-open text-[#872D43]',
                    bg: 'bg-[#F2E5E4]/70 border-[#D9A3AC]/90 hover:border-[#D991A4]',
                    btnBg: 'bg-[#D991A4] hover:bg-[#872D43]',
                    desc: `Theo dõi <b>${products.length}</b> SKU. Top 1: <b>${topProd.product_id}</b> (${formatVND(topProd.net_revenue)} DT thuần, ${topProd.quantity_sold || 0} SP).`
                });
            }

            if (regions.length > 1) {
                const topReg = [...regions].sort((a,b) => (b.net_revenue||0) - (a.net_revenue||0))[0];
                modalAngles.push({
                    id: 'REGION',
                    name: 'Khu Vực (Địa Bàn)',
                    icon: 'fa-solid fa-map-location-dot text-[#203833]',
                    bg: 'bg-[#B8D9D3]/30/70 border-[#B8D9D3]/90 hover:border-[#75BFB2]',
                    btnBg: 'bg-[#75BFB2] hover:bg-[#5EABA0]',
                    desc: `Phân phối <b>${regions.length}</b> khu vực. Thị phần cao nhất: <b>${topReg.region}</b> (${formatVND(topReg.net_revenue)} DT, ${topReg.revenue_share_pct}% thị phần).`
                });
            }

            if (timeline.length > 1) {
                const topDay = [...timeline].sort((a,b) => (b.net_revenue||0) - (a.net_revenue||0))[0];
                modalAngles.push({
                    id: 'TIMELINE',
                    name: 'Dòng Thời Gian (Daily Trend)',
                    icon: 'fa-solid fa-calendar-days text-[#872D43]',
                    bg: 'bg-[#F2E5E4]/70 border-[#D9A3AC]/90 hover:border-[#D991A4]',
                    btnBg: 'bg-[#D991A4] hover:bg-[#872D43]',
                    desc: `Ghi nhận <b>${timeline.length}</b> mốc thời gian. Ngày đỉnh điểm: <b>${topDay.date}</b> (${formatVND(topDay.net_revenue)}).`
                });
            }

            if (campaigns.length > 1) {
                const topCamp = [...campaigns].sort((a,b) => (b.contribution_margin||0) - (a.contribution_margin||0))[0];
                modalAngles.push({
                    id: 'CAMPAIGN',
                    name: 'Chiến Dịch (Campaign P&L)',
                    icon: 'fa-solid fa-bullhorn text-[#203833]',
                    bg: 'bg-[#B8D9D3]/40 border-[#B8D9D3]/90 hover:border-[#B8D9D3]',
                    btnBg: 'bg-[#203833] hover:bg-[#203833]',
                    desc: `Bao gồm <b>${campaigns.length}</b> chiến dịch. Lợi nhuận cao nhất: <b>${topCamp.campaign_name}</b> (CM: ${formatVND(topCamp.contribution_margin)}).`
                });
            }

            if (hasCosts) {
                modalAngles.push({
                    id: 'COST_STRUCTURE',
                    name: 'Cơ Cấu Chi Phí & Giá Vốn',
                    icon: 'fa-solid fa-chart-pie text-[#D991A4]',
                    bg: 'bg-[#F2E5E4]/70 border-[#D991A4]/90 hover:border-[#D991A4]',
                    btnBg: 'bg-[#D991A4] hover:bg-[#872D43]',
                    desc: `Giá vốn COGS: <b>${formatVND(kpis.total_cogs||0)}</b> • Chiết khấu: <b>${formatVND(kpis.total_discount_amount||0)}</b> • Lợi nhuận CM: <b>${formatVND(kpis.total_contribution_margin||0)}</b>.`
                });
            }

            if (categories.length > 1) {
                modalAngles.push({
                    id: 'CATEGORY',
                    name: 'Ngành Hàng (Category)',
                    icon: 'fa-solid fa-layer-group text-teal-600',
                    bg: 'bg-teal-50/70 border-teal-200/90 hover:border-teal-300',
                    btnBg: 'bg-teal-600 hover:bg-teal-700',
                    desc: `Phân loại <b>${categories.length}</b> ngành hàng. Dẫn đầu: <b>${categories[0].category}</b> (${formatVND(categories[0].net_revenue)}).`
                });
            }

            const totalActive = modalAngles.length;

            const statusTextEl = document.getElementById('aiModalStatusText');
            if (statusTextEl) {
                statusTextEl.innerText = `AI đã tự động kích hoạt ${totalActive} góc nhìn phân tích chuyên sâu phù hợp nhất với dữ liệu`;
            }
            const activeBadgeEl = document.getElementById('aiModalActiveBadge');
            if (activeBadgeEl) {
                activeBadgeEl.innerText = `${totalActive} Góc Nhìn Kích Hoạt`;
            }

            container.innerHTML = modalAngles.map(a => `
                <div class="p-4 rounded-2xl ${a.bg} border flex flex-col justify-between transition">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-slate-900 text-xs flex items-center gap-1.5">
                            <i class="${a.icon}"></i> ${a.name}
                        </span>
                        <span class="px-2 py-0.5 rounded-full bg-[#B8D9D3]/40 text-[#203833] text-[10px] font-black flex items-center gap-1">
                            <i class="fa-solid fa-circle-check text-[9px]"></i> Kích hoạt
                        </span>
                    </div>
                    <p class="text-xs text-slate-600 mb-2">${a.desc}</p>
                    <button type="button" onclick="selectAngleFromModal('${a.id}')" class="btn-smooth w-full py-2 px-3 rounded-xl ${a.btnBg} text-white font-bold text-xs flex items-center justify-center gap-1.5 cursor-pointer shadow-xs">
                        <i class="fa-solid fa-chart-column"></i> Xem Góc Nhìn Này
                    </button>
                </div>
            `).join('');
        }

        // ===================================================================
        // DATALENS STUDIO SUITE: CONTEXTUAL QA, METADATA, GROUP COMPARISON & PROFILER
        // ===================================================================
        function renderContextualQA(data) {
            const container = document.getElementById('contextualQaContainer');
            if (!container) return;
            const qas = data?.contextual_qa || [];
            if (!qas.length) {
                container.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-300 block mb-2"></i>
                        Chưa có dữ liệu. Vui lòng tải tệp Excel hoặc CSV lên ở Bước 1 để AI tự động khám phá và trả lời các câu hỏi kinh doanh.
                    </div>
                `;
                return;
            }
            container.innerHTML = qas.map(q => `
                <div class="p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 space-y-1.5">
                    <div class="text-xs font-black text-slate-900 flex items-center gap-2">
                        <i class="fa-solid ${q.icon || 'fa-circle-question text-[#203833]'}"></i>
                        <span>${q.question}</span>
                    </div>
                    <div class="text-xs text-slate-600 space-y-1 pl-5">
                        ${q.bullets.map(b => `<p class="leading-relaxed">• ${b}</p>`).join('')}
                    </div>
                </div>
            `).join('');
        }

        function renderDatasetMeta(data) {
            if (!data) return;
            const meta = data.dataset_meta || {};
            const totalRows = meta.total_rows || (data.cleaned_orders_table?.length || 0);
            const totalCols = meta.total_cols || (data.column_profiling?.length || 0);
            const numCols = meta.numeric_cols_count || 0;

            const elRows = document.getElementById('statTotalRows');
            if (elRows) elRows.innerText = totalRows > 0 ? totalRows.toLocaleString('vi-VN') : '0';

            const elCols = document.getElementById('statTotalCols');
            if (elCols) elCols.innerText = totalCols;

            const elNum = document.getElementById('statNumericCols');
            if (elNum) elNum.innerText = numCols;

            const selectOpt = document.getElementById('datasetSelectOption');
            const subtitle = document.getElementById('ctxQaSubtitle');

            if (totalRows === 0) {
                if (selectOpt) selectOpt.innerText = '-- Chưa tải tệp dữ liệu --';
                if (subtitle) subtitle.innerText = 'Chờ tải tệp dữ liệu...';
            } else {
                const name = meta.dataset_name || (uploadedFileName ? `Bộ 1 — ${uploadedFileName} (${totalRows.toLocaleString('vi-VN')} dòng)` : `Bộ 1 (${totalRows.toLocaleString('vi-VN')} dòng)`);
                if (selectOpt) selectOpt.innerText = name;
                if (subtitle) subtitle.innerText = `${name} • 1 bộ dữ liệu (${totalRows.toLocaleString('vi-VN')} dòng)`;
            }
        }

        function onDatasetDropdownChange() {
            showToast('Đang chọn: ' + (document.getElementById('datasetSelectDropdown')?.value || 'Bộ 1'), 'info');
        }

        // Chuẩn hóa & ép kiểu số thực an toàn cho mọi định dạng (185.500.000, 185,500,000, 185500000)
        function parseSafeNum(val) {
            if (val === null || val === undefined) return 0;
            if (typeof val === 'number') return isNaN(val) ? 0 : val;
            let s = String(val).trim();
            if (!s) return 0;
            s = s.replace(/[₫đĐVNDvnd\s]/g, '');
            if (/^\d{1,3}(\.\d{3})+(,\d+)?$/.test(s)) {
                s = s.replace(/\./g, '').replace(',', '.');
            } else if (/^\d{1,3}(,\d{3})+(\.\d+)?$/.test(s)) {
                s = s.replace(/,/g, '');
            } else {
                s = s.replace(/,/g, '');
            }
            const n = parseFloat(s);
            return isNaN(n) ? 0 : n;
        }

        // Lấy giá trị số của bản ghi theo tên cột hoặc các bí danh kế toán (Aliases)
        function getRowMetricValue(r, metricKey) {
            if (!r) return 0;
            if (r[metricKey] !== undefined && r[metricKey] !== null) {
                const n = parseSafeNum(r[metricKey]);
                if (n !== 0) return n;
            }
            const keyLower = String(metricKey).toLowerCase();

            // Doanh thu (Gross & Net Revenue)
            if (keyLower.includes('doanh thu') || keyLower.includes('revenue') || keyLower.includes('gross') || keyLower.includes('tiền') || keyLower.includes('thành tiền')) {
                for (const k of ['gross_revenue', 'gross_amount', 'net_revenue', 'attributed_net_rev', 'attributed_gross', 'Doanh thu (VND)', 'Doanh thu', 'thành_tiền', 'doanh_thu']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
            }

            // Giá vốn & Chi phí (COGS / Costs)
            if (keyLower.includes('cogs') || keyLower.includes('giá vốn') || keyLower.includes('gia_von') || keyLower.includes('chi phí') || keyLower.includes('cost')) {
                for (const k of ['cogs', 'attributed_cogs', 'total_cogs', 'unit_cogs', 'Chi phí giá vốn (VND)', 'giá vốn', 'gia_von', 'chi_phi_gia_von']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
            }

            // Lợi nhuận (Gross Profit & Contribution Margin)
            if (keyLower.includes('lợi nhuận') || keyLower.includes('profit') || keyLower.includes('margin') || keyLower.includes('cm')) {
                for (const k of ['gross_profit', 'contribution_margin', 'Lợi nhuận gộp (VND)', 'loi_nhuan_gop', 'loi_nhuan']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
            }

            // Chiết khấu (Discount)
            if (keyLower.includes('chiết khấu') || keyLower.includes('discount') || keyLower.includes('voucher') || keyLower.includes('giảm')) {
                for (const k of ['discount_amount', 'attributed_discount', 'Chiết khấu (VND)', 'chiet_khau']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
            }

            // Hàng bán trả (Returns)
            if (keyLower.includes('hoàn') || keyLower.includes('trả') || keyLower.includes('return')) {
                for (const k of ['return_amount', 'attributed_return', 'Hàng bán trả (VND)', 'hang_ban_tra']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
            }

            // Số lượng đơn / sản phẩm (Quantity)
            if (keyLower.includes('số đơn') || keyLower.includes('số lượng') || keyLower.includes('quantity') || keyLower.includes('qty')) {
                for (const k of ['quantity', 'Số đơn', 'so_luong', 'so_don']) {
                    if (r[k] !== undefined && r[k] !== null) {
                        const v = parseSafeNum(r[k]);
                        if (v !== 0) return v;
                    }
                }
                return 1;
            }

            // Match case-insensitive
            for (const [k, v] of Object.entries(r)) {
                if (k.toLowerCase() === keyLower && v !== undefined && v !== null) {
                    return parseSafeNum(v);
                }
            }
            return 0;
        }

        // Lấy tên nhóm phân loại của bản ghi theo cột hoặc các bí danh
        function getRowDimValue(r, dimKey) {
            if (!r) return 'Chưa phân nhóm';
            if (r[dimKey] !== undefined && r[dimKey] !== null && String(r[dimKey]).trim() !== '' && String(r[dimKey]).trim().toLowerCase() !== 'none') {
                return String(r[dimKey]).trim();
            }
            const keyLower = String(dimKey).toLowerCase();

            // Khu vực / Vùng miền
            if (keyLower.includes('khu vực') || keyLower.includes('region') || keyLower.includes('miền') || keyLower.includes('vùng')) {
                for (const k of ['region', 'Khu vực', 'khu_vuc', 'vung_mien', 'khuvuc', 'mien']) {
                    if (r[k] !== undefined && r[k] !== null && String(r[k]).trim() !== '' && String(r[k]).trim().toLowerCase() !== 'none') {
                        return String(r[k]).trim();
                    }
                }
            }

            // Kênh bán hàng
            if (keyLower.includes('kênh') || keyLower.includes('channel') || keyLower.includes('sàn') || keyLower.includes('store')) {
                for (const k of ['channel', 'Kênh', 'kenh', 'kenh_ban', 'kênh bán', 'sàn']) {
                    if (r[k] !== undefined && r[k] !== null && String(r[k]).trim() !== '') {
                        return String(r[k]).trim();
                    }
                }
            }

            // Sản phẩm / SKU
            if (keyLower.includes('sản phẩm') || keyLower.includes('product') || keyLower.includes('sku') || keyLower.includes('hàng')) {
                for (const k of ['product_name', 'product_id', 'Sản phẩm', 'san_pham', 'ten_sp', 'sku']) {
                    if (r[k] !== undefined && r[k] !== null && String(r[k]).trim() !== '') {
                        return String(r[k]).trim();
                    }
                }
            }

            // Thời gian / Ngày / Tháng
            if (keyLower.includes('thời gian') || keyLower.includes('date') || keyLower.includes('ngày') || keyLower.includes('tháng')) {
                for (const k of ['date', 'Tháng', 'thang', 'ngay', 'date_str']) {
                    if (r[k] !== undefined && r[k] !== null && String(r[k]).trim() !== '') {
                        return String(r[k]).trim();
                    }
                }
            }

            // Chiến dịch
            if (keyLower.includes('chiến dịch') || keyLower.includes('campaign')) {
                for (const k of ['campaign_id', 'Chiến dịch', 'campaign_name', 'chien_dich']) {
                    if (r[k] !== undefined && r[k] !== null && String(r[k]).trim() !== '') {
                        return String(r[k]).trim();
                    }
                }
            }

            // Match case-insensitive
            for (const [k, v] of Object.entries(r)) {
                if (k.toLowerCase() === keyLower && v !== undefined && v !== null && String(v).trim() !== '') {
                    return String(v).trim();
                }
            }
            return 'Chưa phân nhóm';
        }

        // Tự động phân loại cột dạng phân nhóm và cột số theo bộ dữ liệu thực tế tải lên
        function setupDynamicGroupSelects(data) {
            const dimSelect = document.getElementById('grpDimSelect');
            const metricSelect = document.getElementById('grpMetricSelect');
            if (!dimSelect || !metricSelect) return;

            const profCols = data.column_profiling || [];
            let dimCols = [];
            let numCols = [];

            if (profCols.length > 0) {
                const seenDim = new Set();
                const seenNum = new Set();
                profCols.forEach(c => {
                    const nameKey = (c.column_name || c.column_key).trim().toLowerCase();
                    if (c.data_type === 'Số') {
                        if (!seenNum.has(nameKey)) {
                            seenNum.add(nameKey);
                            numCols.push({ key: c.column_key, name: c.column_name });
                        }
                    } else {
                        if (!seenDim.has(nameKey)) {
                            seenDim.add(nameKey);
                            dimCols.push({ key: c.column_key, name: c.column_name });
                        }
                    }
                });
            } else {
                const sample = (data.cleaned_orders_table && data.cleaned_orders_table[0]) || {};
                Object.keys(sample).forEach(k => {
                    if (typeof sample[k] === 'number') {
                        numCols.push({ key: k, name: k });
                    } else {
                        dimCols.push({ key: k, name: k });
                    }
                });
            }

            const curDim = dimSelect.value;
            const curMetric = metricSelect.value;

            if (dimCols.length > 0) {
                dimSelect.innerHTML = dimCols.map(c => 
                    `<option value="${c.key}">${c.name}</option>`
                ).join('');
                if (dimCols.some(c => c.key === curDim)) {
                    dimSelect.value = curDim;
                } else {
                    const preferred = dimCols.find(c => ['region', 'Khu vực', 'channel', 'Kênh', 'product_id', 'product_name', 'campaign_id'].includes(c.key));
                    dimSelect.value = preferred ? preferred.key : dimCols[0].key;
                }
            } else {
                dimSelect.innerHTML = `<option value="">-- Không có cột phân loại --</option>`;
            }

            if (numCols.length > 0) {
                metricSelect.innerHTML = numCols.map(c => 
                    `<option value="${c.key}">${c.name}</option>`
                ).join('');
                if (numCols.some(c => c.key === curMetric)) {
                    metricSelect.value = curMetric;
                } else {
                    const preferred = numCols.find(c => ['gross_revenue', 'Doanh thu (VND)', 'net_revenue', 'cogs', 'gross_profit'].includes(c.key));
                    metricSelect.value = preferred ? preferred.key : numCols[0].key;
                }
            } else {
                metricSelect.innerHTML = `<option value="">-- Không có cột số --</option>`;
            }
        }

        function renderGroupComparison() {
            if (!lastApiResponse) return;
            const dim = document.getElementById('grpDimSelect')?.value;
            const agg = document.getElementById('grpAggSelect')?.value || 'sum';
            const metric = document.getElementById('grpMetricSelect')?.value;

            const barsContainer = document.getElementById('groupBarsContainer');
            if (!barsContainer) return;

            if (!dim || !metric) {
                barsContainer.innerHTML = `
                    <div class="p-8 bg-slate-50 border border-slate-200/80 rounded-2xl text-center text-slate-400 italic text-xs">
                        <i class="fa-solid fa-chart-simple text-2xl text-slate-300 block mb-2"></i>
                        Chưa có dữ liệu. Vui lòng tải tệp để AI tự động tổng hợp và so sánh theo từng nhóm.
                    </div>
                `;
                return;
            }

            const records = (lastApiResponse.cleaned_orders_table && lastApiResponse.cleaned_orders_table.length > 0)
                ? lastApiResponse.cleaned_orders_table
                : (lastApiResponse.pnl_table || []);

            if (!records.length) {
                barsContainer.innerHTML = `<div class="p-6 text-center text-slate-400 italic text-xs">Chưa có dữ liệu để tổng hợp theo nhóm.</div>`;
                return;
            }

            const dimSelectEl = document.getElementById('grpDimSelect');
            const dimLabel = (dimSelectEl && dimSelectEl.options[dimSelectEl.selectedIndex]?.text) || dim;
            const metricSelectEl = document.getElementById('grpMetricSelect');
            const metricLabel = (metricSelectEl && metricSelectEl.options[metricSelectEl.selectedIndex]?.text) || metric;
            const aggLabels = {
                sum: 'tổng',
                avg: 'trung bình',
                count: 'số lượng đơn/dòng',
                max: 'giá trị lớn nhất',
                min: 'giá trị nhỏ nhất'
            };

            const groups = {};
            const allMetricValues = [];

            records.forEach(r => {
                const groupKey = getRowDimValue(r, dim);
                const val = getRowMetricValue(r, metric);
                allMetricValues.push(val);

                if (!groups[groupKey]) {
                    groups[groupKey] = [];
                }
                groups[groupKey].push(val);
            });

            const groupResults = [];
            for (const [key, vals] of Object.entries(groups)) {
                let aggVal = 0;
                if (agg === 'sum') {
                    aggVal = vals.reduce((a, b) => a + b, 0);
                } else if (agg === 'avg') {
                    aggVal = vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : 0;
                } else if (agg === 'count') {
                    aggVal = vals.length;
                } else if (agg === 'max') {
                    aggVal = Math.max(...vals);
                } else if (agg === 'min') {
                    aggVal = Math.min(...vals);
                }
                groupResults.push({ name: key, val: aggVal, count: vals.length });
            }

            groupResults.sort((a, b) => b.val - a.val);
            const maxVal = Math.max(...groupResults.map(g => g.val), 1);
            const totalAggSum = groupResults.reduce((acc, cur) => acc + cur.val, 0);

            const metricLower = (metric + ' ' + metricLabel).toLowerCase();
            const isCurrency = metricLower.includes('vnd') || metricLower.includes('doanh thu') || metricLower.includes('tiền') || metricLower.includes('cogs') || metricLower.includes('chi phí') || metricLower.includes('giá') || metricLower.includes('revenue') || metricLower.includes('cost') || metricLower.includes('lợi nhuận') || metricLower.includes('profit') || metricLower.includes('chiết khấu') || metricLower.includes('discount') || metricLower.includes('đơn giá');
            const formatMetricVal = (val) => {
                if (agg === 'count' || metricLower.includes('số lượng') || metricLower.includes('quantity') || metricLower.includes('số đơn')) {
                    return `${Math.round(val).toLocaleString('vi-VN')} đơn/dòng`;
                }
                return isCurrency ? formatVND(val) : val.toLocaleString('vi-VN', { maximumFractionDigits: 2 });
            };

            barsContainer.innerHTML = groupResults.map(g => {
                const pct = Math.max(6, Math.min(100, Math.round((g.val / maxVal) * 100)));
                return `
                    <div class="flex items-center gap-4 text-xs">
                        <div class="w-32 sm:w-40 font-semibold text-slate-700 truncate text-left" title="${g.name}">
                            ${g.name}
                        </div>
                        <div class="flex-1 h-3.5 bg-slate-100 rounded-full overflow-hidden flex items-center p-0.5">
                            <div class="h-full bg-[#75BFB2] rounded-full transition-all duration-500" style="width: ${pct}%"></div>
                        </div>
                        <div class="w-28 sm:w-36 text-right font-mono font-bold text-slate-900 shrink-0">
                            ${formatMetricVal(g.val)}
                        </div>
                    </div>
                `;
            }).join('');

            const caption = document.getElementById('grpSubtextCaption');
            if (caption) {
                caption.innerText = `${groupResults.length} nhóm theo giá trị giảm dần.`;
            }

            // Nhận xét tự động kết hợp AI (AI Automated Insights)
            const insightsContainer = document.getElementById('grpAutoInsightsList');
            if (insightsContainer) {
                const topGroup = groupResults[0] || { name: 'Nhóm', val: 0 };
                const bottomGroup = groupResults[groupResults.length - 1] || topGroup;
                const formattedTop = formatMetricVal(topGroup.val);
                const sharePct = (totalAggSum > 0 && agg === 'sum') ? ((topGroup.val / totalAggSum) * 100).toFixed(1) : null;
                const ratioDiff = (bottomGroup.val > 0 && topGroup.val > bottomGroup.val) ? (topGroup.val / bottomGroup.val).toFixed(1) : null;

                const minMetricVal = allMetricValues.length ? Math.min(...allMetricValues) : 0;
                const maxMetricVal = allMetricValues.length ? Math.max(...allMetricValues) : 0;
                const avgMetricVal = allMetricValues.length ? (allMetricValues.reduce((a,b)=>a+b,0) / allMetricValues.length) : 0;
                
                const fmtMin = formatMetricVal(minMetricVal);
                const fmtMax = formatMetricVal(maxMetricVal);
                const fmtAvg = formatMetricVal(avgMetricVal);

                const missingCount = lastApiResponse.column_profiling ? (lastApiResponse.column_profiling.find(c => c.column_key === dim && c.missing_count > 0)?.missing_count || 0) : 0;
                const totalRows = lastApiResponse.dataset_meta?.total_rows || records.length;

                let strategicAdvice = "";
                if (isCurrency && (metricLower.includes('doanh thu') || metricLower.includes('revenue'))) {
                    strategicAdvice = `Nhóm "<b>${topGroup.name}</b>" đóng vai trò động lực tăng trưởng cốt lõi. Khuyến nghị duy trì năng lực phục vụ tại nhóm này và thiết kế chiến dịch kích cầu đối ứng cho "<b>${bottomGroup.name}</b>".`;
                } else if (metricLower.includes('chi phí') || metricLower.includes('cost') || metricLower.includes('cogs')) {
                    strategicAdvice = `Nhóm "<b>${topGroup.name}</b>" đang chiếm tỷ trọng chi phí cao nhất. Cần rà soát các hợp đồng nhà cung cấp hoặc tiêu thức phân bổ chiết khấu để bảo vệ biên lợi nhuận ròng.`;
                } else {
                    strategicAdvice = `Mức độ tập trung của "<b>${metricLabel}</b>" dồn về "<b>${topGroup.name}</b>". Khuyến nghị mở rộng đối tượng mục tiêu để tránh rủi ro phụ thuộc vào một phân khúc đơn lẻ.`;
                }

                insightsContainer.innerHTML = `
                    <div class="space-y-2">
                        <p class="leading-relaxed">
                            <i class="fa-solid fa-crown text-[#D991A4] mr-1.5"></i>
                            Nhóm "<b>${topGroup.name}</b>" dẫn đầu về ${aggLabels[agg]} của "<b>${metricLabel}</b>" đạt <b>${formattedTop}</b>${sharePct ? ` (chiếm <b>${sharePct}%</b> tổng quy mô toàn bộ ${groupResults.length} nhóm)` : ''}.
                        </p>
                        <p class="leading-relaxed">
                            <i class="fa-solid fa-chart-line text-[#203833] mr-1.5"></i>
                            Biên độ phân tán từ <b>${fmtMin}</b> đến <b>${fmtMax}</b>, giá trị trung bình là <b>${fmtAvg}</b>.${ratioDiff ? ` Nhóm dẫn đầu gấp <b>${ratioDiff} lần</b> so với nhóm thấp nhất ("${bottomGroup.name}").` : ''}
                        </p>
                        <p class="leading-relaxed">
                            <i class="fa-solid fa-brain text-[#203833] mr-1.5"></i>
                            <b>Nhận định AI:</b> ${strategicAdvice}
                        </p>
                        <p class="leading-relaxed text-[11px] text-slate-500 pt-1 border-t border-slate-200/50">
                            <i class="fa-solid fa-shield-check ${missingCount > 0 ? 'text-[#D991A4]' : 'text-[#75BFB2]'} mr-1.5"></i>
                            ${missingCount > 0 ? `Lưu ý chất lượng dữ liệu: Còn <b>${missingCount}</b> ô trống ở cột "${dimLabel}" (${((missingCount/totalRows)*100).toFixed(1)}% tệp).` : `Độ tin cậy dữ liệu: <b>100%</b> bản ghi phân loại hợp lệ, không có ô trống.`}
                        </p>
                    </div>
                `;
            }

            const deepBox = document.getElementById('aiSliceDeepInsightContainer');
            if (deepBox) deepBox.classList.add('hidden');
        }

        // Tương tác trực tiếp với Google Gemini AI để phân tích sâu lát cắt dữ liệu
        async function askAiToAnalyzeSlice() {
            if (!lastApiResponse || !lastApiResponse.dataset_meta?.total_rows) {
                showToast("Vui lòng tải tệp dữ liệu lên trước khi hỏi AI.", "warning");
                return;
            }
            const dimSelectEl = document.getElementById('grpDimSelect');
            const dimLabel = (dimSelectEl && dimSelectEl.options[dimSelectEl.selectedIndex]?.text) || 'Nhóm';
            const metricSelectEl = document.getElementById('grpMetricSelect');
            const metricLabel = (metricSelectEl && metricSelectEl.options[metricSelectEl.selectedIndex]?.text) || 'Chỉ số';
            const aggSelectEl = document.getElementById('grpAggSelect');
            const aggLabel = (aggSelectEl && aggSelectEl.options[aggSelectEl.selectedIndex]?.text) || 'Tổng';

            const btn = document.getElementById('btnAiAnalyzeSlice');
            const origHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-[#75BFB2]"></i> <span>Gemini AI đang nhận xét...</span>`;
            }

            const prompt = `Phân tích chuyên sâu lát cắt dữ liệu: Nhóm theo '${dimLabel}', Phép tổng hợp '${aggLabel}', Cột số '${metricLabel}'. Dựa trên kết quả thực tế, hãy đưa ra 3 nhận xét chiến lược sắc bén và 2 khuyến nghị cụ thể cho Ban giám đốc.`;

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query: prompt })
                });
                const data = await res.json();
                const reply = data.reply || data.error || 'AI đã phân tích xong lát cắt dữ liệu.';

                const deepBox = document.getElementById('aiSliceDeepInsightContainer');
                const deepText = document.getElementById('aiSliceDeepInsightText');
                if (deepBox && deepText) {
                    deepText.innerHTML = reply.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<b>$1</b>');
                    deepBox.classList.remove('hidden');
                    deepBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                showToast("✨ Gemini AI đã hoàn thành nhận định lát cắt!", "success");
            } catch (err) {
                console.error("AI Slice Error:", err);
                showToast("Không thể kết nối Gemini AI. Vui lòng thử lại sau.", "error");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }

        function renderColumnProfilingTable() {
            if (!lastApiResponse) return;
            const format = document.getElementById('numberFormatSelect')?.value || 'vi';
            const tbody = document.getElementById('columnProfilingTableBody');
            if (!tbody) return;

            const cols = lastApiResponse.column_profiling || [];
            if (!cols.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 text-center text-slate-400 italic">
                            <i class="fa-solid fa-table-columns text-2xl text-slate-300 block mb-2"></i>
                            Chưa có dữ liệu. Vui lòng tải tệp ở Bước 1 để AI nhận diện kiểu dữ liệu và thống kê chi tiết từng cột.
                        </td>
                    </tr>
                `;
                return;
            }

            const formatNum = (num) => {
                if (num === null || num === undefined || isNaN(num)) return '—';
                if (format === 'en') {
                    return Number(num).toLocaleString('en-US', { minimumFractionDigits: num % 1 !== 0 ? 2 : 0, maximumFractionDigits: 2 });
                } else {
                    return Number(num).toLocaleString('vi-VN', { minimumFractionDigits: num % 1 !== 0 ? 2 : 0, maximumFractionDigits: 2 });
                }
            };

            tbody.innerHTML = cols.map(c => `
                <tr class="hover:bg-slate-50 transition border-b border-slate-100 text-xs">
                    <td class="py-3 px-3.5 font-bold text-slate-900">${c.column_name}</td>
                    <td class="py-3 px-3.5 text-slate-600">${c.data_type}</td>
                    <td class="py-3 px-3.5 text-center font-mono ${c.missing_count > 0 ? 'text-[#872D43] font-bold' : 'text-slate-400'}">${c.missing_count}</td>
                    <td class="py-3 px-3.5 text-center font-mono font-bold text-slate-700">${c.unique_count}</td>
                    <td class="py-3 px-3.5 text-right font-mono ${c.mean !== null ? 'text-slate-800' : 'text-slate-300'}">${c.mean !== null ? formatNum(c.mean) : '—'}</td>
                    <td class="py-3 px-3.5 text-right font-mono ${c.min !== null ? 'text-slate-800' : 'text-slate-300'}">${c.min !== null ? formatNum(c.min) : '—'}</td>
                    <td class="py-3 px-3.5 text-right font-mono ${c.max !== null ? 'text-slate-900 font-bold' : 'text-slate-300'}">${c.max !== null ? formatNum(c.max) : '—'}</td>
                </tr>
            `).join('');
        }

        function submitAnalysisModificationRequest() {
            const input = document.getElementById('analysisStepModificationInput');
            const alertBox = document.getElementById('analysisModificationAlert');
            const alertText = document.getElementById('analysisModificationAlertText');
            const val = input ? input.value.trim() : '';

            if (!val) {
                if (alertBox) alertBox.classList.remove('hidden');
                if (alertText) alertText.innerText = 'Chưa thể tạo bản sửa. Vui lòng nhập nội dung đề xuất điều chỉnh trước khi gửi.';
                return;
            }

            if (alertBox) alertBox.classList.add('hidden');
            showToast(`✨ Đã ghi nhận yêu cầu: "${val}". AI Copilot đang áp dụng phân tích...`, "success");
            
            const noteEl = document.getElementById('hitlSignoffNote');
            if (noteEl) {
                noteEl.value = (noteEl.value ? noteEl.value + '\n' : '') + `[Yêu cầu sửa từ Bước 3]: ${val}`;
            }

            setTimeout(() => {
                const target = document.getElementById('groupBarsContainer');
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 300);
        }

        function clearAnalysisModificationRequest() {
            const input = document.getElementById('analysisStepModificationInput');
            if (input) input.value = '';
            const alertBox = document.getElementById('analysisModificationAlert');
            if (alertBox) alertBox.classList.add('hidden');
            showToast('Đã bỏ yêu cầu chỉnh sửa.', 'info');
        }

        function confirmAndProceedToStep4() {
            showToast('🚀 Đã xác nhận phân tích! Chuyển sang Bước 4: Duyệt & Xuất Báo Cáo...', 'success');
            goToStep(4);
        }

        // Modals
        function openFaqModal() { document.getElementById('modalFaq').classList.remove('hidden'); }
        function closeFaqModal() { document.getElementById('modalFaq').classList.add('hidden'); }
        function openContactModal() { document.getElementById('modalContact').classList.remove('hidden'); }
        function closeContactModal() { document.getElementById('modalContact').classList.add('hidden'); }
        function openSettingsModal() { document.getElementById('modalSettings').classList.remove('hidden'); }
        function closeSettingsModal() { document.getElementById('modalSettings').classList.add('hidden'); }
        function saveSettingsAndApply() {
            closeSettingsModal();
            showToast("⚙️ Đã lưu tham số đánh giá P&L mới!");
            if (uploadedFileBase64 || currentScenario) {
                fetchBackendPipeline();
            }
        }

        // ==========================================
        // SIDEBAR TOGGLE (ẨN/HIỆN & DI CHUYỂN RA VÀO)
        // ==========================================
        let isSidebarCollapsed = false;

        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const icon = document.getElementById('sidebarToggleIcon');
            const sidebarTexts = document.querySelectorAll('.sidebar-text');
            const sideBtns = document.querySelectorAll('.side-btn');
            
            if (!sidebar) return;
            isSidebarCollapsed = !isSidebarCollapsed;

            if (isSidebarCollapsed) {
                sidebar.classList.remove('w-64', 'px-4');
                sidebar.classList.add('w-20', 'px-2.5');
                sidebarTexts.forEach(el => el.classList.add('hidden'));
                sideBtns.forEach(btn => btn.classList.add('justify-center', '!px-2'));
                if (icon) {
                    icon.classList.remove('fa-chevron-left');
                    icon.classList.add('fa-chevron-right');
                }
                showToast("Thanh công cụ đã được thu gọn.", "info");
            } else {
                sidebar.classList.remove('w-20', 'px-2.5');
                sidebar.classList.add('w-64', 'px-4');
                sidebarTexts.forEach(el => el.classList.remove('hidden'));
                sideBtns.forEach(btn => btn.classList.remove('justify-center', '!px-2'));
                if (icon) {
                    icon.classList.remove('fa-chevron-right');
                    icon.classList.add('fa-chevron-left');
                }
                showToast("Thanh công cụ đã được mở rộng.", "info");
            }
        }

        // ==========================================
        // USER FEEDBACK & BUG REPORT MODAL
        // ==========================================
        function openFeedbackModal() {
            const modal = document.getElementById('feedbackModal');
            if (!modal) return;
            const badge = document.getElementById('feedbackCurrentStepBadge');
            if (badge) {
                badge.innerText = `Bước ${currentStepNumber || 1}`;
            }
            loadRecentFeedbacks();
            modal.classList.remove('hidden');
        }

        function closeFeedbackModal() {
            const modal = document.getElementById('feedbackModal');
            if (modal) modal.classList.add('hidden');
        }

        function submitUserFeedback(event) {
            event.preventDefault();
            const form = event.target;
            const type = form.querySelector('input[name="feedbackType"]:checked')?.value || 'bug';
            const author = document.getElementById('feedbackAuthor')?.value.trim() || 'Người dùng ẩn danh';
            const title = document.getElementById('feedbackTitle')?.value.trim() || '';
            const content = document.getElementById('feedbackContent')?.value.trim() || '';
            const step = currentStepNumber || 1;

            if (!title || !content) {
                showToast("⚠️ Vui lòng điền tiêu đề và nội dung phản hồi!", "warning");
                return;
            }

            const feedbackItem = {
                id: 'FB-' + Date.now().toString().slice(-6),
                type,
                author,
                title,
                content,
                step: `Bước ${step}`,
                createdAt: new Date().toLocaleString('vi-VN')
            };

            let feedbacks = [];
            try {
                feedbacks = JSON.parse(localStorage.getItem('thuha_user_feedbacks') || '[]');
            } catch (e) {
                feedbacks = [];
            }
            feedbacks.unshift(feedbackItem);
            localStorage.setItem('thuha_user_feedbacks', JSON.stringify(feedbacks.slice(0, 30)));

            form.reset();
            showToast("🎉 Cảm ơn bạn! Phản hồi & báo lỗi đã được gửi thành công đến Thu Hà Studio.", "success");
            loadRecentFeedbacks();
        }

        function loadRecentFeedbacks() {
            const container = document.getElementById('recentFeedbacksContainer');
            const list = document.getElementById('recentFeedbacksList');
            if (!container || !list) return;

            let feedbacks = [];
            try {
                feedbacks = JSON.parse(localStorage.getItem('thuha_user_feedbacks') || '[]');
            } catch (e) {
                feedbacks = [];
            }

            if (feedbacks.length === 0) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');
            const typeLabels = {
                'bug': '🐞 Lỗi hệ thống',
                'feature': '💡 Đề xuất tính năng',
                'chart': '📊 Biểu đồ & P&L',
                'other': '⭐ Góp ý khác'
            };

            list.innerHTML = feedbacks.slice(0, 5).map(fb => `
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-xs flex flex-col gap-1">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-[#203833]">${fb.title}</span>
                        <span class="text-[10px] text-slate-400">${fb.createdAt}</span>
                    </div>
                    <p class="text-[11px] text-slate-600 line-clamp-2">${fb.content}</p>
                    <div class="flex items-center gap-2 text-[10px] text-slate-400 mt-0.5">
                        <span class="px-2 py-0.5 rounded-md bg-[#B8D9D3]/50 text-[#203833] font-semibold">${typeLabels[fb.type] || fb.type}</span>
                        <span>${fb.step}</span>
                        <span>• Bởi: ${fb.author}</span>
                    </div>
                </div>
            `).join('');
        }

        // Khởi động trang với trạng thái sạch, KHÔNG nạp số liệu mẫu ban đầu
        window.addEventListener('DOMContentLoaded', () => {
            renderEmptyState();
            goToStep(1);
        });
    </script>

    <!-- =================================================================== -->
    <!-- MODAL 1: HỎI ĐÁP (FAQ) -->
    <!-- =================================================================== -->
    <div id="modalFaq" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-floating border border-slate-200 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-[#F2E5E4] text-[#203833] flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-circle-question text-[#203833]"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Hỏi Đáp Thường Gặp (FAQ)</h3>
                        <p class="text-xs text-slate-400">Giải đáp quy trình phân tích và công nghệ của Thu Hà</p>
                    </div>
                </div>
                <button onclick="closeFaqModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 transition cursor-pointer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="space-y-3 text-xs text-slate-600 max-h-[60vh] overflow-y-auto pr-1">
                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-circle-check text-[#75BFB2]"></i> 1. Hệ thống hỗ trợ những định dạng file nào?</h4>
                    <p class="text-slate-600 leading-relaxed">Hỗ trợ đầy đủ: Excel (.xlsx, .xls), CSV (.csv), và liên kết trực tiếp Google Sheets & Lark Base công khai.</p>
                </div>
                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-circle-check text-[#75BFB2]"></i> 2. Dữ liệu gốc có bị thay đổi hoặc mất mát không?</h4>
                    <p class="text-slate-600 leading-relaxed">100% dữ liệu gốc được bảo toàn. Hệ thống chỉ xử lý bản sao và ghi nhận nhật ký kiểm toán (Audit Trail) cho từng thao tác làm sạch.</p>
                </div>
                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-circle-check text-[#75BFB2]"></i> 3. Khi nào hệ thống bắt đầu tính toán?</h4>
                    <p class="text-slate-600 leading-relaxed">Ngay khi bạn tải tệp Excel hoặc CSV lên, hệ thống mới bắt đầu quét 5 nhóm lỗi làm sạch, khử trùng đa voucher và tính toán toàn bộ 13 chỉ số P&L.</p>
                </div>
                <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
                    <h4 class="font-bold text-slate-900 mb-1 flex items-center gap-2"><i class="fa-solid fa-circle-check text-[#75BFB2]"></i> 4. AI Copilot dùng mô hình gì?</h4>
                    <p class="text-slate-600 leading-relaxed">Tích hợp Google Gemini 3.5 Flash Lite với tốc độ phản hồi cực nhanh, kết hợp bộ suy luận tài chính nội bộ giúp trả lời chính xác số liệu P&L.</p>
                </div>
            </div>
            <div class="pt-2 text-right">
                <button onclick="closeFaqModal()" class="px-5 py-2.5 bg-[#203833] hover:bg-[#203833]Dark text-white font-bold text-xs rounded-xl shadow-xs cursor-pointer">
                    Đã hiểu
                </button>
            </div>
        </div>
    </div>



    <!-- =================================================================== -->
    <!-- MODAL 2: LIÊN HỆ (CONTACT) -->
    <!-- =================================================================== -->
    <div id="modalContact" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-floating border border-slate-200 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-address-card text-[#D991A4]"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Liên Hệ • Thu Hà</h3>
                        <p class="text-xs text-slate-400">Data Analyst & Business Intelligence Specialist</p>
                    </div>
                </div>
                <button onclick="closeContactModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 transition cursor-pointer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="space-y-3 text-xs">
                <div class="p-3.5 bg-slate-50 rounded-2xl flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-white shadow-xs flex items-center justify-center text-[#D991A4]">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-slate-400 font-semibold uppercase">Email Chuyên Môn</div>
                        <a href="mailto:thuha.analyst@gmail.com" class="text-xs font-bold text-slate-800 hover:text-[#203833]">thuha.analyst@gmail.com</a>
                    </div>
                </div>
                <div class="p-3.5 bg-slate-50 rounded-2xl flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-white shadow-xs flex items-center justify-center text-[#203833]">
                        <i class="fa-solid fa-laptop-code"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-slate-400 font-semibold uppercase">Dịch Vụ Cung Cấp</div>
                        <div class="text-xs font-bold text-slate-800">Tư vấn BI, Xây dựng Dashboard, Phân tích P&L & Tự động hoá AI Agent</div>
                    </div>
                </div>
            </div>
            <div class="pt-2 flex justify-end gap-2">
                <button onclick="closeContactModal()" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl cursor-pointer">
                    Đóng
                </button>
            </div>
        </div>
    </div>



    <!-- =================================================================== -->
    <!-- MODAL 3: CÀI ĐẶT THAM SỐ (SETTINGS) -->
    <!-- =================================================================== -->
    <div id="modalSettings" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-floating border border-slate-200 space-y-5">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-[#F2E5E4] text-[#203833] flex items-center justify-center font-bold text-sm">
                        <i class="fa-solid fa-sliders text-[#203833]"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-slate-900">Cài Đặt Tham Số Đánh Giá</h3>
                        <p class="text-xs text-slate-400">Cấu hình ngưỡng kinh doanh và quy tắc tính P&L</p>
                    </div>
                </div>
                <button onclick="closeSettingsModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 transition cursor-pointer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Kỳ vọng Biên đóng góp tối thiểu (CM %):</label>
                    <input type="number" id="settingTargetCM" value="15" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-forshop-sidebar">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Tỷ lệ hoàn hàng tối đa cho phép (%):</label>
                    <input type="number" id="settingMaxReturn" value="12" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-forshop-sidebar">
                </div>
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Quy tắc khử trùng đơn đa Voucher:</label>
                    <select id="settingMultiTouch" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-forshop-sidebar">
                        <option value="PROPORTIONAL" selected>PROPORTIONAL (Theo tỷ lệ chiết khấu)</option>
                        <option value="EQUAL_SPLIT">EQUAL_SPLIT (Chia đều)</option>
                        <option value="FIRST_TOUCH">FIRST_TOUCH (Voucher đầu tiên)</option>
                        <option value="LAST_TOUCH">LAST_TOUCH (Voucher cuối cùng)</option>
                    </select>
                </div>
            </div>
            <div class="pt-2 flex justify-end gap-2">
                <button onclick="closeSettingsModal()" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl cursor-pointer">
                    Hủy
                </button>
                <button onclick="saveSettingsAndApply()" class="btn-smooth px-5 py-2.5 bg-[#203833] hover:bg-[#203833]Dark text-white font-bold text-xs rounded-xl shadow-xs cursor-pointer">
                    Lưu & Áp Dụng
                </button>
            </div>
        </div>
    </div>



    <!-- =================================================================== -->
    <!-- MODAL 4: AI SMART ANGLES CONTROLLER (ĐIỀU HƯỚNG PHÂN TÍCH ĐA CHIỀU) -->
    <!-- =================================================================== -->
    <div id="modalAiSmartAnalysis" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-7 shadow-2xl border border-slate-200 space-y-5 max-h-[90vh] overflow-y-auto">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-3.5 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-[#203833] to-[#75BFB2] text-white flex items-center justify-center text-lg shadow-md shadow-indigo-200">
                        <i class="fa-solid fa-wand-magic-sparkles animate-pulse"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                            AI Smart Dimensions • Trung Tâm Kích Hoạt Phân Tích
                        </h3>
                        <p class="text-xs text-slate-500">Tự động nhận diện cấu trúc dữ liệu và điều hướng góc nhìn phân tích tối ưu</p>
                    </div>
                </div>
                <button type="button" onclick="closeAiSmartModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 hover:text-slate-800 transition cursor-pointer">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Status Banner -->
            <div class="p-3.5 rounded-2xl bg-gradient-to-r from-[#F2E5E4]/80 via-[#F2E5E4]/80 to-[#B8D9D3]/30 border border-[#B8D9D3]/60 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#75BFB2] animate-ping shrink-0"></span>
                    <span class="font-bold text-[#203833]" id="aiModalStatusText">
                        AI đã kích hoạt các góc nhìn phân tích chuyên sâu cho tập dữ liệu hiện tại
                    </span>
                </div>
                <span class="px-2.5 py-1 rounded-xl bg-white shadow-2xs text-[#203833] font-extrabold text-[11px] shrink-0 border border-[#B8D9D3] self-start sm:self-auto" id="aiModalActiveBadge">
                    Đang kích hoạt
                </span>
            </div>

            <!-- List of 4 Dimensions Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="aiModalCardsContainer">
                <!-- Dynamically populated via renderAiSmartModalContent() -->
            </div>

            <!-- Bottom Actions -->
            <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-[11px] text-slate-400 flex items-center gap-1.5 self-start sm:self-auto">
                    <i class="fa-solid fa-circle-info text-[#203833]"></i>
                    Nhấp góc nhìn bất kỳ để xem ngay báo cáo & biểu đồ tương ứng.
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <button type="button" onclick="closeAiSmartModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl cursor-pointer">
                        Đóng
                    </button>
                    <button type="button" onclick="runAiOverviewNow()" class="btn-smooth px-5 py-2.5 bg-gradient-to-r from-forshop-sidebar to-[#75BFB2] hover:from-[#203833] hover:to-[#203833] text-white font-black text-xs rounded-xl shadow-md cursor-pointer flex items-center gap-2">
                        <i class="fa-solid fa-table-cells-large"></i>
                        <span>Xem Lưới 4 Biểu Đồ Toàn Cảnh</span>
                    </button>
                </div>
            </div>
        </div>
    </div>



    <!-- =================================================================== -->
    <!-- MODAL PHẢN HỒI & BÁO LỖI NGƯỜI DÙNG (USER FEEDBACK MODAL) -->
    <!-- =================================================================== -->
    <div id="feedbackModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl border-2 border-[#75BFB2] space-y-5 animate-scaleIn max-h-[90vh] overflow-y-auto">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-[#203833] text-[#75BFB2] flex items-center justify-center font-bold text-lg shadow-md">
                        <i class="fa-solid fa-comment-dots text-[#75BFB2]"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-[#203833]">Góp Ý & Báo Lỗi Hệ Thống</h3>
                        <p class="text-[11px] text-slate-500">Phản hồi của bạn giúp hoàn thiện AI Studio của Thu Hà</p>
                    </div>
                </div>
                <button type="button" onclick="closeFeedbackModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center transition cursor-pointer">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- Feedback Form -->
            <form id="userFeedbackForm" onsubmit="submitUserFeedback(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[#203833] mb-1.5">Loại phản hồi <span class="text-[#D991A4]">*</span></label>
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 font-medium">
                            <input type="radio" name="feedbackType" value="bug" checked class="accent-[#75BFB2]">
                            <span>🐞 Báo lỗi hệ thống</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 font-medium">
                            <input type="radio" name="feedbackType" value="feature" class="accent-[#75BFB2]">
                            <span>💡 Đề xuất tính năng</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 font-medium">
                            <input type="radio" name="feedbackType" value="chart" class="accent-[#75BFB2]">
                            <span>📊 Biểu đồ & Chỉ số P&L</span>
                        </label>
                        <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 font-medium">
                            <input type="radio" name="feedbackType" value="other" class="accent-[#75BFB2]">
                            <span>⭐ Góp ý khác</span>
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#203833] mb-1">Tên hoặc Email người gửi (tùy chọn)</label>
                    <input type="text" id="feedbackAuthor" placeholder="Ví dụ: Nguyễn Văn A hoặc user@example.com" class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-[#75BFB2] focus:ring-2 focus:ring-[#75BFB2]/20">
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#203833] mb-1">Tiêu đề phản hồi <span class="text-[#D991A4]">*</span></label>
                    <input type="text" id="feedbackTitle" required placeholder="Tóm tắt ngắn gọn vấn đề hoặc đề xuất..." class="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-[#75BFB2] focus:ring-2 focus:ring-[#75BFB2]/20 font-semibold">
                </div>

                <div>
                    <label class="block text-xs font-bold text-[#203833] mb-1">Mô tả chi tiết <span class="text-[#D991A4]">*</span></label>
                    <textarea id="feedbackContent" required rows="4" placeholder="Mô tả cụ thể lỗi gặp phải (ở bước nào, thao tác gì), hoặc gợi ý cải tiến của bạn..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-[#75BFB2] focus:ring-2 focus:ring-[#75BFB2]/20 resize-none"></textarea>
                </div>

                <!-- Tự động đính kèm ngữ cảnh hiện tại -->
                <div class="p-3 bg-[#B8D9D3]/30 rounded-xl border border-[#75BFB2]/40 text-[11px] text-[#203833] flex items-center justify-between">
                    <span class="flex items-center gap-1.5 font-medium">
                        <i class="fa-solid fa-info-circle text-[#75BFB2]"></i>
                        <span>Tự động đính kèm bước hiện tại: <strong id="feedbackCurrentStepBadge">Bước 1</strong></span>
                    </span>
                    <span class="font-mono text-[10px] text-slate-500">Auto-Log</span>
                </div>

                <!-- Nút Gửi -->
                <div class="flex items-center justify-end gap-2.5 pt-2">
                    <button type="button" onclick="closeFeedbackModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer">
                        Hủy Bỏ
                    </button>
                    <button type="submit" class="btn-smooth px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#203833] to-[#2E544C] hover:from-[#172A26] hover:to-[#24443D] text-white text-xs font-bold flex items-center gap-2 shadow-md cursor-pointer border border-[#75BFB2]/40">
                        <i class="fa-solid fa-paper-plane text-[#75BFB2]"></i>
                        <span>Gửi Phản Hồi</span>
                    </button>
                </div>
            </form>

            <!-- Danh Sách Phản Hồi Gần Đây Đã Lưu -->
            <div id="recentFeedbacksContainer" class="pt-3 border-t border-slate-100 hidden">
                <h4 class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left"></i> Phản Hồi Của Bạn Đã Gửi:
                </h4>
                <div id="recentFeedbacksList" class="space-y-2 max-h-36 overflow-y-auto"></div>
            </div>
        </div>
    </div>

    <!-- Floating Gemini 3.5 Copilot Quick Button -->
    <button type="button" onclick="openGeminiCopilot()" title="Bấm để mở Cố Vấn Google Gemini 3.5 Flash Lite" class="btn-smooth fixed bottom-6 right-6 z-50 bg-gradient-to-r from-forshop-sidebar via-[#2A4C45] to-pink-600 hover:scale-105 active:scale-95 text-white px-4 py-3 rounded-full shadow-2xl flex items-center gap-2.5 font-extrabold text-xs cursor-pointer border-2 border-white/80 transition-all group">
        <span class="w-2.5 h-2.5 rounded-full bg-[#75BFB2] animate-pulse"></span>
        <i class="fa-solid fa-wand-magic-sparkles text-[#75BFB2] text-sm group-hover:rotate-12 transition-transform"></i>
        <span>Gemini 3.5 Copilot</span>
    </button>
</body>
</html>